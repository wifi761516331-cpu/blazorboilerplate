@page "/demo"

<BitCallout Class="page-callout">
    <BitText Element="h1" Class="page-title">@L["demo.title"]</BitText>
    <BitText Class="muted">@L["demo.subtitle"]</BitText>
</BitCallout>

<WidgetZone Name="demo_workbench_top" />

<div class="bb-toolbar">
    <BitButton Color="BitColor.Primary" IconName="Play" OnClick="RunShowcaseAsync" Disabled="@_busy">
        @(_busy ? L["demo.action.running"] : L["demo.action.runShowcase"])
    </BitButton>
    <BitButton Color="BitColor.Info" Variant="BitVariant.Outline" IconName="Download" OnClick="ExportCsvAsync">
        @L["demo.action.exportCsv"]
    </BitButton>
    <BitButton Variant="BitVariant.Outline" IconName="Refresh" OnClick="LoadOverviewAsync" Disabled="@_busy">
        @L["platform.common.refresh"]
    </BitButton>
</div>

<BitStack Gap="1rem" Style="width:100%;">
    @if (_overview is not null)
    {
        <BitCard Style="width:100%;padding:1.25rem;">
            <BitStack Gap="0.75rem">
                <BitText Typography="BitTypography.H6">@L["demo.overview.title"]</BitText>
                <div><strong>@L["demo.overview.cacheStatus"]</strong> @_overview.CacheStatus</div>
                <div><strong>@L["demo.overview.noteCount"]</strong> @L.GetString("demo.overview.noteCountUnit", _overview.DatabaseNoteCount)</div>
                <div><strong>@L["demo.overview.ruleMatched"]</strong> <BitBadge Color="@(_overview.AdminRuleMatched ? BitColor.Success : BitColor.Warning)">@_overview.AdminRuleMatched</BitBadge></div>
                <div><strong>@L["demo.overview.providers"]</strong> @string.Join("，", _overview.RegisteredProviders)</div>
                <div><strong>@L["demo.overview.ruleKeys"]</strong> @string.Join("，", _overview.RegisteredRuleKeys)</div>

                <div style="display:flex;gap:0.75rem;align-items:end;flex-wrap:wrap;padding-top:0.5rem;border-top:1px solid var(--bb-border, #e5e7eb);">
                    <BitTextField Label="@L["demo.settings.greetingPrefix"]" @bind-Value="_overview.Settings.GreetingPrefix" Style="min-width:260px;" />
                    <BitCheckbox Label="@L["demo.settings.enableAutoAudit"]" @bind-Value="_overview.Settings.EnableAutoAudit" />
                    <BitButton Color="BitColor.Primary" Variant="BitVariant.Outline" IconName="Save" OnClick="SaveSettingsAsync" Disabled="@_busy">
                        @L["demo.action.saveSettings"]
                    </BitButton>
                </div>
            </BitStack>
        </BitCard>
    }

    @if (_result is not null)
    {
        <BitCard Style="width:100%;padding:1.25rem;border-color:var(--bit-color-success, #10b981);">
            <BitStack Gap="0.5rem">
                <BitText Typography="BitTypography.H6">@L["demo.result.title"]</BitText>
                <div><strong>@L["demo.result.lock"]</strong> @(_result.LockAcquired ? L["demo.result.lockAcquired"] : L["demo.result.lockMissed"])</div>
                <div><strong>@L["demo.result.cache"]</strong> @_result.CacheValue</div>
                <div><strong>@L["demo.result.template"]</strong> @_result.TemplateSubject — @_result.TemplateBody</div>
                <div><strong>@L["demo.result.email"]</strong> EmailId = <code>@_result.QueuedEmailId</code></div>
                <div><strong>@L["demo.result.rule"]</strong> @_result.RuleMatched</div>
                <div><strong>@L["demo.result.search"]</strong> @L.GetString("demo.result.searchHits", _result.SearchHits)</div>
                <div><strong>@L["demo.result.csv"]</strong> @L.GetString("demo.result.csvBytes", _result.ExportCsvBytes)</div>
                <div><strong>@L["demo.result.provider"]</strong> @_result.ProviderPreview</div>
                <div><strong>@L["demo.result.dbWrite"]</strong> @L.GetString("demo.result.dbWriteSummary", _result.SavedNoteId, _result.TotalNotes)</div>
                <div><strong>@L["demo.result.event"]</strong> @L["demo.result.eventPublished"] <code>@_result.EventPublished</code></div>
                <div><strong>@L["demo.result.channelBus"]</strong> @L["demo.result.eventPublished"] <code>@_result.ChannelPublished</code></div>
            </BitStack>
        </BitCard>
    }

    <BitCard Style="width:100%;padding:1.25rem;">
        <BitStack Gap="0.75rem">
            <BitText Typography="BitTypography.H6">@L["demo.odata.title"]</BitText>
            <BitDataGrid @key="_gridVersion"
                         TItem="DemoNoteDto"
                         OnRead="ReadNotesAsync"
                         Strings="@_gridStrings"
                         Pageable="true" PageSize="5"
                         Sortable="true" Filterable="true" FilterDebounce="300"
                         Bordered="true" Hoverable="true" Striped="true" ShowHeader="true">
                <Columns>
                    <BitDataGridColumn TItem="DemoNoteDto" Property="n => n.Title" ColumnId="title" Title="@L["demo.odata.col.title"]" Sortable="true" />
                    <BitDataGridColumn TItem="DemoNoteDto" Property="n => n.CreatedAtUtc" ColumnId="createdatutc" Title="@L["demo.odata.col.createdAt"]" Sortable="true" Filterable="false">
                        <Template Context="n">@n.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="DemoNoteDto" Property="n => n.Id" ColumnId="id" Title="@L["demo.odata.col.id"]" Sortable="true" Filterable="false" />
                </Columns>
                <EmptyTemplate>
                    <BitText Class="muted">@L["demo.odata.empty"]</BitText>
                </EmptyTemplate>
            </BitDataGrid>
        </BitStack>
    </BitCard>

    <BitCard Style="width:100%;padding:1.25rem;">
        <div style="display:flex;flex-direction:column;gap:0.875rem;width:100%;">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:0.75rem;flex-wrap:wrap;">
                <div style="display:flex;align-items:center;gap:0.5rem;">
                    <BitText Typography="BitTypography.H6">@L["demo.hub.title"]</BitText>
                    <BitTag Color="@(_hubConnected ? BitColor.Success : BitColor.Secondary)"
                            Variant="@(_hubConnected ? BitVariant.Fill : BitVariant.Outline)"
                            Size="BitSize.Small">
                        @(_hubConnected ? L["demo.hub.connected"] : L["demo.hub.disconnected"])
                    </BitTag>
                </div>
                @if (_hubLogs.Count > 0)
                {
                    <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="ClearHubLogs">@L.GetString("demo.hub.clearLogs", _hubLogs.Count)</BitButton>
                }
            </div>

            <div style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;width:100%;">
                <BitButton Variant="BitVariant.Fill"
                           Color="@(_hubConnected ? BitColor.Error : BitColor.Primary)"
                           Disabled="@_hubBusy"
                           OnClick="ToggleHubConnectionAsync">
                    @(_hubConnected ? L["demo.hub.disconnect"] : L["demo.hub.connect"])
                </BitButton>
                <BitButton Variant="BitVariant.Outline"
                           Disabled="@(!_hubConnected || _hubBusy)"
                           OnClick="PingHubAsync">
                    @L["demo.hub.ping"]
                </BitButton>
                <BitTextField @bind-Value="_hubMessage"
                              Placeholder="@L["demo.hub.placeholder"]"
                              Style="flex:1;min-width:14rem;max-width:26rem;" />
                <BitButton Variant="BitVariant.Outline"
                           Disabled="@(!_hubConnected || _hubBusy)"
                           OnClick="BroadcastHubAsync">
                    @L["demo.hub.broadcast"]
                </BitButton>
            </div>

            <div style="width:100%;box-sizing:border-box;min-height:11rem;max-height:20rem;overflow:auto;padding:0.75rem;border:1px solid var(--bit-clr-brd-sec,#e1e1e1);border-radius:6px;background:var(--bit-clr-bg-sec,#f8f9fa);">
                @if (_hubLogs.Count == 0)
                {
                    <div style="height:9.5rem;display:flex;align-items:center;justify-content:center;">
                        <BitText Class="muted">@L["demo.hub.emptyHint"]</BitText>
                    </div>
                }
                else
                {
                    <div style="display:flex;flex-direction:column;gap:0.5rem;">
                        @foreach (var entry in _hubLogs)
                        {
                            <div style="display:flex;align-items:flex-start;gap:0.5rem;padding-bottom:0.45rem;border-bottom:1px dashed var(--bit-clr-brd-sec,#e5e5e5);font-size:0.85rem;line-height:1.45;">
                                <span style="color:var(--bit-clr-fg-ter,#6e6e6e);font-family:monospace;white-space:nowrap;">@entry.Time</span>
                                <BitTag Color="@entry.Color" Variant="BitVariant.Outline" Size="BitSize.Small" Style="flex-shrink:0;">@entry.Tag</BitTag>
                                <code style="white-space:pre-wrap;word-break:break-all;flex:1;">@entry.Text</code>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </BitCard>

    <WidgetZone Name="demo_workbench_bottom" />
</BitStack>
