@page "/localization"
@rendermode RenderMode.InteractiveServer

<div class="page-callout">
    <BitText Element="h1" Class="page-title">@L["localization.title"]</BitText>
    <BitText Class="muted">@L["localization.subtitle"]</BitText>
</div>

<WidgetZone Name="localization_resources_top" />

<div class="id-page">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <BitCallout Class="page-callout error">@_error</BitCallout>
    }
    @if (!string.IsNullOrWhiteSpace(_notice))
    {
        <BitCallout Class="page-callout">@_notice</BitCallout>
    }

    <BitPivot SelectedKey="@_activeTabKey" SelectedKeyChanged="OnTabChangedAsync">
        <BitPivotItem Key="languages" HeaderText="@L["localization.tab.languages"]" ItemCount="@(_languages.Count == 0 ? null : _languages.Count)">
            <div class="bb-toolbar" style="margin-top: 0.75rem;">
                <BitButton Variant="BitVariant.Outline"
                           IconName="@BitIconName.Refresh"
                           OnClick="LoadLanguagesAsync"
                           IsLoading="@_busy"
                           IsEnabled="!_busy">
                    @L["platform.common.refresh"]
                </BitButton>
                <PermissionGate Code="localization.language.write">
                    <BitButton IconName="@BitIconName.Add"
                               OnClick="OpenCreateLanguage"
                               IsEnabled="!_busy">
                        @L["localization.lang.add"]
                    </BitButton>
                </PermissionGate>
            </div>

            <BitDataGrid TItem="LanguageDto"
                         Items="_languages"
                         Strings="@_gridStrings"
                         Pageable="true" PageSize="_pageSize"
                         Sortable="true" Filterable="true" FilterDebounce="300"
                         Bordered="true" Hoverable="true" Striped="true"
                         ShowHeader="true">
                <Columns>
                    <BitDataGridColumn TItem="LanguageDto" Property="l => l.FlagCode" ColumnId="flag" Title="@L["localization.lang.flag"]" Sortable="false" Filterable="false">
                        <Template Context="lang">
                            @if (!string.IsNullOrWhiteSpace(lang.FlagCode))
                            {
                                <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.35rem" Style="white-space:nowrap;">
                                    <BitFlag Iso2="@lang.FlagCode" />
                                    <BitTag Color="BitColor.TertiaryBackground">@lang.FlagCode</BitTag>
                                </BitStack>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="LanguageDto" Property="l => l.Culture" ColumnId="culture" Title="@L["localization.lang.culture"]" Sortable="true">
                        <Template Context="lang">
                            <BitStack VerticalAlign="BitAlignment.Start" Gap="0.25rem">
                                <strong>@lang.Culture</strong>
                                @if (lang.IsFallbackProtected)
                                {
                                    <BitBadge Color="BitColor.SevereWarning">@L["localization.lang.protected"]</BitBadge>
                                }
                            </BitStack>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="LanguageDto" Property="l => l.Name" ColumnId="name" Title="@L["localization.lang.name"]" Sortable="true" />
                    <BitDataGridColumn TItem="LanguageDto" Property="l => l.DisplayName" ColumnId="displayName" Title="@L["localization.lang.displayName"]" Sortable="true" />
                    <BitDataGridColumn TItem="LanguageDto" Property="l => l.DisplayOrder" ColumnId="displayOrder" Title="@L["localization.lang.order"]" Sortable="true" Filterable="false" />
                    <BitDataGridColumn TItem="LanguageDto" Property="l => l.IsRtl" ColumnId="isRtl" Title="@L["localization.lang.rtl"]" Sortable="false" Filterable="false">
                        <Template Context="lang">
                            <BitTag Color="BitColor.TertiaryBackground">@(lang.IsRtl ? "RTL" : "LTR")</BitTag>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="LanguageDto" Property="l => l.IsDefault" ColumnId="isDefault" Title="@L["localization.lang.default"]" Sortable="false" Filterable="false">
                        <Template Context="lang">
                            @if (lang.IsDefault)
                            {
                                <BitBadge Color="BitColor.Info">@L["localization.lang.default"]</BitBadge>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="LanguageDto" Property="l => l.IsEnabled" ColumnId="isEnabled" Title="@L["localization.lang.enabled"]" Sortable="false" Filterable="false">
                        <Template Context="lang">
                            <BitBadge Color="@(lang.IsEnabled ? BitColor.Success : BitColor.TertiaryBackground)">
                                @(lang.IsEnabled ? L["localization.lang.enabled"] : "-")
                            </BitBadge>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="LanguageDto" Property="l => l.Culture" ColumnId="actions" Title="@L["localization.common.actions"]" Sortable="false" Filterable="false">
                        <Template Context="lang">
                            <PermissionGate Code="localization.language.write">
                                <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.35rem" Style="white-space:nowrap;">
                                    <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => OpenEditLanguage(lang)">
                                        @L["localization.common.edit"]
                                    </BitButton>
                                    @if (!lang.IsDefault)
                                    {
                                        <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => SetDefaultLanguageAsync(lang)">
                                            @L["localization.lang.setDefault"]
                                        </BitButton>
                                    }
                                    @if (!lang.IsFallbackProtected && !lang.IsDefault)
                                    {
                                        <BitButton Variant="BitVariant.Text" Color="BitColor.Error" Size="BitSize.Small" OnClick="() => AskDeleteLanguage(lang)">
                                            @L["localization.common.delete"]
                                        </BitButton>
                                    }
                                </BitStack>
                            </PermissionGate>
                        </Template>
                    </BitDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <BitText Class="muted">@L["platform.grid.empty"]</BitText>
                </EmptyTemplate>
            </BitDataGrid>
        </BitPivotItem>

        <BitPivotItem Key="resources" HeaderText="@L["localization.tab.resources"]">
            <div class="bb-toolbar" style="margin-top: 0.75rem; flex-wrap: nowrap; align-items: center; gap: 0.5rem; min-width: 0;">
                <BitDropdown TItem="BitDropdownItem<string>" TValue="string" Items="TargetLanguageItems"
                             @bind-Value="_targetCulture" @bind-Value:after="OnTargetCultureChangedAsync"
                             Title="@L["localization.res.targetCulture"]" Style="flex-shrink:0; width:11.5rem;" />

                <BitDropdown TItem="BitDropdownItem<string>" TValue="string" Items="ModuleItems"
                             @bind-Value="_selectedModule" @bind-Value:after="OnModuleChangedAsync"
                             Title="@L["localization.res.module"]" Style="flex-shrink:0; width:9rem;" />

                <div class="bb-search" style="flex: 1 1 7rem; min-width: 6rem; max-width: 16rem;">
                    <BitSearchBox Placeholder="@L["localization.res.search"]"
                                  Immediate
                                  DebounceTime="300"
                                  Value="@_keyword"
                                  ValueChanged="OnKeywordChangedAsync" />
                </div>

                <div style="flex-shrink:0; white-space:nowrap;">
                    <BitCheckbox Label="@L["localization.res.onlyMissing"]"
                                 Value="@_onlyMissing"
                                 ValueChanged="OnOnlyMissingChangedAsync" />
                </div>

                <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.4rem" Style="flex-wrap:nowrap; flex-shrink:0; margin-left:auto;">
                    <PermissionGate Code="localization.resource.write">
                        <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Sync" OnClick="SyncBuiltInAsync" IsEnabled="!_busy" Style="white-space:nowrap;">
                            @L["localization.res.sync"]
                        </BitButton>
                        <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Upload" OnClick="OpenImportDialog" IsEnabled="!_busy" Style="white-space:nowrap;">
                            @L["localization.res.import"]
                        </BitButton>
                        <BitButton IconName="@BitIconName.Save" OnClick="SaveAllDirtyAsync" IsEnabled="@(!_busy && _resources.Any(r => r.IsDirty))" Style="white-space:nowrap;">
                            @L["localization.res.saveAll"]
                        </BitButton>
                    </PermissionGate>
                    <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Download" OnClick="ExportJsonAsync" IsEnabled="!_busy" Style="white-space:nowrap;">
                        @L["localization.res.export"]
                    </BitButton>
                </BitStack>
            </div>

            <BitDataGrid @key="_gridVersion"
                         TItem="ResourceRowModel"
                         OnRead="ReadResourcesAsync"
                         Strings="@_gridStrings"
                         Pageable="true" PageSize="_pageSize"
                         Sortable="true" Filterable="true" FilterDebounce="300"
                         Bordered="true" Hoverable="true" Striped="true"
                         ShowHeader="true">
                <Columns>
                    <BitDataGridColumn TItem="ResourceRowModel" Property="r => r.ModuleId" ColumnId="moduleId" Title="@L["localization.res.col.module"]" Sortable="true">
                        <Template Context="row">
                            <BitTag Color="BitColor.TertiaryBackground">@GetModuleDisplayName(row.ModuleId)</BitTag>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ResourceRowModel" Property="r => r.Key" ColumnId="key" Title="@L["localization.res.col.key"]" Sortable="true">
                        <Template Context="row">
                            <span class="mono" style="word-break:break-all;">@row.Key</span>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ResourceRowModel" Property="r => r.FallbackValue" ColumnId="fallbackValue" Title="@L["localization.res.col.fallback"]" Sortable="false">
                        <Template Context="row">
                            <span class="muted" style="word-break:break-word;">@row.FallbackValue</span>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ResourceRowModel" Property="r => r.TargetValue" ColumnId="targetValue" Title="@L["localization.res.col.target"]" Sortable="false">
                        <Template Context="row">
                            <BitTextField Value="@row.TargetValue"
                                          OnInput="e => OnRowValueInput(row, e.Value?.ToString())"
                                          Class="@(row.IsDirty ? "loc-input dirty" : "loc-input")" />
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ResourceRowModel" Property="r => r.IsOverridden" ColumnId="status" Title="@L["localization.res.col.status"]" Sortable="false" Filterable="false">
                        <Template Context="row">
                            @if (row.IsOverridden)
                            {
                                <BitBadge Color="BitColor.Info">@L["localization.res.status.overridden"]</BitBadge>
                            }
                            else if (row.IsMissing)
                            {
                                <BitBadge Color="BitColor.Warning">@L["localization.res.status.missing"]</BitBadge>
                            }
                            else
                            {
                                <BitBadge Color="BitColor.Success">@L["localization.res.status.builtin"]</BitBadge>
                            }
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ResourceRowModel" Property="r => r.Key" ColumnId="actions" Title="@L["localization.res.col.actions"]" Sortable="false" Filterable="false">
                        <Template Context="row">
                            <PermissionGate Code="localization.resource.write">
                                <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.5rem">
                                    <BitButton Variant="BitVariant.Text" Size="BitSize.Small"
                                               Disabled="@(_busy || !row.IsDirty)" OnClick="() => SaveSingleRowAsync(row)">
                                        @L["localization.res.save"]
                                    </BitButton>
                                    @if (row.IsOverridden)
                                    {
                                        <BitButton Variant="BitVariant.Text" Color="BitColor.Error" Size="BitSize.Small"
                                                   Disabled="@_busy" OnClick="() => ResetRowAsync(row)">
                                            @L["localization.res.reset"]
                                        </BitButton>
                                    }
                                </BitStack>
                            </PermissionGate>
                        </Template>
                    </BitDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <BitText Class="muted">@L["platform.grid.empty"]</BitText>
                </EmptyTemplate>
            </BitDataGrid>
        </BitPivotItem>
    </BitPivot>
</div>

<BlazorBoilerplateModal @bind-IsOpen="_langDialogOpen"
                        Title="@(_editingLangId is null ? L["localization.lang.add"] : L["localization.lang.edit"])"
                        OkText="@L["localization.common.confirm"]"
                        CancelText="@L["localization.common.cancel"]"
                        Disabled="@_busy"
                        OnOk="SaveLanguageAsync"
                        CloseOnBackdrop="false">
    <BitStack Vertical Gap="0.9rem" Style="width:100%;">
        @if (!string.IsNullOrWhiteSpace(_modalError))
        {
            <BitCallout Class="page-callout error">@_modalError</BitCallout>
        }

        @if (_editingLangId is null)
        {
            <BitDropdown TItem="BitDropdownItem<string>"
                         TValue="string"
                         Label="@L["localization.lang.culture"]"
                         Placeholder="@L["localization.lang.culturePlaceholder"]"
                         Items="@_filteredCultureItems"
                         ShowSearchBox="true"
                         SearchBoxPlaceholder="输入语言或代码搜索（如 日语 / ja-JP）..."
                         OnSearch="OnCultureSearch"
                         OnSelectItem="OnCultureItemSelected"
                         @bind-Value="_langCulture"
                         Style="width:100%;" />
        }
        else
        {
            <BitTextField Label="@L["localization.lang.culture"]"
                          Value="@_langCulture"
                          ReadOnly="true"
                          Style="width:100%;" />
        }

        <BitTextField Label="@L["localization.lang.name"]" @bind-Value="_langName" Style="width:100%;" />
        <BitTextField Label="@L["localization.lang.displayName"]" @bind-Value="_langDisplayName" Style="width:100%;" />

        <BitDropdown TItem="BitDropdownItem<string>"
                     TValue="string"
                     Label="@L["localization.lang.flag"]"
                     Placeholder="@L["localization.lang.flagPlaceholder"]"
                     Items="@_filteredCountryFlagItems"
                     ShowSearchBox="true"
                     SearchBoxPlaceholder="输入国家或代码搜索（如 中国 / CN / JP）..."
                     OnSearch="OnFlagSearch"
                     @bind-Value="_langFlagCode"
                     Style="width:100%;">
            <TextTemplate Context="dropdown">
                @if (dropdown?.SelectedItem is { } sel && !string.IsNullOrWhiteSpace(sel.Value))
                {
                    <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.5rem">
                        <BitFlag Iso2="@sel.Value" />
                        <span>@sel.Text</span>
                    </BitStack>
                }
            </TextTemplate>
            <ItemTemplate Context="item">
                <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.5rem">
                    <BitFlag Iso2="@item.Value" />
                    <span>@item.Text</span>
                </BitStack>
            </ItemTemplate>
        </BitDropdown>

        <BitNumberField Label="@L["localization.lang.order"]" @bind-Value="_langOrder" Style="width:100%;" />

        <BitStack Horizontal Gap="1rem" Style="flex-wrap:wrap; width:100%;">
            <BitCheckbox Label="@L["localization.lang.rtl"]" @bind-Value="_langRtl" />
            <BitCheckbox Label="@L["localization.lang.default"]" @bind-Value="_langDefault" />
            <BitCheckbox Label="@L["localization.lang.enabled"]"
                         IsEnabled="@(!_editingProtected)"
                         @bind-Value="_langEnabled" />
        </BitStack>
    </BitStack>
</BlazorBoilerplateModal>

<BlazorBoilerplateModal IsOpen="@(_deletingLang is not null)"
                        IsOpenChanged="@(open => { if (!open) _deletingLang = null; })"
                        Title="@L["localization.common.delete"]"
                        Message="@(_deletingLang is null ? null : L.GetString("localization.lang.deleteConfirm", _deletingLang.Culture))"
                        OkText="@L["localization.common.confirm"]"
                        CancelText="@L["localization.common.cancel"]"
                        Danger="true"
                        Disabled="@_busy"
                        OnOk="ConfirmDeleteLanguageAsync" />

<BlazorBoilerplateModal @bind-IsOpen="_importDialogOpen"
                        Title="@L["localization.res.importTitle"]"
                        OkText="@L["localization.common.confirm"]"
                        CancelText="@L["localization.common.cancel"]"
                        Disabled="@_busy"
                        OnOk="ImportJsonAsync"
                        CloseOnBackdrop="false">
    <BitTextField Multiline Rows="10" @bind-Value="_importJson"
                  Placeholder="@L["localization.res.importPlaceholder"]" Style="width:100%;" />
</BlazorBoilerplateModal>

<WidgetZone Name="localization_resources_bottom" />
