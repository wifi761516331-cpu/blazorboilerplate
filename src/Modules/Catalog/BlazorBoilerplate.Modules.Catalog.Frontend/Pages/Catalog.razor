@page "/catalog"
@rendermode RenderMode.InteractiveServer

<BitCallout Class="page-callout">
    <BitText Element="h1" Class="page-title">@L["catalog.title"]</BitText>
    <BitText Class="muted">@L["catalog.subtitle"]</BitText>
</BitCallout>

<WidgetZone Name="catalog_products_top" />

@if (_loadError is not null)
{
    <BitCallout Class="page-callout error">@_loadError</BitCallout>
}

@* BitDataGrid 服务端模式：OnRead 把 skip/take/sorts/filters 映射到服务端 OData，翻页/排序/筛选都不走内存。
   表头下方是内置筛选行（每列一个输入框）；排序点表头，箭头由 BitDataGrid 内置渲染；
   ColumnId 设为 OData 白名单字段名。 *@
<BitDataGrid TItem="ProductDto"
             OnRead="ReadAsync"
             Strings="@_gridStrings"
             Pageable="true" PageSize="PageSize"
             Sortable="true" Filterable="true" FilterDebounce="300"
             Bordered="true" Hoverable="true" Striped="true"
             ShowHeader="true">
    <Columns>
        <BitDataGridColumn TItem="ProductDto" Property="p => p.Name" ColumnId="name" Title="@L["catalog.col.name"]" Sortable="true" />
        <BitDataGridColumn TItem="ProductDto" Property="p => p.Price" ColumnId="price" Title="@L["catalog.col.price"]" Format="C" Align="BitTextAlign.End" Sortable="true" FilterOperators="true" />
        <BitDataGridColumn TItem="ProductDto" Property="p => p.Category" ColumnId="category" Title="@L["catalog.col.category"]" Sortable="true">
            <Template Context="p">
                <BitBadge Color="BitColor.Info">@p.Category</BitBadge>
            </Template>
        </BitDataGridColumn>
        <BitDataGridColumn TItem="ProductDto" Property="p => p.Id" ColumnId="id" Title="@L["catalog.col.id"]" Sortable="true" Filterable="false" />
    </Columns>
    <EmptyTemplate>
        <BitText Class="muted">@L["catalog.empty"]</BitText>
    </EmptyTemplate>
</BitDataGrid>

<WidgetZone Name="catalog_products_bottom" />
