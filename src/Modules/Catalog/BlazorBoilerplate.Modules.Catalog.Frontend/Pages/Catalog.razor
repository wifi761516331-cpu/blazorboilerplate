@page "/catalog"
@rendermode RenderMode.InteractiveServer

<BitCallout Class="page-callout">
    <BitText Element="h1" Class="page-title">@L["catalog.title"]</BitText>
    <BitText Class="muted">@L["catalog.subtitle"]</BitText>
</BitCallout>

@if (_loadError is not null)
{
    <BitCallout Class="page-callout error">@_loadError</BitCallout>
}
else
{
    @* Bluebird ProductsPage 风格：筛选工具栏 + 带边框的表格容器 *@
    <div class="bb-toolbar bb-filters">
        <div class="filter-row">
            <BitTextField Label="@L["catalog.filter.name"]" Placeholder="@L["catalog.filter.namePlaceholder"]" @bind-Value="_search" OnInput="OnFilterChanged" />
            <BitTextField Label="@L["catalog.filter.minPrice"]" Placeholder="@L["catalog.filter.minPricePlaceholder"]" @bind-Value="_minPrice" OnInput="OnFilterChanged" />
            <BitTextField Label="@L["catalog.filter.category"]" Placeholder="@L["catalog.filter.categoryPlaceholder"]" @bind-Value="_category" OnInput="OnFilterChanged" />
            <div class="filter-sort">
                <BitText Class="muted">@L["catalog.filter.sort"]</BitText>
                <select class="bit-select" @bind="_sortField">
                    <option value="price">@L["catalog.filter.sortPrice"]</option>
                    <option value="name">@L["catalog.filter.sortName"]</option>
                    <option value="category">@L["catalog.filter.sortCategory"]</option>
                </select>
                <BitCheckbox Label="@L["catalog.filter.desc"]" @bind-Value="_sortDesc" OnChange="OnFilterChanged" />
            </div>
        </div>
    </div>

    <div class="grid-container">
        @if (_loading)
        {
            <BitText Class="muted">@L["catalog.loading"]</BitText>
        }
        else if (_items.Count == 0)
        {
            <BitText Class="muted">@L["catalog.empty"]</BitText>
        }
        else
        {
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>@L["catalog.col.name"]</th>
                        <th class="num">@L["catalog.col.price"]</th>
                        <th>@L["catalog.col.category"]</th>
                        <th>@L["catalog.col.id"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _items)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td class="num">@p.Price.ToString("C", System.Globalization.CultureInfo.CurrentCulture)</td>
                            <td><BitBadge Color="BitColor.Info">@p.Category</BitBadge></td>
                            <td class="mono">@p.Id</td>
                        </tr>
                    }
                </tbody>
            </table>

        }
    </div>

    @if (!_loading && _items.Count > 0)
    {
        <div class="pager">
            <BitText Class="muted">@L.GetString("catalog.pager.total", _total)</BitText>
            <BitButton Color="BitColor.Secondary" OnClick="PrevAsync" Disabled="@(_page <= 1 || _loading)">@L["catalog.pager.prev"]</BitButton>
            <BitText>@L.GetString("catalog.pager.page", _page)</BitText>
            <BitButton Color="BitColor.Secondary" OnClick="NextAsync" Disabled="@(_loading || (_total > 0 && _page * PageSize >= _total))">@L["catalog.pager.next"]</BitButton>
        </div>
    }
}

