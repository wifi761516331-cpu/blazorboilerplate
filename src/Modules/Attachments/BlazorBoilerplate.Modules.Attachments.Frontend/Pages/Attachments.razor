@page "/attachments"
@rendermode RenderMode.InteractiveServer
@using Microsoft.JSInterop

<style>
    .att-modal-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
    }

    .att-modal-form .auth-field,
    .att-modal-form .auth-input {
        width: 100%;
        box-sizing: border-box;
    }

    .att-dropzone {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        box-sizing: border-box;
        min-height: 120px;
        padding: 1.25rem 1rem;
        border: 1.5px dashed var(--bit-clr-brd-pri, #c8c6c4);
        border-radius: 8px;
        background: var(--bit-clr-bg-sec, rgba(127, 127, 127, 0.04));
        cursor: pointer;
        text-align: center;
        transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .att-pending-list {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        max-height: 180px;
        overflow-y: auto;
    }

    .att-pending-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.45rem 0.75rem;
        border: 1px solid var(--bit-clr-brd-sec, rgba(127, 127, 127, 0.18));
        border-radius: 6px;
        font-size: 0.85rem;
    }

    .att-pending-name {
        flex: 1;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .att-dropzone:hover {
        border-color: var(--bit-clr-pri, #0078d4);
        background: rgba(0, 120, 212, 0.06);
    }

    .att-dropzone.is-uploading {
        opacity: 0.72;
        cursor: wait;
    }

    .att-dropzone input[type="file"] {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .att-dropzone-content {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        pointer-events: none;
    }

    .att-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .att-bit-card {
        padding: 0 !important;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .att-bit-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.09);
    }

    .att-card-media {
        position: relative;
        width: 100%;
        height: 156px;
        background: var(--bit-clr-bg-sec, rgba(127, 127, 127, 0.06));
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-bottom: 1px solid var(--bit-clr-brd-sec, rgba(127, 127, 127, 0.14));
    }

    .att-card-media.is-clickable {
        cursor: zoom-in;
    }

    .att-card-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .att-file-badge {
        width: 64px;
        height: 64px;
        border-radius: 12px;
        background: rgba(0, 120, 212, 0.12);
        color: var(--bit-clr-pri, #0078d4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.9rem;
        letter-spacing: 0.04em;
    }

    .att-kind-tag {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
    }

    .att-card-body {
        padding: 0.85rem 1rem 0.6rem;
        flex: 1;
        min-width: 0;
    }

    .att-card-name {
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        font-weight: 600;
    }

    .att-card-actions {
        padding: 0.45rem 0.75rem 0.65rem;
        border-top: 1px solid var(--bit-clr-brd-sec, rgba(127, 127, 127, 0.14));
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.25rem;
        flex-wrap: wrap;
    }

    .att-preview-modal {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        align-items: center;
    }

    .att-preview-modal img {
        max-width: 100%;
        max-height: 65vh;
        border-radius: 8px;
        object-fit: contain;
    }

    .att-kpi-item {
        display: flex !important;
        flex-direction: row !important;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    .att-kpi-meta {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        min-width: 0;
    }

    .att-kpi-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        flex-shrink: 0;
        font-size: 1.15rem;
    }

    .att-kpi-icon.is-total {
        color: #0078d4;
        background: rgba(0, 120, 212, 0.1);
    }

    .att-kpi-icon.is-image {
        color: #107c10;
        background: rgba(16, 124, 16, 0.1);
    }

    .att-dropzone-content {
        max-width: 100%;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        line-height: 1.5;
    }

    .att-kpi-icon.is-other {
        color: #8a5100;
        background: rgba(180, 110, 0, 0.1);
    }

    .att-kpi-icon.is-size {
        color: #5c2d91;
        background: rgba(92, 45, 145, 0.1);
    }

    @@media (max-width: 720px) {
        .att-upload-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<BitCallout Class="page-callout">
    <BitText Element="h1" Class="page-title">@L["attachments.title"]</BitText>
    <BitText Class="muted">@L.GetString("attachments.subtitle", _storageLabel, _maxUploadSizeMb)</BitText>
</BitCallout>

<div class="bb-toolbar">
    <div class="bb-search">
        <BitSearchBox @bind-Value="_searchText" Immediate DebounceTime="200" Placeholder="@L["attachments.searchPlaceholder"]" />
    </div>
    <div class="bb-spacer"></div>
    <select class="auth-input" style="width:auto;" @bind="_filterKind" @bind:after="LoadAsync">
        <option value="">@L["attachments.filter.all"]</option>
        <option value="@AttachmentKind.General">@L["attachments.kind.general"]</option>
        <option value="@AttachmentKind.UserProfileImage">@L["attachments.kind.userAvatar"]</option>
        <option value="@AttachmentKind.ProductPrimaryImage">@L["attachments.kind.productImage"]</option>
    </select>
    <PermissionGate Code="attachments.upload">
        <BitButton Color="BitColor.Primary" IconName="CloudUpload" OnClick="OpenUploadModal">
            @L["attachments.upload"]
        </BitButton>
    </PermissionGate>
    <BitButton Variant="BitVariant.Outline" IconName="Refresh" OnClick="LoadAsync" IsEnabled="!_loading">
        @(_loading ? L["platform.common.loading"] : L["platform.common.refresh"])
    </BitButton>
</div>

<div class="module-summary">
    <div class="module-summary-item att-kpi-item">
        <div class="att-kpi-meta">
            <span class="module-summary-label">@L["attachments.kpi.total"]</span>
            <strong>@FilteredItems.Count</strong>
        </div>
        <span class="att-kpi-icon is-total" aria-hidden="true">
            <AppIcon Name="Attach" />
        </span>
    </div>
    <div class="module-summary-item att-kpi-item">
        <div class="att-kpi-meta">
            <span class="module-summary-label">@L["attachments.kpi.images"]</span>
            <strong class="ok">@FilteredItems.Count(IsImage)</strong>
        </div>
        <span class="att-kpi-icon is-image" aria-hidden="true">
            <BitIcon IconName="Photo2" />
        </span>
    </div>
    <div class="module-summary-item att-kpi-item">
        <div class="att-kpi-meta">
            <span class="module-summary-label">@L["attachments.kpi.others"]</span>
            <strong>@FilteredItems.Count(x => !IsImage(x))</strong>
        </div>
        <span class="att-kpi-icon is-other" aria-hidden="true">
            <BitIcon IconName="Page" />
        </span>
    </div>
    <div class="module-summary-item att-kpi-item">
        <div class="att-kpi-meta">
            <span class="module-summary-label">@L["attachments.kpi.totalSize"]</span>
            <strong>@FormatSize(FilteredItems.Sum(x => x.SizeBytes))</strong>
        </div>
        <span class="att-kpi-icon is-size" aria-hidden="true">
            <BitIcon IconName="Database" />
        </span>
    </div>
</div>

@if (_loadError is not null)
{
    <BitCallout Class="page-callout error" Style="margin-top: 1rem;">@_loadError</BitCallout>
}

@if (FilteredItems.Count == 0)
{
    <div class="module-empty" style="margin-top: 1rem;">
        <AppIcon Name="Attach" />
        <span>@(_items.Count == 0 ? L["attachments.empty.none"] : L["attachments.empty.filtered"])</span>
    </div>
}
else
{
    <div class="att-grid">
        @foreach (var item in FilteredItems)
        {
            var isImage = IsImage(item);
            var previewUrl = Api.GetAttachmentUrl(item.Id, item.Kind, download: false, cacheBust: item.CreatedAtUtc.ToUnixTimeMilliseconds().ToString());
            var downloadUrl = Api.GetAttachmentUrl(item.Id, item.Kind, download: true);

            <BitCard Outlined="true" Class="att-bit-card">
                <div class="att-card-media @(isImage ? "is-clickable" : "")"
                     @onclick="() => OpenPreviewIfImage(item, previewUrl)">
                    @if (isImage)
                    {
                        <img src="@previewUrl" alt="@item.FileName" loading="lazy" />
                    }
                    else
                    {
                        <div class="att-file-badge">
                            <span>@GetExtensionLabel(item.FileName)</span>
                        </div>
                    }
                    <div class="att-kind-tag">
                        <BitTag Size="BitSize.Small" Color="BitColor.Info">@GetKindLabel(item.Kind)</BitTag>
                    </div>
                </div>

                <div class="att-card-body">
                    <BitText Typography="BitTypography.Subtitle1" Class="att-card-name" Title="@item.FileName">@item.FileName</BitText>
                    <BitText Typography="BitTypography.Caption1" Class="muted">
                        @FormatSize(item.SizeBytes) · @item.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </BitText>
                </div>

                <div class="att-card-actions">
                    @if (isImage)
                    {
                        <BitButton Size="BitSize.Small" Variant="BitVariant.Text" OnClick="() => OpenPreview(item, previewUrl)">@L["attachments.action.preview"]</BitButton>
                    }
                    else
                    {
                        <a class="bb-link-btn" href="@previewUrl" target="_blank" rel="noopener noreferrer">@L["attachments.action.open"]</a>
                    }
                    <BitButton Size="BitSize.Small" Variant="BitVariant.Text" OnClick="() => CopyUrlAsync(previewUrl)">@L["attachments.action.copyUrl"]</BitButton>
                    <a class="bb-link-btn" href="@downloadUrl" download="@item.FileName">@L["attachments.action.download"]</a>
                    <PermissionGate Code="attachments.delete">
                        <BitButton Size="BitSize.Small" Variant="BitVariant.Text" Color="BitColor.Error" OnClick="() => ConfirmDelete(item)">@L["platform.common.delete"]</BitButton>
                    </PermissionGate>
                </div>
            </BitCard>
        }
    </div>
}

<BlazorBoilerplateModal @bind-IsOpen="_uploadOpen"
                        Title="@L["attachments.modal.uploadTitle"]"
                        OkText="@(_uploading ? L.GetString("attachments.modal.uploading", _uploadDone, _uploadTotal) : L["attachments.modal.startUpload"])"
                        CancelText="@L["platform.common.cancel"]"
                        ShowCancel="true"
                        Disabled="@(_pendingFiles.Count == 0 || _uploading)"
                        OnOk="StartUploadAsync">
    <div class="att-modal-form">
        <div class="auth-field">
            <label class="auth-label" for="att-kind">@L["attachments.modal.kindLabel"]</label>
            <select id="att-kind" class="auth-input" @bind="_uploadKind" disabled="@_uploading">
                <option value="@AttachmentKind.General">@L["attachments.kind.general"]</option>
                <option value="@AttachmentKind.UserProfileImage">@L["attachments.kind.userAvatarSelf"]</option>
                <option value="@AttachmentKind.ProductPrimaryImage">@L["attachments.kind.productImage"]</option>
            </select>
        </div>
        @if (_uploadKind == AttachmentKind.ProductPrimaryImage)
        {
            <div class="auth-field">
                <label class="auth-label" for="att-owner">@L["attachments.modal.ownerLabel"]</label>
                <input id="att-owner" class="auth-input" @bind="_ownerIdText" placeholder="@L["attachments.modal.ownerPlaceholder"]" disabled="@_uploading" />
            </div>
        }
        <label class="att-dropzone @(_uploading ? "is-uploading" : "")" for="att-file-input">
            <InputFile @key="_inputKey"
                       id="att-file-input"
                       OnChange="HandleFilesSelectedAsync"
                       accept="@AcceptExtensions"
                       multiple
                       disabled="@_uploading" />
            <div class="att-dropzone-content">
                <BitIcon IconName="CloudUpload" Size="BitSize.Large" Color="BitColor.Primary" />
                <BitText Typography="BitTypography.Subtitle1">@L["attachments.dropzone.title"]</BitText>
                <BitText Typography="BitTypography.Caption1" Class="muted">@L.GetString("attachments.dropzone.hint", AllowedExtensionsDisplay, _maxUploadSizeMb)</BitText>
            </div>
        </label>

        @if (_pendingFiles.Count > 0)
        {
            <div class="att-pending-list">
                @foreach (var file in _pendingFiles)
                {
                    <div class="att-pending-item">
                        <span class="att-pending-name" title="@file.Name">@file.Name</span>
                        <span class="muted">@FormatSize(file.Size)</span>
                        @if (file.TooLarge)
                        {
                            <BitTag Size="BitSize.Small" Color="BitColor.Error">@L["attachments.dropzone.tooLarge"]</BitTag>
                        }
                        <button type="button" class="bb-link-btn danger" @onclick="() => RemovePendingFile(file)" disabled="@_uploading">@L["attachments.dropzone.remove"]</button>
                    </div>
                }
            </div>
        }
    </div>
</BlazorBoilerplateModal>

<BlazorBoilerplateModal @bind-IsOpen="_previewOpen"
                        Title="@(_previewItem?.FileName ?? L["attachments.preview.title"])"
                        OkText="@L["platform.common.close"]"
                        ShowCancel="false"
                        OnOk="ClosePreviewAsync">
    @if (_previewItem is not null && _previewUrl is not null)
    {
        <div class="att-preview-modal">
            <img src="@_previewUrl" alt="@_previewItem.FileName" />
            <BitText Typography="BitTypography.Caption1" Class="muted">
                @GetKindLabel(_previewItem.Kind) · @FormatSize(_previewItem.SizeBytes) ·
                <a class="bb-link-btn" href="@Api.GetAttachmentUrl(_previewItem.Id, _previewItem.Kind, download: true)" download="@_previewItem.FileName">@L["attachments.preview.downloadOriginal"]</a>
            </BitText>
        </div>
    }
</BlazorBoilerplateModal>

<BlazorBoilerplateModal @bind-IsOpen="_deleteOpen"
                        Title="@L["attachments.delete.title"]"
                        Message="@L.GetString("attachments.delete.message", _deleteTarget?.FileName ?? string.Empty)"
                        OkText="@L["attachments.delete.confirm"]"
                        ShowCancel="true"
                        Danger="true"
                        OnOk="ExecuteDeleteAsync" />

