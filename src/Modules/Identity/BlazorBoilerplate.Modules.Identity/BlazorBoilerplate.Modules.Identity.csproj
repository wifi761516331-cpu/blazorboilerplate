<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorBoilerplate.Modules.Identity</RootNamespace>
    <AssemblyName>BlazorBoilerplate.Modules.Identity</AssemblyName>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bit.BlazorUI" />
    <PackageReference Include="Bit.BlazorUI.Extras" />
    <PackageReference Include="Bit.BlazorUI.Icons" />
    <!-- EF Core：DbContext + PostgreSQL 迁移 + SQLite 开发降级。
         Design 仅供 dotnet-ef 设计期使用，不随运行时发布。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\BlazorBoilerplate.ModuleAbstractions\BlazorBoilerplate.ModuleAbstractions.csproj" />
    <!-- 前端共享层：页面用的 BlazorBoilerplateApiClient / DTO / IdentityLayout 都在这里，
         模块只依赖共享契约，不反向引用 WebHost。 -->
    <ProjectReference Include="..\..\..\BuildingBlocks\BlazorBoilerplate.Web.Shared\BlazorBoilerplate.Web.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
