@page "/identity/roles"
@rendermode RenderMode.InteractiveServer
@using BlazorBoilerplate.Shared.Features.Identity

<div class="page-callout">
    <BitText Element="h1" Class="page-title">@L["identity.roles.title"]</BitText>
    <BitText Class="muted">@L["identity.roles.subtitle"]</BitText>
</div>

<div class="id-page">
    <div class="id-toolbar">
        <PermissionGate Code="identity.role.create">
            <BitTextField @bind-Value="NewRoleName" Style="width:14rem" Immediate DebounceTime="200" Placeholder="@L["identity.roles.newNamePlaceholder"]" />
            <BitButton IconName="@BitIconName.AddTo" OnClick="CreateRoleAsync" Disabled="@string.IsNullOrWhiteSpace(NewRoleName)">@L["identity.roles.create"]</BitButton>
        </PermissionGate>
        <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="RefreshAsync" Disabled="@_loading">@L["platform.common.refresh"]</BitButton>
    </div>

    @if (_error is not null)
    {
        <BitCallout Class="page-callout error">@_error</BitCallout>
    }

    <div class="id-columns">
        <BitCard Class="id-list-card">
            <BitSearchBox @bind-Value="_search" Immediate DebounceTime="300" Placeholder="@L["identity.roles.searchPlaceholder"]" />
            @if (_loading)
            {
                <BitText Class="muted">@L["platform.common.loading"]</BitText>
            }
            else if (_roleNavItems.Count == 0)
            {
                <BitText Class="muted">@L["identity.roles.empty"]</BitText>
            }
            else
            {
                <BitNav Items="_roleNavItems"
                        Mode="BitNavMode.Manual"
                        Reselectable
                        NoCollapse
                        OnSelectItem="@((BitNavItem item) => SelectRoleAsync(item))" />
            }
        </BitCard>

        <BitCard Class="id-detail-card">
            <BitPivot>
                <BitPivotItem HeaderText="@L["identity.common.tab.general"]">
                    @if (_selected is null)
                    {
                        <BitText Class="muted">@L["identity.roles.selectPrompt"]</BitText>
                    }
                    else
                    {
                        <div class="id-form">
                            <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.5rem">
                                <BitText Typography="BitTypography.H6">Id:</BitText>
                                <BitTag Color="BitColor.TertiaryBackground">@_selected.Id</BitTag>
                                @if (_selected.IsSystem)
                                {
                                    <BitBadge Color="BitColor.SevereWarning">@L["identity.roles.builtInProtected"]</BitBadge>
                                }
                            </BitStack>
                            <BitTextField @bind-Value="EditName" Label="@L["identity.roles.field.name"]" Disabled="@_selected.IsSystem" />
                            <BitTextField @bind-Value="EditDescription" Label="@L["identity.roles.field.description"]" Disabled="@_selected.IsSystem" />
                            <div class="row">
                                <PermissionGate Code="identity.role.update">
                                    <BitButton OnClick="SaveRoleAsync" Disabled="@(_selected.IsSystem)">@L["identity.common.saveChanges"]</BitButton>
                                </PermissionGate>
                                <BitSpacer />
                                <PermissionGate Code="identity.role.delete">
                                    <BitButton Color="BitColor.Error" OnClick="@(() => _deleteDialogOpen = true)" Disabled="@_selected.IsSystem">@L["identity.roles.delete"]</BitButton>
                                </PermissionGate>
                            </div>
                        </div>
                    }
                </BitPivotItem>
                <BitPivotItem HeaderText="@L["identity.roles.tab.menus"]" ItemCount="@(_selectedMenuCount == 0 ? null : _selectedMenuCount)">
                    @if (_selected is null)
                    {
                        <BitText Class="muted">@L["identity.roles.selectPrompt"]</BitText>
                    }
                    else
                    {
                        <div class="id-check-list">
                            @foreach (var row in GetMenuRows())
                            {
                                var menu = row.Menu;
                                <div style="@($"padding-inline-start: {row.Depth * 1.25}rem;")">
                                    <BitCheckbox Value="@_menuSelection.GetValueOrDefault(menu.Id)"
                                                 ValueChanged="@(v => OnMenuSelectionChanged(menu.Id, v))"
                                                 Label="@GetMenuLabel(menu)" />
                                </div>
                            }
                        </div>
                        <div class="row">
                            <PermissionGate Code="identity.role.update">
                                <BitButton OnClick="SaveMenusAsync" Disabled="@(!_menuDirty)">@L["identity.roles.action.saveMenus"]</BitButton>
                            </PermissionGate>
                            <BitButton Variant="BitVariant.Outline" OnClick="@(() => SetAllMenus(true))">@L["identity.common.selectAll"]</BitButton>
                            <BitButton Variant="BitVariant.Outline" OnClick="@(() => SetAllMenus(false))">@L["identity.common.clearAll"]</BitButton>
                            <BitText Class="muted id-tree-hint">@L.GetString("identity.roles.menusHint", _selectedMenuCount, _menus.Count)</BitText>
                        </div>
                    }
                </BitPivotItem>
                <BitPivotItem HeaderText="@L["identity.roles.tab.permissions"]" ItemCount="@(_selectedPermissionCount == 0 ? null : _selectedPermissionCount)">
                    @if (_selected is null)
                    {
                        <BitText Class="muted">@L["identity.roles.selectPrompt"]</BitText>
                    }
                    else
                    {
                        <div class="id-perm-groups">
                            @foreach (var group in GetPermissionGroups())
                            {
                                var groupSelected = group.Items.Count(p => _permissionSelection.GetValueOrDefault(p.Code));
                                <div class="id-perm-group">
                                    <div class="id-perm-group-header">
                                        <BitCheckbox Value="@(groupSelected == group.Items.Count && group.Items.Count > 0)"
                                                     ValueChanged="@(v => TogglePermissionGroup(group.Items, v))"
                                                     Label="@group.Title" />
                                        <BitText Class="muted id-perm-group-count">@groupSelected / @group.Items.Count</BitText>
                                    </div>
                                    <div class="id-perm-group-items">
                                        @foreach (var permission in group.Items)
                                        {
                                            <BitCheckbox Value="@_permissionSelection.GetValueOrDefault(permission.Code)"
                                                         ValueChanged="@(v => OnPermissionSelectionChanged(permission.Code, v))"
                                                         Label="@GetPermissionLabel(permission)" />
                                        }
                                    </div>
                                </div>
                            }
                            @if (_permissionCatalog.Count == 0)
                            {
                                <BitText Class="muted">@L["identity.roles.permissionsEmpty"]</BitText>
                            }
                        </div>
                        <div class="row">
                            <PermissionGate Codes="@(["identity.permission.write"])">
                                <BitButton OnClick="SavePermissionsAsync" Disabled="@(!_permissionDirty)">@L["identity.roles.action.savePermissions"]</BitButton>
                            </PermissionGate>
                            <BitButton Variant="BitVariant.Outline" OnClick="@(() => SetAllPermissions(true))">@L["identity.common.selectAll"]</BitButton>
                            <BitButton Variant="BitVariant.Outline" OnClick="@(() => SetAllPermissions(false))">@L["identity.common.clearAll"]</BitButton>
                            <BitText Class="muted id-tree-hint">@L.GetString("identity.roles.permissionsHint", _selectedPermissionCount, _permissionCatalog.Count)</BitText>
                        </div>
                    }
                </BitPivotItem>
            </BitPivot>
        </BitCard>
    </div>
</div>

<BlazorBoilerplateModal @bind-IsOpen="_deleteDialogOpen"
            Title="@L["identity.roles.modal.deleteTitle"]" Danger OkText="@L["platform.common.delete"]"
            Message="@L.GetString("identity.roles.modal.deleteConfirm", _selected?.Name ?? "")"
            OnOk="DeleteRoleAsync" />

@* 动态模块无法用 scoped CSS（bundle 不进宿主静态资源），此页样式内联在此，随页面走 *@
<style>
    .id-perm-groups {
        display: flex;
        flex-direction: column;
        gap: .25rem;
        margin-top: 1rem;
    }
    .id-perm-group {
        display: grid;
        grid-template-columns: 14rem minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
        padding: .75rem 0;
        border-bottom: 1px solid var(--bb-brd-ter);
    }
    .id-perm-group:last-child { border-bottom: 0; }
    .id-perm-group-header {
        display: flex; align-items: center; gap: .5rem;
        min-width: 0;
    }
    .id-perm-group-count {
        flex: none;
        margin-inline-start: auto;
        padding: .0625rem .4rem;
        border-radius: 999px;
        background: var(--bb-bg-sec);
        color: var(--bb-fg-sec);
        font-size: .7rem;
        font-variant-numeric: tabular-nums;
    }
    .id-perm-group-items {
        display: flex; flex-wrap: wrap; gap: .375rem 1.25rem;
    }
    @@media (max-width: 959px) {
        .id-perm-group { grid-template-columns: 1fr; gap: .5rem; }
    }
</style>

