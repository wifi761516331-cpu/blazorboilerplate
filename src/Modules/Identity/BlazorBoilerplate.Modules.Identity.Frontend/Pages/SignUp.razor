@page "/sign-up"
@layout IdentityLayout
@rendermode RenderMode.InteractiveServer
@attribute [AllowAnonymous]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using BlazorBoilerplate.Shared.Features.Identity
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject BlazorBoilerplateApiClient Api

@* 邮箱验证码注册界面：参考 Bluebird SignUpPage，沿用 SignIn 的 Fluent2 .auth-* 样式与 IdentityLayout。
   注册成功后通过 blazorAuth.register（POST /auth/register）直接写入认证 Cookie 并跳转 return-url 或首页。 *@

<div class="auth-head">
    <h1 class="auth-title">创建账号</h1>
    <p class="auth-sub">注册 @_systemName，开始使用平台服务</p>
</div>

@if (_message is not null)
{
    <div class="auth-msg @(_messageIsError ? "error" : "")">@_message</div>
}

@if (!_registerEnabled)
{
    <div class="auth-msg error">当前系统已关闭用户自助注册，请联系管理员创建账号。</div>
    <button type="button" class="auth-btn" @onclick="GoToSignIn">返回登录</button>
}
else
{
    <div class="auth-field">
        <label class="auth-label" for="signup-username">用户名</label>
        <div class="auth-input-wrap">
            <input id="signup-username"
                   class="auth-input @(_userNameInvalid ? "invalid" : "")"
                   type="text"
                   autocomplete="username"
                   placeholder="至少 2 个字符（如 zhangsan）"
                   @bind="_userName" @bind:event="oninput" />
        </div>
        @if (_userNameInvalid)
        {
            <span class="validation-message">用户名至少需要 2 个字符</span>
        }
    </div>

    <div class="auth-field">
        <label class="auth-label" for="signup-email">邮箱</label>
        <div class="auth-input-wrap">
            <input id="signup-email"
                   class="auth-input @(_emailInvalid ? "invalid" : "")"
                   type="email"
                   autocomplete="email"
                   placeholder="name@example.com"
                   @bind="_email" @bind:event="oninput" />
        </div>
        @if (_emailInvalid)
        {
            <span class="validation-message">请输入有效的邮箱地址</span>
        }
    </div>

    <div class="auth-field">
        <label class="auth-label" for="signup-code">邮箱验证码</label>
        <div class="auth-code-row">
            <div class="auth-input-wrap">
                <input id="signup-code"
                       class="auth-input @(_codeInvalid ? "invalid" : "")"
                       type="text"
                       inputmode="numeric"
                       maxlength="6"
                       autocomplete="one-time-code"
                       placeholder="6 位数字验证码"
                       @bind="_verificationCode" @bind:event="oninput" />
            </div>
            <button type="button"
                    class="auth-code-btn"
                    disabled="@(_sendingCode || _cooldownSeconds > 0)"
                    @onclick="SendCodeAsync">
                @(_sendingCode ? "发送中…" : _cooldownSeconds > 0 ? $"{_cooldownSeconds}s 后重发" : "发送验证码")
            </button>
        </div>
        @if (_codeInvalid)
        {
            <span class="validation-message">请输入 6 位邮箱验证码</span>
        }
    </div>

    <div class="auth-field">
        <label class="auth-label" for="signup-displayname">显示名称（可选）</label>
        <div class="auth-input-wrap">
            <input id="signup-displayname"
                   class="auth-input"
                   type="text"
                   autocomplete="name"
                   placeholder="留空则默认使用用户名"
                   @bind="_displayName" @bind:event="oninput" />
        </div>
    </div>

    <div class="auth-field">
        <label class="auth-label" for="signup-password">密码</label>
        <div class="auth-input-wrap">
            <input id="signup-password"
                   class="auth-input has-suffix @(_passwordInvalid ? "invalid" : "")"
                   type="@(_revealPassword ? "text" : "password")"
                   autocomplete="new-password"
                   placeholder="@($"至少 {_passwordMinLength} 位密码")"
                   @bind="_password" @bind:event="oninput" />
            <button type="button" class="auth-suffix" title="@(_revealPassword ? "隐藏密码" : "显示密码")" @onclick="ToggleRevealPassword">
                @if (_revealPassword)
                {
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 3l14 14" />
                        <path d="M8.2 5.3A9 9 0 0 1 10 5c5 0 8 5 8 5a13 13 0 0 1-2.2 2.6M5.1 6.3A13 13 0 0 0 2 10s3 5 8 5c1 0 1.9-.2 2.7-.5" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 10s3-5 8-5 8 5 8 5-3 5-8 5-8-5-8-5Z" />
                        <circle cx="10" cy="10" r="2.5" />
                    </svg>
                }
            </button>
        </div>
        @if (_passwordInvalid)
        {
            <span class="validation-message">@($"密码至少需要 {_passwordMinLength} 位")</span>
        }
    </div>

    <div class="auth-field">
        <label class="auth-label" for="signup-confirm">确认密码</label>
        <div class="auth-input-wrap">
            <input id="signup-confirm"
                   class="auth-input has-suffix @(_confirmInvalid ? "invalid" : "")"
                   type="@(_revealConfirm ? "text" : "password")"
                   autocomplete="new-password"
                   placeholder="再次输入密码"
                   @bind="_confirmPassword" @bind:event="oninput" />
            <button type="button" class="auth-suffix" title="@(_revealConfirm ? "隐藏密码" : "显示密码")" @onclick="ToggleRevealConfirm">
                @if (_revealConfirm)
                {
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 3l14 14" />
                        <path d="M8.2 5.3A9 9 0 0 1 10 5c5 0 8 5 8 5a13 13 0 0 1-2.2 2.6M5.1 6.3A13 13 0 0 0 2 10s3 5 8 5c1 0 1.9-.2 2.7-.5" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 10s3-5 8-5 8 5 8 5-3 5-8 5-8-5-8-5Z" />
                        <circle cx="10" cy="10" r="2.5" />
                    </svg>
                }
            </button>
        </div>
        @if (_confirmInvalid)
        {
            <span class="validation-message">两次输入的密码不一致</span>
        }
    </div>

    <button type="button" class="auth-btn" disabled="@_busy" @onclick="RegisterAsync">
        @(_busy ? "注册中…" : "立即注册")
    </button>

    <p class="auth-foot">
        已有账号？<button type="button" class="auth-link" @onclick="GoToSignIn">立即登录</button>
    </p>
}

@code {
    private string _userName = string.Empty;
    private string _email = string.Empty;
    private string _verificationCode = string.Empty;
    private string _displayName = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _revealPassword;
    private bool _revealConfirm;
    private bool _busy;
    private bool _sendingCode;
    private int _cooldownSeconds;
    private CancellationTokenSource? _cooldownCts;
    private bool _userNameInvalid;
    private bool _emailInvalid;
    private bool _codeInvalid;
    private bool _passwordInvalid;
    private bool _confirmInvalid;
    private string? _message;
    private bool _messageIsError;
    private string? _returnUrl;
    private string _systemName = "BlazorBoilerplate 平台";
    private bool _registerEnabled = true;
    private int _passwordMinLength = 6;

    protected override async Task OnInitializedAsync()
    {
        SetupStatus? status = null;
        try { status = await Api.GetSetupStatusAsync(); }
        catch { /* ApiHost 不可达时不阻断页面 */ }

        if (status is { Installed: false, DevBypass: false })
        {
            Navigation.NavigateTo("/setup");
            return;
        }

        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && pair[0] == "return-url")
                _returnUrl = Uri.UnescapeDataString(pair[1].Replace("+", " "));
        }
        _returnUrl = NormalizeReturnUrl(_returnUrl, Navigation.BaseUri);

        try
        {
            var pub = await Api.GetPublicSystemSettingsAsync();
            if (!string.IsNullOrWhiteSpace(pub.SystemName))
                _systemName = pub.SystemName;
            _registerEnabled = pub.RegisterEnabled;
            if (pub.PasswordMinLength >= 6)
                _passwordMinLength = pub.PasswordMinLength;
        }
        catch { /* 忽略：失败时保留默认值 */ }
    }

    private async Task SendCodeAsync()
    {
        var email = _email.Trim();
        _emailInvalid = string.IsNullOrWhiteSpace(email) || !email.Contains('@');
        if (_emailInvalid)
        {
            _message = "请先填写有效的邮箱地址。";
            _messageIsError = true;
            return;
        }

        _sendingCode = true;
        _message = null;
        try
        {
            await Api.SendEmailCodeAsync(new SendEmailCodeRequestDto(email, "register"));
            _message = "验证码已发送至您的邮箱，请注意查收（10 分钟内有效）。";
            _messageIsError = false;
            StartCooldown(60);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _sendingCode = false;
        }
    }

    private async Task RegisterAsync()
    {
        var userName = _userName.Trim();
        var email = _email.Trim();
        var code = _verificationCode.Trim();
        _userNameInvalid = string.IsNullOrWhiteSpace(userName) || userName.Length < 2;
        _emailInvalid = string.IsNullOrWhiteSpace(email) || !email.Contains('@');
        _codeInvalid = string.IsNullOrWhiteSpace(code) || code.Length < 6;
        _passwordInvalid = _password.Length < _passwordMinLength;
        _confirmInvalid = !string.Equals(_password, _confirmPassword, StringComparison.Ordinal);

        if (_userNameInvalid || _emailInvalid || _codeInvalid || _passwordInvalid || _confirmInvalid)
        {
            _message = "请检查并修正表单中的填写项。";
            _messageIsError = true;
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            var result = await JS.InvokeAsync<SignIn.LoginResult>("blazorAuth.register", new
            {
                userName,
                email,
                password = _password,
                displayName = string.IsNullOrWhiteSpace(_displayName) ? null : _displayName.Trim(),
                verificationCode = code
            });

            if (result is { Ok: true })
            {
                var target = NormalizeReturnUrl(_returnUrl, Navigation.BaseUri) ?? "/";
                await JS.InvokeVoidAsync("blazorAuth.redirect", target);
                return;
            }

            _message = string.IsNullOrWhiteSpace(result?.Error)
                ? "注册失败，请稍后重试。"
                : $"注册失败：{result!.Error}";
            _messageIsError = true;
        }
        catch (JSException)
        {
            _message = "注册服务尚未就绪，请稍后重试或检查浏览器脚本。";
            _messageIsError = true;
        }
        catch (Exception)
        {
            _message = "注册失败，请稍后重试。";
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartCooldown(int seconds)
    {
        _cooldownCts?.Cancel();
        _cooldownCts?.Dispose();
        _cooldownCts = new CancellationTokenSource();
        var ct = _cooldownCts.Token;
        _cooldownSeconds = seconds;
        _ = RunCooldownAsync(ct);
    }

    private async Task RunCooldownAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (_cooldownSeconds > 0 && await timer.WaitForNextTickAsync(ct))
            {
                _cooldownSeconds--;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // 组件释放或重新发送时取消计时器
        }
    }

    private void GoToSignIn()
    {
        var url = string.IsNullOrWhiteSpace(_returnUrl)
            ? "/sign-in"
            : $"/sign-in?return-url={Uri.EscapeDataString(_returnUrl)}";
        Navigation.NavigateTo(url);
    }

    private void ToggleRevealPassword() => _revealPassword = !_revealPassword;
    private void ToggleRevealConfirm() => _revealConfirm = !_revealConfirm;

    private static string? NormalizeReturnUrl(string? returnUrl, string baseUri)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)) return null;
        if (Uri.TryCreate(returnUrl, UriKind.Absolute, out var abs))
        {
            if (Uri.TryCreate(baseUri, UriKind.Absolute, out var baseAbs) &&
                string.Equals(abs.Authority, baseAbs.Authority, StringComparison.OrdinalIgnoreCase))
                return abs.PathAndQuery;
            return null;
        }
        return returnUrl.StartsWith('/') && !returnUrl.StartsWith("//") ? returnUrl : null;
    }

    public void Dispose()
    {
        _cooldownCts?.Cancel();
        _cooldownCts?.Dispose();
    }
}
