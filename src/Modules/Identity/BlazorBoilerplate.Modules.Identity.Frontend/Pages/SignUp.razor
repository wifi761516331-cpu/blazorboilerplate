@page "/sign-up"
@layout IdentityLayout
@rendermode RenderMode.InteractiveServer
@attribute [AllowAnonymous]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using BlazorBoilerplate.Shared.Features.Identity

@* 邮箱验证码注册界面：原生控件已改为 Bit.BlazorUI；密码显隐用 BitTextField 的 CanRevealPassword。
   注册成功后通过 blazorAuth.register（POST /auth/register）直接写入认证 Cookie 并跳转 return-url 或首页。 *@

<div class="auth-head">
    <BitText Element="h1" Class="auth-title">@L["identity.signup.title"]</BitText>
    <BitText Class="auth-sub">@L.GetString("identity.signup.subtitle", _systemName)</BitText>
</div>

@if (_message is not null)
{
    <BitCallout Class="@("auth-msg " + (_messageIsError ? "error" : ""))">@_message</BitCallout>
}

@if (!_registerEnabled)
{
    <BitCallout Class="auth-msg error">@L["identity.signup.disabled"]</BitCallout>
    <BitButton Color="BitColor.Primary" FullWidth OnClick="GoToSignIn">@L["identity.signup.backToSignIn"]</BitButton>
}
else
{
    <div class="auth-field">
        <BitTextField @bind-Value="_userName"
                      Label="@L["identity.signup.label.userName"]"
                      Placeholder="@L["identity.signup.placeholder.userName"]"
                      Invalid="@_userNameInvalid"
                      ErrorMessage="@L["identity.signup.validation.userName"]" />
    </div>

    <div class="auth-field">
        <BitTextField @bind-Value="_email"
                      Label="@L["identity.signin.label.email"]"
                      Type="BitInputType.Email"
                      Placeholder="name@example.com"
                      Invalid="@_emailInvalid"
                      ErrorMessage="@L["identity.signin.validation.email"]" />
    </div>

    <div class="auth-field">
        <div class="auth-code-row">
            <BitTextField @bind-Value="_verificationCode"
                          Label="@L["identity.signup.label.verificationCode"]"
                          MaxLength="6"
                          InputMode="BitInputMode.Numeric"
                          Placeholder="@L["identity.signup.placeholder.verificationCode"]"
                          Invalid="@_codeInvalid"
                          ErrorMessage="@L["identity.signup.validation.verificationCode"]" />
            <BitButton Variant="BitVariant.Outline"
                       Class="auth-code-btn"
                       Disabled="@(_sendingCode || _cooldownSeconds > 0)"
                       OnClick="SendCodeAsync">
                @(_sendingCode ? L["identity.signup.sendingCode"] : _cooldownSeconds > 0 ? L.GetString("identity.signup.resendCooldown", _cooldownSeconds) : L["identity.signup.sendCode"])
            </BitButton>
        </div>
    </div>

    <div class="auth-field">
        <BitTextField @bind-Value="_displayName"
                      Label="@L["identity.signup.label.displayName"]"
                      Placeholder="@L["identity.signup.placeholder.displayName"]" />
    </div>

    <div class="auth-field">
        <BitTextField @bind-Value="_password"
                      Label="@L["identity.signin.label.password"]"
                      Type="BitInputType.Password"
                      CanRevealPassword
                      Placeholder="@L.GetString("identity.signup.placeholder.password", _passwordMinLength)"
                      Invalid="@_passwordInvalid"
                      ErrorMessage="@L.GetString("identity.signup.validation.passwordMinLength", _passwordMinLength)" />
    </div>

    <div class="auth-field">
        <BitTextField @bind-Value="_confirmPassword"
                      Label="@L["identity.signup.label.confirmPassword"]"
                      Type="BitInputType.Password"
                      CanRevealPassword
                      Placeholder="@L["identity.signup.placeholder.confirmPassword"]"
                      Invalid="@_confirmInvalid"
                      ErrorMessage="@L["identity.signup.validation.passwordMismatch"]" />
    </div>

    <BitButton Color="BitColor.Primary" FullWidth IsLoading="@_busy" OnClick="RegisterAsync">
        @L["identity.signup.submit"]
    </BitButton>

    <p class="auth-foot">
        @L["identity.signup.hasAccount"]<BitButton Variant="BitVariant.Text" Class="auth-link" OnClick="GoToSignIn">@L["identity.signup.signInNow"]</BitButton>
    </p>
}
