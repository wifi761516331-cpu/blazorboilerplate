@page "/identity/users"

<div class="page-callout">
    <BitText Element="h1" Class="page-title">@L["identity.users.title"]</BitText>
    <BitText Class="muted">@L["identity.users.subtitle"]</BitText>
</div>

<WidgetZone Name="identity_users_top" />

<div class="id-page">
    <div class="id-toolbar">
        <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="RefreshAsync" Disabled="@_loading">@L["platform.common.refresh"]</BitButton>
        <PermissionGate Code="identity.user.create">
            <BitButton IconName="@BitIconName.Add" OnClick="@(() => ResetCreateForm())" Disabled="@_loading">@L["identity.users.create"]</BitButton>
        </PermissionGate>
    </div>

    <div class="id-columns">
        <BitCard Class="id-list-card">
            <BitSearchBox @bind-Value="_search" Immediate DebounceTime="300" Placeholder="@L["identity.users.searchPlaceholder"]" />
            @if (_loading)
            {
                <BitText Class="muted">@L["platform.common.loading"]</BitText>
            }
            else if (_userNavItems.Count == 0)
            {
                <BitText Class="muted">@L["identity.users.empty"]</BitText>
            }
            else
            {
                <BitNav Items="_userNavItems"
                        Mode="BitNavMode.Manual"
                        Reselectable
                        NoCollapse
                        OnSelectItem="@((BitNavItem item) => SelectUserAsync(item))" />
            }
        </BitCard>

        <BitCard Class="id-detail-card">
            <BitPivot>
                <BitPivotItem HeaderText="@L["identity.common.tab.general"]">
                    @if (_selected is null)
                    {
                        <BitText Class="muted">@L["identity.users.selectPrompt"]</BitText>
                    }
                    else
                    {
                        <div class="id-form">
                            <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.5rem">
                                <BitText Typography="BitTypography.H6">Id:</BitText>
                                <BitTag Color="BitColor.TertiaryBackground">@_selected.Id</BitTag>
                            </BitStack>
                            <BitTextField ReadOnly Value="@_selected.UserName" Label="@L["identity.users.field.userName"]" />
                            <BitTextField ReadOnly Value="@_selected.Email" Label="@L["identity.users.field.email"]" />
                            <BitTextField ReadOnly Value="@_selected.DisplayName" Label="@L["identity.users.field.displayName"]" />
                            <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.75rem">
                                <BitBadge Color="@(_selected.IsActive ? BitColor.Success : BitColor.Error)">
                                    @(_selected.IsActive ? L["identity.users.status.active"] : L["identity.users.status.disabled"])
                                </BitBadge>
                                <BitSpacer />
                                <PermissionGate Code="identity.user.update">
                                    <BitButton Variant="BitVariant.Outline" OnClick="@(() => OpenEditDialogAsync())">@L["identity.users.action.editProfile"]</BitButton>
                                    <BitButton Variant="BitVariant.Outline" OnClick="@(() => { ResetPw = string.Empty; _resetPwDialogOpen = true; })">@L["identity.users.action.resetPassword"]</BitButton>
                                    <BitButton Variant="BitVariant.Outline"
                                               OnClick="ToggleActiveAsync"
                                               Disabled="_busy.Contains(_selected.Id.ToString())">
                                        @(_selected.IsActive ? L["identity.users.action.disable"] : L["identity.users.action.enable"])
                                    </BitButton>
                                </PermissionGate>
                                <PermissionGate Code="identity.user.delete">
                                    <BitButton Color="BitColor.Error" OnClick="@(() => _deleteDialogOpen = true)">@L["platform.common.delete"]</BitButton>
                                </PermissionGate>
                            </BitStack>
                        </div>
                    }
                </BitPivotItem>
                <BitPivotItem HeaderText="@L["identity.users.tab.roles"]" ItemCount="@(_selectedRoleIds.Count == 0 ? null : _selectedRoleIds.Count)">
                    @if (_selected is null)
                    {
                        <BitText Class="muted">@L["identity.users.selectPrompt"]</BitText>
                    }
                    else
                    {
                        <div class="id-check-list">
                            @foreach (var role in _roles)
                            {
                                <BitCheckbox Value="@_roleSelection.GetValueOrDefault(role.Id)"
                                             ValueChanged="@(v => OnRoleSelectionChanged(role.Id, v))"
                                             Label="@GetRoleLabel(role)" />
                            }
                        </div>
                        <div class="row">
                            <PermissionGate Code="identity.user.update">
                                <BitButton OnClick="SaveRolesAsync" Disabled="@(!_roleDirty || _busy.Contains(_selected.Id.ToString()))">@L["identity.users.action.saveRoles"]</BitButton>
                            </PermissionGate>
                            <BitText Class="muted id-tree-hint">@L["identity.users.rolesHint"]</BitText>
                        </div>
                    }
                </BitPivotItem>
            </BitPivot>
        </BitCard>
    </div>
</div>

<BlazorBoilerplateModal @bind-IsOpen="_createDialogOpen"
            Title="@L["identity.users.modal.createTitle"]" OkText="@L["platform.common.create"]" OnOk="CreateUserAsync">
    <div class="id-form">
        <BitTextField @bind-Value="NewUserName" Label="@L["identity.users.field.userNameRequired"]" />
        <BitTextField @bind-Value="NewEmail" Label="@L["identity.users.field.emailRequired"]" />
        <BitTextField @bind-Value="NewDisplayName" Label="@L["identity.users.field.displayName"]" />
        <BitTextField @bind-Value="NewPassword" Label="@L["identity.users.field.initialPasswordRequired"]" />
    </div>
</BlazorBoilerplateModal>

<BlazorBoilerplateModal @bind-IsOpen="_editDialogOpen"
            Title="@L["identity.users.modal.editTitle"]" OkText="@L["platform.common.save"]" OnOk="SaveProfileAsync">
    <div class="id-form">
        <BitTextField @bind-Value="EditEmail" Label="@L["identity.users.field.emailRequired"]" />
        <BitTextField @bind-Value="EditDisplayName" Label="@L["identity.users.field.displayName"]" />
    </div>
</BlazorBoilerplateModal>

<BlazorBoilerplateModal @bind-IsOpen="_resetPwDialogOpen"
            Title="@L["identity.users.modal.resetPasswordTitle"]" OkText="@L["identity.users.action.reset"]" OnOk="ResetPasswordAsync">
    <div class="id-form">
        <BitTextField @bind-Value="ResetPw" Label="@L.GetString("identity.users.field.newPasswordMinLength", _passwordMinLength)" />
    </div>
</BlazorBoilerplateModal>

<BlazorBoilerplateModal @bind-IsOpen="_deleteDialogOpen"
            Title="@L["identity.users.modal.deleteTitle"]" Danger OkText="@L["platform.common.delete"]"
            Message="@L.GetString("identity.users.modal.deleteConfirm", _selected?.DisplayName ?? "")"
            OnOk="DeleteUserAsync" />

<WidgetZone Name="identity_users_bottom" />

