@page "/identity/users"
@rendermode RenderMode.InteractiveServer
@inject BlazorBoilerplateApiClient Api
@inject ILogger<Users> Logger
@inject ToastService Toast
@inject ILocalizationService L
@inject FrontendLocalizationService FrontendLoc

<div class="page-callout">
    <BitText Element="h1" Class="page-title">@L["identity.users.title"]</BitText>
    <BitText Class="muted">@L["identity.users.subtitle"]</BitText>
</div>

<div class="id-page">
    <div class="id-toolbar">
        <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="RefreshAsync" Disabled="@_loading">@L["platform.common.refresh"]</BitButton>
        <PermissionGate Code="identity.user.create">
            <BitButton IconName="@BitIconName.Add" OnClick="@(() => ResetCreateForm())" Disabled="@_loading">@L["identity.users.create"]</BitButton>
        </PermissionGate>
    </div>

    @if (_error is not null)
    {
        <BitCallout Class="page-callout error">@_error</BitCallout>
    }

    <div class="id-columns">
        <BitCard Class="id-list-card">
            <BitSearchBox @bind-Value="_search" Immediate DebounceTime="300" Placeholder="@L["identity.users.searchPlaceholder"]" />
            @if (_loading)
            {
                <BitText Class="muted">@L["platform.common.loading"]</BitText>
            }
            else if (_userNavItems.Count == 0)
            {
                <BitText Class="muted">@L["identity.users.empty"]</BitText>
            }
            else
            {
                <BitNav Items="_userNavItems"
                        Mode="BitNavMode.Manual"
                        Reselectable
                        NoCollapse
                        OnSelectItem="@((BitNavItem item) => SelectUserAsync(item))" />
            }
        </BitCard>

        <BitCard Class="id-detail-card">
            <BitPivot>
                <BitPivotItem HeaderText="@L["identity.common.tab.general"]">
                    @if (_selected is null)
                    {
                        <BitText Class="muted">@L["identity.users.selectPrompt"]</BitText>
                    }
                    else
                    {
                        <div class="id-form">
                            <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.5rem">
                                <BitText Typography="BitTypography.H6">Id:</BitText>
                                <BitTag Color="BitColor.TertiaryBackground">@_selected.Id</BitTag>
                            </BitStack>
                            <BitTextField ReadOnly Value="@_selected.UserName" Label="@L["identity.users.field.userName"]" />
                            <BitTextField ReadOnly Value="@_selected.Email" Label="@L["identity.users.field.email"]" />
                            <BitTextField ReadOnly Value="@_selected.DisplayName" Label="@L["identity.users.field.displayName"]" />
                            <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.75rem">
                                <BitBadge Color="@(_selected.IsActive ? BitColor.Success : BitColor.Error)">
                                    @(_selected.IsActive ? L["identity.users.status.active"] : L["identity.users.status.disabled"])
                                </BitBadge>
                                <BitSpacer />
                                <PermissionGate Code="identity.user.update">
                                    <BitButton Variant="BitVariant.Outline" OnClick="@(() => OpenEditDialogAsync())">@L["identity.users.action.editProfile"]</BitButton>
                                    <BitButton Variant="BitVariant.Outline" OnClick="@(() => { ResetPw = string.Empty; _resetPwDialogOpen = true; })">@L["identity.users.action.resetPassword"]</BitButton>
                                    <BitButton Variant="BitVariant.Outline"
                                               OnClick="ToggleActiveAsync"
                                               Disabled="_busy.Contains(_selected.Id.ToString())">
                                        @(_selected.IsActive ? L["identity.users.action.disable"] : L["identity.users.action.enable"])
                                    </BitButton>
                                </PermissionGate>
                                <PermissionGate Code="identity.user.delete">
                                    <BitButton Color="BitColor.Error" OnClick="@(() => _deleteDialogOpen = true)">@L["platform.common.delete"]</BitButton>
                                </PermissionGate>
                            </BitStack>
                        </div>
                    }
                </BitPivotItem>
                <BitPivotItem HeaderText="@L["identity.users.tab.roles"]" ItemCount="@(_selectedRoleIds.Count == 0 ? null : _selectedRoleIds.Count)">
                    @if (_selected is null)
                    {
                        <BitText Class="muted">@L["identity.users.selectPrompt"]</BitText>
                    }
                    else
                    {
                        <div class="id-check-list">
                            @foreach (var role in _roles)
                            {
                                <BitCheckbox Value="@_roleSelection.GetValueOrDefault(role.Id)"
                                             ValueChanged="@(v => OnRoleSelectionChanged(role.Id, v))"
                                             Label="@GetRoleLabel(role)" />
                            }
                        </div>
                        <div class="row">
                            <PermissionGate Code="identity.user.update">
                                <BitButton OnClick="SaveRolesAsync" Disabled="@(!_roleDirty || _busy.Contains(_selected.Id.ToString()))">@L["identity.users.action.saveRoles"]</BitButton>
                            </PermissionGate>
                            <BitText Class="muted id-tree-hint">@L["identity.users.rolesHint"]</BitText>
                        </div>
                    }
                </BitPivotItem>
            </BitPivot>
        </BitCard>
    </div>
</div>

<BlazorBoilerplateModal @bind-IsOpen="_createDialogOpen"
            Title="@L["identity.users.modal.createTitle"]" OkText="@L["platform.common.create"]" OnOk="CreateUserAsync">
    <div class="id-form">
        <BitTextField @bind-Value="NewUserName" Label="@L["identity.users.field.userNameRequired"]" />
        <BitTextField @bind-Value="NewEmail" Label="@L["identity.users.field.emailRequired"]" />
        <BitTextField @bind-Value="NewDisplayName" Label="@L["identity.users.field.displayName"]" />
        <BitTextField @bind-Value="NewPassword" Label="@L["identity.users.field.initialPasswordRequired"]" />
    </div>
</BlazorBoilerplateModal>

<BlazorBoilerplateModal @bind-IsOpen="_editDialogOpen"
            Title="@L["identity.users.modal.editTitle"]" OkText="@L["platform.common.save"]" OnOk="SaveProfileAsync">
    <div class="id-form">
        <BitTextField @bind-Value="EditEmail" Label="@L["identity.users.field.emailRequired"]" />
        <BitTextField @bind-Value="EditDisplayName" Label="@L["identity.users.field.displayName"]" />
    </div>
</BlazorBoilerplateModal>

<BlazorBoilerplateModal @bind-IsOpen="_resetPwDialogOpen"
            Title="@L["identity.users.modal.resetPasswordTitle"]" OkText="@L["identity.users.action.reset"]" OnOk="ResetPasswordAsync">
    <div class="id-form">
        <BitTextField @bind-Value="ResetPw" Label="@L.GetString("identity.users.field.newPasswordMinLength", _passwordMinLength)" />
    </div>
</BlazorBoilerplateModal>

<BlazorBoilerplateModal @bind-IsOpen="_deleteDialogOpen"
            Title="@L["identity.users.modal.deleteTitle"]" Danger OkText="@L["platform.common.delete"]"
            Message="@L.GetString("identity.users.modal.deleteConfirm", _selected?.DisplayName ?? "")"
            OnOk="DeleteUserAsync" />

@code {
    private List<IdentityUserDto> _users = [];
    private List<IdentityRoleDto> _roles = [];
    private List<BitNavItem> _userNavItems = [];
    private IdentityUserDto? _selected;
    private HashSet<Guid> _selectedRoleIds = [];
    private Dictionary<Guid, bool> _roleSelection = [];
    private bool _roleDirty;
    private bool _loading = true;
    private string? _error;
    private string _search = string.Empty;
    private readonly HashSet<string> _busy = [];

    private bool _createDialogOpen;
    private bool _editDialogOpen;
    private bool _resetPwDialogOpen;
    private bool _deleteDialogOpen;

    private string NewUserName = string.Empty;
    private string NewEmail = string.Empty;
    private string? NewDisplayName;
    private string NewPassword = string.Empty;
    private string EditEmail = string.Empty;
    private string? EditDisplayName;
    private string ResetPw = string.Empty;
    private int _passwordMinLength = 6;

    protected override async Task OnInitializedAsync()
    {
        await FrontendLoc.EnsureLoadedAsync();
        try
        {
            var pub = await Api.GetPublicSystemSettingsAsync();
            if (pub.PasswordMinLength > 0)
                _passwordMinLength = pub.PasswordMinLength;
        }
        catch { /* 失败时保留默认值 */ }
        await RefreshAsync();
    }

    private void ResetCreateForm()
    {
        NewUserName = NewEmail = NewPassword = string.Empty;
        NewDisplayName = null;
        _error = null;
        _createDialogOpen = true;
    }

    private async Task RefreshAsync()
    {
        _error = null;
        _loading = true;
        try
        {
            _users = [.. await Api.GetListAsync<IdentityUserDto>("api/identity/users")];
            _roles = [.. await Api.GetListAsync<IdentityRoleDto>("api/identity/roles")];
            if (_selected is not null)
                _selected = _users.FirstOrDefault(u => u.Id == _selected.Id);
            RebuildNav();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Logger.LogWarning(ex, "加载用户列表失败");
        }
        finally
        {
            _loading = false;
        }
    }

    private void RebuildNav()
    {
        var query = _search.Trim();
        var filtered = string.IsNullOrWhiteSpace(query)
            ? _users
            : [.. _users.Where(u => $"{u.UserName}|{u.Email}|{u.DisplayName}".Contains(query, StringComparison.OrdinalIgnoreCase))];
        _userNavItems = [.. filtered.Select(u => new BitNavItem
        {
            Key = u.Id.ToString(),
            Text = u.DisplayName,
            Description = $"{u.UserName} · {u.Email}" + (u.IsActive ? "" : $" · {L["identity.users.status.disabled"]}"),
            Data = u
        })];
    }

    private async Task SelectUserAsync(BitNavItem item)
    {
        if (item?.Data is not IdentityUserDto user)
            return;
        _selected = user;
        _roleDirty = false;
        _error = null;
        try
        {
            _selectedRoleIds = [.. await Api.GetListAsync<Guid>($"api/identity/users/{user.Id}/roles")];
            _roleSelection = _roles.ToDictionary(r => r.Id, r => _selectedRoleIds.Contains(r.Id));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string GetRoleLabel(IdentityRoleDto role) => role.IsSystem ? L.GetString("identity.roles.builtInSuffix", role.Name) : role.Name;

    private void OnRoleSelectionChanged(Guid roleId, bool selected)
    {
        _roleSelection[roleId] = selected;
        _roleDirty = true;
    }

    private async Task CreateUserAsync()
    {
        _error = null;
        try
        {
            var body = new { UserName = NewUserName, Email = NewEmail, DisplayName = NewDisplayName, Password = NewPassword };
            var response = await Api.PostAsync("api/identity/users", body);
            EnsureOk(response);
            _createDialogOpen = false;
            Toast.Success(L.GetString("identity.users.toast.created", NewUserName));
            NewUserName = NewEmail = NewPassword = string.Empty;
            NewDisplayName = null;
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; Toast.Error(L.GetString("identity.users.toast.createFailed", ex.Message)); }
    }

    private Task OpenEditDialogAsync()
    {
        if (_selected is null) return Task.CompletedTask;
        EditEmail = _selected.Email;
        EditDisplayName = _selected.DisplayName;
        _editDialogOpen = true;
        return Task.CompletedTask;
    }

    private async Task SaveProfileAsync()
    {
        if (_selected is null) return;
        _error = null;
        try
        {
            var body = new { UserName = _selected.UserName, Email = EditEmail, DisplayName = EditDisplayName, Password = string.Empty };
            var response = await Api.PutAsync($"api/identity/users/{_selected.Id}", body);
            EnsureOk(response);
            _editDialogOpen = false;
            Toast.Success(L.GetString("identity.users.toast.profileSaved", _selected.DisplayName));
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; Toast.Error(L.GetString("identity.users.toast.saveProfileFailed", ex.Message)); }
    }

    private async Task ResetPasswordAsync()
    {
        if (_selected is null) return;
        _error = null;
        try
        {
            var response = await Api.PutAsync($"api/identity/users/{_selected.Id}/password", new { Password = ResetPw });
            EnsureOk(response);
            _resetPwDialogOpen = false;
            Toast.Success(L.GetString("identity.users.toast.passwordReset", _selected.DisplayName));
        }
        catch (Exception ex) { _error = ex.Message; Toast.Error(L.GetString("identity.users.toast.resetPasswordFailed", ex.Message)); }
    }

    private async Task ToggleActiveAsync()
    {
        if (_selected is null) return;
        _error = null;
        var key = _selected.Id.ToString();
        _busy.Add(key);
        try
        {
            var enabling = !_selected.IsActive;
            var name = _selected.DisplayName;
            var response = await Api.PutAsync($"api/identity/users/{_selected.Id}/active", new { IsActive = !_selected.IsActive });
            EnsureOk(response);
            Toast.Success(L.GetString(enabling ? "identity.users.toast.enabled" : "identity.users.toast.disabled", name));
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; Toast.Error(L.GetString("identity.users.toast.toggleActiveFailed", ex.Message)); }
        finally { _busy.Remove(key); }
    }

    private async Task DeleteUserAsync()
    {
        if (_selected is null) return;
        _error = null;
        var name = _selected.DisplayName;
        try
        {
            var response = await Api.DeleteAsync($"api/identity/users/{_selected.Id}");
            EnsureOk(response);
            _deleteDialogOpen = false;
            Toast.Success(L.GetString("identity.users.toast.deleted", name));
            _selected = null;
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; Toast.Error(L.GetString("identity.users.toast.deleteFailed", ex.Message)); }
    }

    private async Task SaveRolesAsync()
    {
        if (_selected is null) return;
        _error = null;
        var key = _selected.Id.ToString();
        _busy.Add(key);
        try
        {
            var ids = _roleSelection.Where(kv => kv.Value).Select(kv => kv.Key).ToArray();
            var response = await Api.PutAsync($"api/identity/users/{_selected.Id}/roles", new { Ids = ids });
            EnsureOk(response);
            _roleDirty = false;
            Toast.Success(L.GetString("identity.users.toast.rolesSaved", _selected.DisplayName));
        }
        catch (Exception ex) { _error = ex.Message; Toast.Error(L.GetString("identity.users.toast.saveRolesFailed", ex.Message)); }
        finally { _busy.Remove(key); }
    }

    private static void EnsureOk(HttpResponseMessage response)
    {
        if (!response.IsSuccessStatusCode)
            throw new HttpRequestException($"{(int)response.StatusCode}: {response.Content.ReadAsStringAsync().GetAwaiter().GetResult()}");
    }
}
