@page "/forgot-password"
@layout IdentityLayout
@rendermode RenderMode.InteractiveServer
@attribute [AllowAnonymous]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using BlazorBoilerplate.Shared.Features.Identity
@inject NavigationManager Navigation
@inject BlazorBoilerplateApiClient Api
@inject ILocalizationService L
@inject FrontendLocalizationService FrontendLoc

@* 邮箱验证码找回密码界面：参考 Bluebird ForgotPasswordPage 与 ResetPasswordPage，
   沿用 SignIn 的 Fluent2 .auth-* 样式与 IdentityLayout。 *@

<div class="auth-head">
    <h1 class="auth-title">@L["identity.forgot.title"]</h1>
    <p class="auth-sub">@L["identity.forgot.subtitle"]</p>
</div>

@if (_message is not null)
{
    <div class="auth-msg @(_messageIsError ? "error" : "")">@_message</div>
}

@if (_resetSuccess)
{
    <button type="button" class="auth-btn" @onclick="GoToSignIn">@L["identity.forgot.goToSignIn"]</button>
}
else
{
    <div class="auth-field">
        <label class="auth-label" for="forgot-email">@L["identity.forgot.label.email"]</label>
        <div class="auth-input-wrap">
            <input id="forgot-email"
                   class="auth-input @(_emailInvalid ? "invalid" : "")"
                   type="email"
                   autocomplete="email"
                   placeholder="name@example.com"
                   @bind="_email" @bind:event="oninput" />
        </div>
        @if (_emailInvalid)
        {
            <span class="validation-message">@L["identity.signin.validation.email"]</span>
        }
    </div>

    <div class="auth-field">
        <label class="auth-label" for="forgot-code">@L["identity.signup.label.verificationCode"]</label>
        <div class="auth-code-row">
            <div class="auth-input-wrap">
                <input id="forgot-code"
                       class="auth-input @(_codeInvalid ? "invalid" : "")"
                       type="text"
                       inputmode="numeric"
                       maxlength="6"
                       autocomplete="one-time-code"
                       placeholder="@L["identity.signup.placeholder.verificationCode"]"
                       @bind="_verificationCode" @bind:event="oninput" />
            </div>
            <button type="button"
                    class="auth-code-btn"
                    disabled="@(_sendingCode || _cooldownSeconds > 0)"
                    @onclick="SendCodeAsync">
                @(_sendingCode ? L["identity.signup.sendingCode"] : _cooldownSeconds > 0 ? L.GetString("identity.signup.resendCooldown", _cooldownSeconds) : L["identity.signup.sendCode"])
            </button>
        </div>
        @if (_codeInvalid)
        {
            <span class="validation-message">@L["identity.signup.validation.verificationCode"]</span>
        }
    </div>

    <div class="auth-field">
        <label class="auth-label" for="forgot-password">@L["identity.forgot.label.newPassword"]</label>
        <div class="auth-input-wrap">
            <input id="forgot-password"
                   class="auth-input has-suffix @(_passwordInvalid ? "invalid" : "")"
                   type="@(_revealPassword ? "text" : "password")"
                   autocomplete="new-password"
                   placeholder="@L.GetString("identity.forgot.placeholder.newPassword", _passwordMinLength)"
                   @bind="_newPassword" @bind:event="oninput" />
            <button type="button" class="auth-suffix" title="@(_revealPassword ? L["identity.signin.hidePassword"] : L["identity.signin.showPassword"])" @onclick="ToggleRevealPassword">
                @if (_revealPassword)
                {
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 3l14 14" />
                        <path d="M8.2 5.3A9 9 0 0 1 10 5c5 0 8 5 8 5a13 13 0 0 1-2.2 2.6M5.1 6.3A13 13 0 0 0 2 10s3 5 8 5c1 0 1.9-.2 2.7-.5" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 10s3-5 8-5 8 5 8 5-3 5-8 5-8-5-8-5Z" />
                        <circle cx="10" cy="10" r="2.5" />
                    </svg>
                }
            </button>
        </div>
        @if (_passwordInvalid)
        {
            <span class="validation-message">@L.GetString("identity.forgot.validation.newPasswordMinLength", _passwordMinLength)</span>
        }
    </div>

    <div class="auth-field">
        <label class="auth-label" for="forgot-confirm">@L["identity.forgot.label.confirmPassword"]</label>
        <div class="auth-input-wrap">
            <input id="forgot-confirm"
                   class="auth-input has-suffix @(_confirmInvalid ? "invalid" : "")"
                   type="@(_revealConfirm ? "text" : "password")"
                   autocomplete="new-password"
                   placeholder="@L["identity.forgot.placeholder.confirmPassword"]"
                   @bind="_confirmPassword" @bind:event="oninput" />
            <button type="button" class="auth-suffix" title="@(_revealConfirm ? L["identity.signin.hidePassword"] : L["identity.signin.showPassword"])" @onclick="ToggleRevealConfirm">
                @if (_revealConfirm)
                {
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 3l14 14" />
                        <path d="M8.2 5.3A9 9 0 0 1 10 5c5 0 8 5 8 5a13 13 0 0 1-2.2 2.6M5.1 6.3A13 13 0 0 0 2 10s3 5 8 5c1 0 1.9-.2 2.7-.5" />
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 10s3-5 8-5 8 5 8 5-3 5-8 5-8-5-8-5Z" />
                        <circle cx="10" cy="10" r="2.5" />
                    </svg>
                }
            </button>
        </div>
        @if (_confirmInvalid)
        {
            <span class="validation-message">@L["identity.signup.validation.passwordMismatch"]</span>
        }
    </div>

    <button type="button" class="auth-btn" disabled="@_busy" @onclick="ResetAsync">
        @(_busy ? L["identity.forgot.submitting"] : L["identity.forgot.submit"])
    </button>

    <div class="auth-links-inline">
        <button type="button" class="auth-link" @onclick="GoToSignIn">@L["identity.signup.backToSignIn"]</button>
        @if (_registerEnabled)
        {
            <span>@L["identity.forgot.or"]</span>
            <button type="button" class="auth-link" @onclick="GoToSignUp">@L["identity.signin.signUpNow"]</button>
        }
    </div>
}

@code {
    private string _email = string.Empty;
    private string _verificationCode = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _revealPassword;
    private bool _revealConfirm;
    private bool _busy;
    private bool _sendingCode;
    private bool _resetSuccess;
    private int _cooldownSeconds;
    private CancellationTokenSource? _cooldownCts;
    private bool _emailInvalid;
    private bool _codeInvalid;
    private bool _passwordInvalid;
    private bool _confirmInvalid;
    private string? _message;
    private bool _messageIsError;
    private string? _returnUrl;
    private bool _registerEnabled = true;
    private int _passwordMinLength = 6;

    protected override async Task OnInitializedAsync()
    {
        await FrontendLoc.EnsureLoadedAsync();
        SetupStatus? status = null;
        try { status = await Api.GetSetupStatusAsync(); }
        catch { /* ApiHost 不可达时不阻断页面 */ }

        if (status is { Installed: false, DevBypass: false })
        {
            Navigation.NavigateTo("/setup");
            return;
        }

        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length == 2 && pair[0] == "return-url")
                _returnUrl = Uri.UnescapeDataString(pair[1].Replace("+", " "));
        }
        _returnUrl = NormalizeReturnUrl(_returnUrl, Navigation.BaseUri);

        try
        {
            var pub = await Api.GetPublicSystemSettingsAsync();
            _registerEnabled = pub.RegisterEnabled;
            if (pub.PasswordMinLength >= 6)
                _passwordMinLength = pub.PasswordMinLength;
        }
        catch { /* 忽略：失败时保留默认值 */ }
    }

    private async Task SendCodeAsync()
    {
        var email = _email.Trim();
        _emailInvalid = string.IsNullOrWhiteSpace(email) || !email.Contains('@');
        if (_emailInvalid)
        {
            _message = L["identity.forgot.error.invalidEmail"];
            _messageIsError = true;
            return;
        }

        _sendingCode = true;
        _message = null;
        try
        {
            await Api.SendEmailCodeAsync(new SendEmailCodeRequestDto(email, "reset-password"));
            _message = L["identity.signup.codeSent"];
            _messageIsError = false;
            StartCooldown(60);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _sendingCode = false;
        }
    }

    private async Task ResetAsync()
    {
        var email = _email.Trim();
        var code = _verificationCode.Trim();
        _emailInvalid = string.IsNullOrWhiteSpace(email) || !email.Contains('@');
        _codeInvalid = string.IsNullOrWhiteSpace(code) || code.Length < 6;
        _passwordInvalid = _newPassword.Length < _passwordMinLength;
        _confirmInvalid = !string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal);

        if (_emailInvalid || _codeInvalid || _passwordInvalid || _confirmInvalid)
        {
            _message = L["identity.signup.error.checkForm"];
            _messageIsError = true;
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            await Api.ResetPasswordByEmailAsync(new ResetPasswordByEmailRequestDto(email, code, _newPassword));
            _resetSuccess = true;
            _message = L["identity.forgot.success"];
            _messageIsError = false;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartCooldown(int seconds)
    {
        _cooldownCts?.Cancel();
        _cooldownCts?.Dispose();
        _cooldownCts = new CancellationTokenSource();
        var ct = _cooldownCts.Token;
        _cooldownSeconds = seconds;
        _ = RunCooldownAsync(ct);
    }

    private async Task RunCooldownAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (_cooldownSeconds > 0 && await timer.WaitForNextTickAsync(ct))
            {
                _cooldownSeconds--;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // 组件释放或重新发送时取消计时器
        }
    }

    private void GoToSignIn()
    {
        var url = string.IsNullOrWhiteSpace(_returnUrl)
            ? "/sign-in"
            : $"/sign-in?return-url={Uri.EscapeDataString(_returnUrl)}";
        Navigation.NavigateTo(url);
    }

    private void GoToSignUp()
    {
        var url = string.IsNullOrWhiteSpace(_returnUrl)
            ? "/sign-up"
            : $"/sign-up?return-url={Uri.EscapeDataString(_returnUrl)}";
        Navigation.NavigateTo(url);
    }

    private void ToggleRevealPassword() => _revealPassword = !_revealPassword;
    private void ToggleRevealConfirm() => _revealConfirm = !_revealConfirm;

    private static string? NormalizeReturnUrl(string? returnUrl, string baseUri)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)) return null;
        if (Uri.TryCreate(returnUrl, UriKind.Absolute, out var abs))
        {
            if (Uri.TryCreate(baseUri, UriKind.Absolute, out var baseAbs) &&
                string.Equals(abs.Authority, baseAbs.Authority, StringComparison.OrdinalIgnoreCase))
                return abs.PathAndQuery;
            return null;
        }
        return returnUrl.StartsWith('/') && !returnUrl.StartsWith("//") ? returnUrl : null;
    }

    public void Dispose()
    {
        _cooldownCts?.Cancel();
        _cooldownCts?.Dispose();
    }
}
