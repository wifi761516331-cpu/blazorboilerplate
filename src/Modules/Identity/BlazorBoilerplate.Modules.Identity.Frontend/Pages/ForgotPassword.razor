@page "/forgot-password"
@layout IdentityLayout
@rendermode RenderMode.InteractiveServer
@attribute [AllowAnonymous]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using BlazorBoilerplate.Shared.Features.Identity

@* 邮箱验证码找回密码界面：原生控件已改为 Bit.BlazorUI；密码显隐用 BitTextField 的 CanRevealPassword。 *@

<div class="auth-head">
    <BitText Element="h1" Class="auth-title">@L["identity.forgot.title"]</BitText>
    <BitText Class="auth-sub">@L["identity.forgot.subtitle"]</BitText>
</div>

@if (_message is not null)
{
    <BitCallout Class="@("auth-msg " + (_messageIsError ? "error" : ""))">@_message</BitCallout>
}

@if (_resetSuccess)
{
    <BitButton Color="BitColor.Primary" FullWidth OnClick="GoToSignIn">@L["identity.forgot.goToSignIn"]</BitButton>
}
else
{
    <div class="auth-field">
        <BitTextField @bind-Value="_email"
                      Label="@L["identity.forgot.label.email"]"
                      Type="BitInputType.Email"
                      Placeholder="name@example.com"
                      Invalid="@_emailInvalid"
                      ErrorMessage="@L["identity.signin.validation.email"]" />
    </div>

    <div class="auth-field">
        <div class="auth-code-row">
            <BitTextField @bind-Value="_verificationCode"
                          Label="@L["identity.signup.label.verificationCode"]"
                          MaxLength="6"
                          InputMode="BitInputMode.Numeric"
                          Placeholder="@L["identity.signup.placeholder.verificationCode"]"
                          Invalid="@_codeInvalid"
                          ErrorMessage="@L["identity.signup.validation.verificationCode"]" />
            <BitButton Variant="BitVariant.Outline"
                       Class="auth-code-btn"
                       Disabled="@(_sendingCode || _cooldownSeconds > 0)"
                       OnClick="SendCodeAsync">
                @(_sendingCode ? L["identity.signup.sendingCode"] : _cooldownSeconds > 0 ? L.GetString("identity.signup.resendCooldown", _cooldownSeconds) : L["identity.signup.sendCode"])
            </BitButton>
        </div>
    </div>

    <div class="auth-field">
        <BitTextField @bind-Value="_newPassword"
                      Label="@L["identity.forgot.label.newPassword"]"
                      Type="BitInputType.Password"
                      CanRevealPassword
                      Placeholder="@L.GetString("identity.forgot.placeholder.newPassword", _passwordMinLength)"
                      Invalid="@_passwordInvalid"
                      ErrorMessage="@L.GetString("identity.forgot.validation.newPasswordMinLength", _passwordMinLength)" />
    </div>

    <div class="auth-field">
        <BitTextField @bind-Value="_confirmPassword"
                      Label="@L["identity.forgot.label.confirmPassword"]"
                      Type="BitInputType.Password"
                      CanRevealPassword
                      Placeholder="@L["identity.forgot.placeholder.confirmPassword"]"
                      Invalid="@_confirmInvalid"
                      ErrorMessage="@L["identity.signup.validation.passwordMismatch"]" />
    </div>

    <BitButton Color="BitColor.Primary" FullWidth IsLoading="@_busy" OnClick="ResetAsync">
        @L["identity.forgot.submit"]
    </BitButton>

    <div class="auth-links-inline">
        <BitButton Variant="BitVariant.Text" Class="auth-link" OnClick="GoToSignIn">@L["identity.signup.backToSignIn"]</BitButton>
        @if (_registerEnabled)
        {
            <span>@L["identity.forgot.or"]</span>
            <BitButton Variant="BitVariant.Text" Class="auth-link" OnClick="GoToSignUp">@L["identity.signin.signUpNow"]</BitButton>
        }
    </div>
}
