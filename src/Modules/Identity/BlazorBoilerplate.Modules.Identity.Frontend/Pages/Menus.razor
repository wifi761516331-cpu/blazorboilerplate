@page "/identity/menus"
@using System.Reflection
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using BlazorBoilerplate.Shared.Features.Account
@using BlazorBoilerplate.Shared.Features.Identity

<div class="page-callout">
    <BitText Element="h1" Class="page-title">@L["identity.menus.title"]</BitText>
    <BitText Class="muted">@L["identity.menus.subtitle"]</BitText>
</div>

<WidgetZone Name="identity_menus_top" />

<div class="id-page">
    <div class="id-toolbar">
        <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="RefreshAsync" Disabled="@_loading">@L["platform.common.refresh"]</BitButton>
        <PermissionGate Code="identity.menu.create">
            <BitButton IconName="@BitIconName.Add" OnClick="@(() => OpenCreate(null))">@L["identity.menus.createTop"]</BitButton>
            @if (_selected is not null && !_creating)
            {
                <BitButton IconName="@BitIconName.AddTo" OnClick="@(() => OpenCreate(_selected.Id))">@L["identity.menus.createChild"]</BitButton>
            }
        </PermissionGate>
        <BitTextField @bind-Value="_searchText"
                      @bind-Value:after="RebuildNavAndParents"
                      Immediate
                      Placeholder="@L["identity.menus.searchPlaceholder"]"
                      Style="min-width: 200px;" />
        <BitCheckbox @bind-Value="_showHidden" @bind-Value:after="RebuildNavAndParents" Label="@L["identity.menus.showHidden"]" />
    </div>

    @if (_error is not null)
    {
        <BitCallout Class="page-callout error">@_error</BitCallout>
    }

    <div class="id-columns">
        <BitCard Class="id-list-card">
            <div class="menu-tree-header">
                <span>@L["identity.menus.treeTitle"]</span>
                <span>@L.GetString("identity.menus.totalCount", _menus.Count)</span>
            </div>
            @if (_loading)
            {
                <BitText Class="muted">@L["platform.common.loading"]</BitText>
            }
            else if (_menuNavItems.Count == 0)
            {
                <BitText Class="muted">@L["identity.menus.empty"]</BitText>
            }
            else
            {
                <BitNav Items="_menuNavItems"
                        Mode="BitNavMode.Manual"
                        Reselectable
                        OnSelectItem="@((BitNavItem item) => SelectMenuAsync(item))">
                    <ItemTemplate Context="item">
                        @{
                            var menu = item.Data as IdentityMenuDto;
                        }
                        <span class="menu-tree-item" @onclick="@(() => SelectMenuAsync(item))">
                            <AppIcon Name="@(string.IsNullOrWhiteSpace(menu?.Icon) ? "EditList" : menu!.Icon!)" Class="menu-tree-icon" />
                            <span class="menu-tree-text">@item.Text</span>
                            @if (menu is not null && !menu.IsVisible)
                            {
                                <span class="menu-tree-tag">@L["identity.menus.status.hidden"]</span>
                            }
                            @if (menu is not null && menu.Kind == "group")
                            {
                                <span class="menu-tree-tag">@L["identity.menus.kind.groupShort"]</span>
                            }
                        </span>
                    </ItemTemplate>
                </BitNav>
            }
        </BitCard>

        <BitCard Class="id-detail-card">
            @if (_selected is null && !_creating)
            {
                <BitText Class="muted">@L["identity.menus.selectPrompt"]</BitText>
            }
            else
            {
                <div class="id-form">
                    <BitStack Horizontal VerticalAlign="BitAlignment.Center" Gap="0.5rem" Wrap>
                        <BitText Typography="BitTypography.H6">
                            @(_creating ? (EditParentId is null ? L["identity.menus.createTop"] : L["identity.menus.createChild"]) : L["identity.menus.editTitle"])
                        </BitText>
                        @if (!_creating && _selected is not null)
                        {
                            <span title="@_selected.Id">
                                <BitTag Color="BitColor.TertiaryBackground">@_selected.Id.ToString("N")[..8]</BitTag>
                            </span>
                        }
                        <BitBadge Color="@(EditIsVisible ? BitColor.Success : BitColor.Tertiary)">
                            @(EditIsVisible ? L["identity.menus.status.visible"] : L["identity.menus.status.hidden"])
                        </BitBadge>
                        <BitTag Color="@(string.IsNullOrWhiteSpace(EditModuleId) ? BitColor.SecondaryBackground : BitColor.PrimaryBackground)">
                            @(string.IsNullOrWhiteSpace(EditModuleId) ? L["identity.menus.systemBuiltIn"] : L.GetString("identity.menus.modulePrefix", EditModuleId))
                        </BitTag>
                    </BitStack>

                    <div class="menu-form-grid">
                        <BitTextField @bind-Value="EditName" Label="@L["identity.menus.field.nameRequired"]" Placeholder="@L["identity.menus.placeholder.name"]" Required />
                        <BitTextField @bind-Value="EditPath" Label="@L["identity.menus.field.pathRequired"]" Placeholder="@L["identity.menus.placeholder.path"]" Required />

                        <BitDropdown Label="@L["identity.menus.field.parent"]" @bind-Value="EditParentId" Items="_parentItems" />
                        <BitDropdown Label="@L["identity.menus.field.permissionCode"]" @bind-Value="EditPermissionCode" Items="_permissionItems" />

                        <BitDropdown Label="@L["identity.menus.field.kind"]" @bind-Value="EditKind" Items="_kindItems" />
                        <div class="menu-sort-row">
                            <BitNumberField @bind-Value="EditSort" Label="@L["identity.menus.field.sort"]" />
                            @if (!_creating && _selected is not null)
                            {
                                <PermissionGate Code="identity.menu.update">
                                    <BitButton Variant="BitVariant.Outline"
                                               IconName="@BitIconName.Up"
                                               Disabled="@(_busy || !CanMoveSibling(-1))"
                                               OnClick="@(() => MoveSiblingAsync(-1))">
                                        @L["identity.menus.action.moveUp"]
                                    </BitButton>
                                    <BitButton Variant="BitVariant.Outline"
                                               IconName="@BitIconName.Down"
                                               Disabled="@(_busy || !CanMoveSibling(1))"
                                               OnClick="@(() => MoveSiblingAsync(1))">
                                        @L["identity.menus.action.moveDown"]
                                    </BitButton>
                                </PermissionGate>
                            }
                        </div>

                        <div class="menu-icon-row menu-form-full">
                            <BitTextField @bind-Value="EditIcon" Label="@L["identity.menus.field.icon"]" Placeholder="@L["identity.menus.placeholder.icon"]" />
                            <BitButton Variant="BitVariant.Outline"
                                       Title="@L["identity.menus.pickIconTitle"]"
                                       OnClick="OpenIconPicker">
                                <span class="menu-icon-picker-btn">
                                    <AppIcon Name="@(string.IsNullOrWhiteSpace(EditIcon) ? "EditList" : EditIcon.Trim())" />
                                    <span>@L["identity.menus.pickIcon"]</span>
                                </span>
                            </BitButton>
                        </div>
                    </div>

                    <BitCheckbox @bind-Value="EditIsVisible" Label="@L["identity.menus.field.isVisible"]" />

                    <div class="row">
                        <PermissionGate Code="@(_creating ? "identity.menu.create" : "identity.menu.update")">
                            <BitButton Color="BitColor.Primary" IsLoading="_busy" OnClick="SaveAsync">
                                @(_creating ? L["identity.menus.action.create"] : L["identity.common.saveChanges"])
                            </BitButton>
                        </PermissionGate>
                        @if (_creating)
                        {
                            <BitButton Variant="BitVariant.Outline" Disabled="@_busy" OnClick="CancelCreate">@L["platform.common.cancel"]</BitButton>
                        }
                        else if (_selected is not null)
                        {
                            <BitSpacer />
                            <PermissionGate Code="identity.menu.delete">
                                <BitButton Color="BitColor.Error" Variant="BitVariant.Outline" Disabled="@_busy" OnClick="@(() => _deleteDialogOpen = true)">
                                    @L["platform.common.delete"]
                                </BitButton>
                            </PermissionGate>
                        }
                    </div>
                </div>
            }
        </BitCard>
    </div>
</div>

<BlazorBoilerplateModal @bind-IsOpen="_deleteDialogOpen"
            Title="@L["identity.menus.modal.deleteTitle"]" Danger OkText="@L["platform.common.delete"]"
            Message="@L.GetString("identity.menus.modal.deleteConfirm", _selected?.Name ?? "")"
            OnOk="DeleteAsync" />

<BlazorBoilerplateModal @bind-IsOpen="_iconPickerOpen"
            Title="@L.GetString("identity.menus.iconPicker.title", AllIcons.Count)"
            ModalClass="wide"
            ShowCancel="false"
            OkText="@L["platform.common.close"]">
    <div class="icon-picker-body">
        <BitSearchBox @bind-Value="_iconSearch"
                      Placeholder="@L["identity.menus.iconPicker.searchPlaceholder"]"
                      Immediate
                      OnChange="OnIconSearchChanged"
                      OnClear="@(() => OnIconSearchChanged(string.Empty))" />

        @{
            var filtered = GetFilteredIcons();
            var rows = filtered.Chunk(10).ToList();
        }

        @if (filtered.Count == 0)
        {
            <BitText Class="muted">@L["identity.menus.iconPicker.empty"]</BitText>
        }
        else
        {
            <div class="icon-picker-scroll">
                <Virtualize Items="@rows" Context="row" ItemSize="48" OverscanCount="4">
                    <div class="icon-picker-grid-row">
                        @foreach (var icon in row)
                        {
                            var isActive = string.Equals(EditIcon?.Trim(), icon.Value, StringComparison.OrdinalIgnoreCase);
                            <BitButton Variant="BitVariant.Text"
                                       Class="@($"icon-picker-item {(isActive ? "active" : "")}")"
                                       Title="@icon.Value"
                                       OnClick="@(() => SelectIcon(icon.Value))">
                                <span class="icon-picker-glyph">
                                    <AppIcon Name="@icon.Value" />
                                </span>
                            </BitButton>
                        }
                    </div>
                </Virtualize>
            </div>
        }

        <div class="icon-picker-footer">
            <BitText Class="muted">@L.GetString("identity.menus.iconPicker.count", filtered.Count)</BitText>
        </div>
    </div>
</BlazorBoilerplateModal>

<WidgetZone Name="identity_menus_bottom" />

