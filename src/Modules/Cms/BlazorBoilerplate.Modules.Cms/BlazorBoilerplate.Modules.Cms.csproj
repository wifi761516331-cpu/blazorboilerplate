<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorBoilerplate.Modules.Cms</RootNamespace>
    <AssemblyName>BlazorBoilerplate.Modules.Cms</AssemblyName>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- 模块包需要自带私有 NuGet 依赖（如 Microsoft.Extensions.AI / OpenAI），
         否则 AssemblyDependencyResolver 在模块包目录找不到 DLL，加载期 FileNotFound。 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorBoilerplate.Modules.Cms.Domain\BlazorBoilerplate.Modules.Cms.Domain.csproj" />
    <ProjectReference Include="..\BlazorBoilerplate.Modules.Cms.Application\BlazorBoilerplate.Modules.Cms.Application.csproj" />
    <ProjectReference Include="..\BlazorBoilerplate.Modules.Cms.Infrastructure\BlazorBoilerplate.Modules.Cms.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BlazorBoilerplate.Application\BlazorBoilerplate.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BlazorBoilerplate.ModuleAbstractions\BlazorBoilerplate.ModuleAbstractions.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\BlazorBoilerplate.Persistence\BlazorBoilerplate.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="localization\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
