@* 混合图标渲染器：
   1. 内置常用图标保留高清晰度内联 SVG；
   2. 其余名称直接透传给 Bit.BlazorUI 的 BitIcon（支持 BitIconName 全量图标库）。 *@
@using Bit.BlazorUI

@if (string.IsNullOrWhiteSpace(Name))
{
    <svg class="app-icon @Class" viewBox="0 0 20 20" fill="none" stroke="currentColor"
         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="10" cy="10" r="7" />
        <circle cx="10" cy="10" r="2" />
    </svg>
}
else if (IsCustomSvg(Name))
{
<svg class="app-icon @Class" viewBox="0 0 20 20" fill="none" stroke="currentColor"
     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @if (Name == "Home")
    {
        <path d="M3 9.2 10 3l7 6.2V17a1 1 0 0 1-1 1h-4v-5H8v5H4a1 1 0 0 1-1-1z" />
    }
    else if (Name == "Shop" || Name == "Product")
    {
        <path d="M3 7h14l-1 10H4L3 7Z" />
        <path d="M7 7V5a3 3 0 0 1 6 0v2" />
    }
    else if (Name == "People" || Name == "User")
    {
        <circle cx="8" cy="7" r="3" />
        <path d="M2.5 17c0-3 2.4-5 5.5-5s5.5 2 5.5 5" />
        <path d="M14 5.5a2.5 2.5 0 0 1 0 5" />
        <path d="M15 12.5c2 .7 3.5 2.3 3.5 4.5" />
    }
    else if (Name == "SecurityGroup" || Name == "Shield")
    {
        <path d="M10 2 3.5 4.6v4.9c0 4 2.7 6.9 6.5 8.5 3.8-1.6 6.5-4.5 6.5-8.5V4.6z" />
        <path d="m7.4 10 1.8 1.8 3.4-3.6" />
    }
    else if (Name == "EditList" || Name == "List")
    {
        <path d="M7.5 5h9M7.5 10h9M7.5 15h9" />
        <path d="M3.5 5h.01M3.5 10h.01M3.5 15h.01" />
    }
    else if (Name == "Puzzle" || Name == "Module")
    {
        <rect x="3" y="3" width="6" height="6" rx="1" />
        <rect x="11" y="3" width="6" height="6" rx="1" />
        <rect x="3" y="11" width="6" height="6" rx="1" />
        <rect x="11" y="11" width="6" height="6" rx="1" />
    }
    else if (Name == "Grid" || Name == "Dashboard")
    {
        <rect x="3" y="3" width="6" height="6" rx="1" />
        <rect x="11" y="3" width="6" height="6" rx="1" />
        <rect x="3" y="11" width="6" height="6" rx="1" />
        <rect x="11" y="11" width="6" height="6" rx="1" />
    }
    else if (Name == "Chart" || Name == "BarChartVerticalFill")
    {
        <path d="M3 17h14" />
        <rect x="4" y="10" width="3" height="7" rx=".5" />
        <rect x="8.5" y="6" width="3" height="11" rx=".5" />
        <rect x="13" y="3" width="3" height="14" rx=".5" />
    }
    else if (Name == "Pie" || Name == "Donut")
    {
        <path d="M10 3a7 7 0 1 0 7 7h-7z" />
        <path d="M12 3a7 7 0 0 1 5 5h-5z" />
    }
    else if (Name == "Settings")
    {
        <circle cx="10" cy="10" r="3" />
        <path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4" />
    }
    else if (Name == "Bell" || Name == "Notification")
    {
        <path d="M5 8.5a5 5 0 0 1 10 0c0 3.7 1.5 4.8 1.5 4.8H3.5S5 12.2 5 8.5Z" />
        <path d="M8.2 16a2 2 0 0 0 3.6 0" />
    }
    else if (Name == "Sunny")
    {
        <circle cx="10" cy="10" r="3.5" />
        <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M15.7 4.3l-1.4 1.4M5.7 14.3l-1.4 1.4" />
    }
    else if (Name == "ClearNight")
    {
        <path d="M16 12.6A7 7 0 0 1 7.4 4a7 7 0 1 0 8.6 8.6Z" />
    }
    else if (Name == "CollapseMenu" || Name == "Menu")
    {
        <path d="M3 5h14M3 10h14M3 15h14" />
    }
    else if (Name == "Back")
    {
        <path d="M17 10H3M8.5 4.5 3 10l5.5 5.5" />
    }
    else if (Name == "Refresh")
    {
        <path d="M16.5 8A6.5 6.5 0 1 0 17 11" />
        <path d="M16.5 3.5V8H12" />
    }
    else if (Name == "Add")
    {
        <path d="M10 3v14M3 10h14" />
    }
    else if (Name == "Org" || Name == "Tenant")
    {
        <rect x="6" y="3" width="8" height="5" rx="1" />
        <path d="M10 8v3M4 17v-4h12v4M4 17h12" />
    }
    else if (Name == "Info")
    {
        <circle cx="10" cy="10" r="7.5" />
        <path d="M10 9v5M10 6.5h.01" />
    }
    else if (Name == "ChevronDown")
    {
        <path d="m5 8 5 5 5-5" />
    }
    else if (Name == "ChevronRight")
    {
        <path d="m8 5 5 5-5 5" />
    }
    else if (Name == "ChevronLeft")
    {
        <path d="m12 5-5 5 5 5" />
    }
    else if (Name == "Contact" || Name == "Profile")
    {
        <circle cx="10" cy="7" r="3" />
        <path d="M4 17c0-3 2.7-5 6-5s6 2 6 5" />
    }
    else if (Name == "Globe" || Name == "Language")
    {
        <circle cx="10" cy="10" r="7.5" />
        <path d="M2.5 10h15" />
        <path d="M10 2.5c2 2 3 4.5 3 7.5s-1 5.5-3 7.5c-2-2-3-4.5-3-7.5s1-5.5 3-7.5Z" />
    }
    else if (Name == "Clock" || Name == "WorldClock")
    {
        <circle cx="10" cy="10" r="7.5" />
        <path d="M10 6v4.5l3 2" />
    }
    else if (Name == "Upload" || Name == "CloudUpload")
    {
        <path d="M10 13V3.5" />
        <path d="m6.5 7 3.5-3.5L13.5 7" />
        <path d="M3.5 12v2.5a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V12" />
    }
    else if (Name == "RingerOff")
    {
        <path d="M3 3l14 14" />
        <path d="M5 8.5a5 5 0 0 1 8-4M15 10c0 2.5.8 3.8 1.5 4.8H8" />
        <path d="M8.2 16a2 2 0 0 0 3.6 0" />
    }
    else if (Name == "SignOut")
    {
        <path d="M8 3H5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h3" />
        <path d="m12 6 4 4-4 4M8 10h8" />
    }
    else if (Name == "AddFriend")
    {
        <circle cx="8" cy="7" r="3" />
        <path d="M2.5 17c0-3 2.4-5 5.5-5" />
        <path d="M15 7v6M12 10h6" />
    }
    else if (Name == "Mail")
    {
        <rect x="2.5" y="4.5" width="15" height="11" rx="1.5" />
        <path d="m3 5.5 7 5 7-5" />
    }
    else if (Name == "Edit")
    {
        <path d="M4 16l1-4 8-8a1.5 1.5 0 0 1 2 0l1 1a1.5 1.5 0 0 1 0 2l-8 8z" />
        <path d="M11.5 5.5 14.5 8.5" />
    }
    else if (Name == "Check")
    {
        <path d="m4 10 4 4 8-8" />
    }
    else if (Name == "Warning")
    {
        <path d="M10 3 18 16.5H2z" />
        <path d="M10 8v4M10 14.2h.01" />
    }
    else if (Name == "Error")
    {
        <circle cx="10" cy="10" r="7.5" />
        <path d="m7.5 7.5 5 5M12.5 7.5l-5 5" />
    }
    else if (Name == "Close")
    {
        <path d="M5 5l10 10M15 5 5 15" />
    }
    else if (Name == "Attach")
    {
        <path d="M13.5 6.5 7.8 12.2a2 2 0 0 0 2.8 2.8l6.4-6.4a4 4 0 0 0-5.7-5.7l-6.4 6.4a6 6 0 0 0 8.5 8.5l5.6-5.6" />
    }
</svg>
}
else
{
    <BitIcon IconName="@Name" Class="@($"app-icon app-icon-bit {Class}")" />
}

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string? Class { get; set; }

    private static readonly HashSet<string> CustomSvgIcons = new(StringComparer.Ordinal)
    {
        "Home", "Shop", "Product", "People", "User", "SecurityGroup", "Shield",
        "EditList", "List", "Puzzle", "Module", "Grid", "Dashboard",
        "Chart", "BarChartVerticalFill", "Pie", "Donut", "Settings",
        "Bell", "Notification", "Sunny", "ClearNight", "CollapseMenu", "Menu",
        "Back", "Refresh", "Add", "Org", "Tenant", "Info",
        "ChevronDown", "ChevronRight", "ChevronLeft", "Contact", "Profile",
        "Globe", "Language", "Clock", "WorldClock", "Upload", "CloudUpload",
        "RingerOff", "SignOut", "AddFriend", "Mail", "Edit", "Check",
        "Warning", "Error", "Close", "Attach"
    };

    private static bool IsCustomSvg(string name) => CustomSvgIcons.Contains(name);
}
