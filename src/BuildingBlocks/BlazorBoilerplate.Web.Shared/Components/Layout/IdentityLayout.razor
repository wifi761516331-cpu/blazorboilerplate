@* 独立页面布局：移植自 Bluebird AppShell 的 identity 分支 + IdentityHeader。
   /setup（首次运行向导）与 /sign-in（登录）通过 @layout 直接使用本布局，
   完全不经过 MainLayout —— 没有侧栏、顶栏、底部导航，也不依赖 MainLayout 的任何分支判断。
   左 30% 表单 / 右 70% 渐变插画，与 Bluebird AppShell.razor.scss 的 &.identity 一致。
   字段/方法在 IdentityLayout.razor.cs，样式在 IdentityLayout.razor.css。 *@
@inherits LayoutComponentBase
@implements IDisposable

<div class="identity-shell @(_dark ? "bb-dark" : "")">
    <div class="identity-header">
        <a href="/" class="home-link" @onclick="GoHome" @onclick:preventDefault="true">
            <AppIcon Name="Home" /> @L["platform.nav.backHome"]
        </a>
        <div class="spacer"></div>
        @* 语言下拉：对齐 Bluebird IdentityHeader 右上角国旗+箭头样式，就地切换语言不整页刷新。
           国旗直接用 Extras 包自带的静态图片（BitFlag 组件在本环境未渲染出图片）。 *@
        <div class="identity-lang">
            <BitButton Variant="BitVariant.Text" Class="lang-trigger" Title="@L["platform.common.language"]"
                       aria-expanded="@_langOpen" OnClick="() => _langOpen = !_langOpen">
                <img class="lang-flag" src="@FlagSrc(CurrentFlag())" alt="" />
                <AppIcon Name="ChevronDown" />
            </BitButton>
            @if (_langOpen)
            {
                <div class="lang-menu" role="menu">
                    @foreach (var culture in _cultures)
                    {
                        <BitButton Variant="BitVariant.Text"
                                   Class="@($"lang-item {(culture.Code == _culture ? "selected" : "")}")"
                                   role="menuitem" OnClick="() => SelectLanguage(culture)">
                            <img class="lang-flag" src="@FlagSrc(FlagOf(culture))" alt="" />
                            <span>@culture.Text</span>
                        </BitButton>
                    }
                </div>
            }
        </div>
        <BitButton Variant="BitVariant.Text" Class="icon-btn" Title="@L["platform.common.themeToggle"]" OnClick="() => _dark = !_dark">
            <AppIcon Name="@(_dark ? "Sunny" : "ClearNight")" />
        </BitButton>
    </div>

    <main class="identity-main">
        <div class="identity-body">
            @* culture 或词典版本变化时重建登录/向导页，使 L[...] 就地重新求值（线路不断）。 *@
            <div class="identity-form" @key="FrontendLoc.CurrentCulture + ':' + FrontendLoc.Version.ToString()">
                @Body
            </div>
        </div>

        <div class="identity-panel">
            <h2 class="panel-title">@L["platform.identityPanel.title"]</h2>
            <p class="panel-sub">@L["platform.identityPanel.subtitle"]</p>
            <div class="panel-badges">
                <span class="panel-badge">.NET 10</span>
                <span class="panel-badge">EF Core Migrations</span>
                <span class="panel-badge">Dynamic Module Runtime</span>
                <span class="panel-badge">Bit.BlazorUI</span>
            </div>
        </div>
    </main>

    @* 全局通知容器（/setup 与 /sign-in 也可弹出操作提示） *@
    <BlazorBoilerplateToast />
</div>
