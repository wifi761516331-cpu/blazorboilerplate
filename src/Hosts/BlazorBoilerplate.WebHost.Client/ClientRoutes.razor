<Router AppAssembly="@typeof(ClientRoutes).Assembly"
        AdditionalAssemblies="@ModuleCatalog.Assemblies"
        OnNavigateAsync="OnNavigateAsync">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@PickLayout()" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@PickLayout()">
            @if (_notFoundDomainComponent is not null)
            {
                <DynamicComponent Type="@_notFoundDomainComponent" />
            }
            else
            {
                <div class="page-callout">
                    @L["platform.error.routeNotFound"]
                </div>
            }
        </LayoutView>
    </NotFound>
</Router>
