@page "/tenants"
@namespace BlazorBoilerplate.WebHost.Components.Pages

@* 租户管理：手风琴 + 卡片列表 + 管理员网格。
   普通用户视图 = 「我的租户」：手风琴（新建租户 / 邀请成员 / 编辑当前租户）+ 卡片列表（切换·接受 / 离开·拒绝）。
   管理员（tenant.create）额外看到「管理所有租户」网格：启用停用开关 + 编辑。
   数据来自 UserController.GetTenants（当前用户的租户成员关系，含待接受邀请）；切换/接受经由 blazorAuth.switchTenant，
   离开/拒绝经由 Api.LeaveTenantAsync；创建/编辑调用 Api.CreateTenantAsync / UpdateTenantAsync。
   Accepted=false 表示待接受邀请，Accepted=true 表示已是成员；Current=true 表示 claims 中当前选中的租户。 *@

<section class="mytenants-page">
<div class="mytenants-root">
<BitText Typography="BitTypography.H4">@L["platform.nav.myTenant"]</BitText>

@if (_loadError is not null)
{
    <BitCallout Class="page-callout error">@_loadError</BitCallout>
}

@if (_loading)
{
    <div class="mytenants-loading"><span class="blazorboilerplate-spinner"></span> @L["platform.common.loading"]</div>
}
else
{
    @* 手风琴：同一时刻仅展开一个分区。无租户时默认展开「新建租户」。 *@
    <div class="mytenants-accordion">
        @* 1. 新建租户（始终可用）。 *@
        <PermissionView Code="tenant.create">
            <div class="mt-section @(_expanded == "create" ? "expanded" : "")">
                <BitButton Variant="BitVariant.Text" FullWidth Class="mt-section-header" OnClick="ToggleCreate">
                    <AppIcon Name="Add" />
                    <span class="mt-section-title">@L["platform.tenants.createTitle"]</span>
                    <AppIcon Name="ChevronDown" Class="mt-chevron" />
                </BitButton>
                @if (_expanded == "create")
                {
                    <div class="mt-section-body">
                        <div class="mt-form">
                            <BitTextField Label="@L["platform.tenants.field.nameRequired"]" @bind-Value="_createName"
                                          Placeholder="@L["platform.tenants.field.namePlaceholder"]" />
                            <BitTextField Label="@L["platform.tenants.field.title"]" @bind-Value="_createTitle"
                                          Placeholder="@L["platform.tenants.field.titlePlaceholder"]" />
                            <BitTextField Label="@L["platform.tenants.field.domain"]" @bind-Value="_createDomain"
                                          Placeholder="tenant.example.com" />
                        </div>
                        <BitButton Color="BitColor.Primary" Disabled="@_busy" OnClick="CreateAsync">
                            @L["platform.common.save"]
                        </BitButton>
                    </div>
                }
            </div>
        </PermissionView>

        @* 2. 邀请成员（仅租户管理员，且需先有当前租户）。 *@
        <PermissionView Code="tenant.invite">
            <div class="mt-section @(_expanded == "invite" ? "expanded" : "") @(_currentTenant is null ? "disabled" : "")">
                <BitButton Variant="BitVariant.Text" FullWidth Class="mt-section-header" IsEnabled="@(_currentTenant is not null)"
                           OnClick="ToggleInvite">
                    <AppIcon Name="People" />
                    <span class="mt-section-title">@InviteSectionTitle</span>
                    <AppIcon Name="ChevronDown" Class="mt-chevron" />
                </BitButton>
                @if (_expanded == "invite" && _currentTenant is not null)
                {
                    <div class="mt-section-body">
                        <p class="muted">@L.GetString("platform.tenants.inviteDesc", string.IsNullOrWhiteSpace(_currentTenant.Title) ? _currentTenant.Name : _currentTenant.Title)</p>
                        <div class="mt-form">
                            <BitTextField Label="@L["platform.tenants.field.memberEmail"]" @bind-Value="_inviteEmail"
                                          Type="BitInputType.Email" Placeholder="member@example.com" />
                            <BitTextField Label="手机号（邮箱与手机号二选一）" @bind-Value="_invitePhone"
                                          Placeholder="13800138000 / +8613800138000" />
                        </div>
                        <BitButton Color="BitColor.Primary" Disabled="@_busy" IsLoading="@_busy" OnClick="InviteAsync">
                            @L["platform.tenants.sendInvite"]
                        </BitButton>
                        @if (_members.Count > 0)
                        {
                            <div style="margin-top:16px">
                                <BitText Typography="BitTypography.Subtitle2" Style="margin-bottom:8px;display:block">当前租户成员（@_members.Count）</BitText>
                                <BitDataGrid TItem="TenantMemberDto" Items="_members" Bordered="true" Hoverable="true" Striped="true" Strings="@L.CreateGridStrings()">
                                    <Columns>
                                        <BitDataGridColumn TItem="TenantMemberDto" Field="DisplayName" Title="成员">
                                            <Template Context="m">
                                                <strong>@m.DisplayName</strong>
                                                <span class="muted" style="margin-left:6px">(@m.UserName)</span>
                                                @if (m.IsOwner)
                                                {
                                                    <BitTag Variant="BitVariant.Outline" Color="BitColor.Info" Style="margin-left:6px" Text="所有者" />
                                                }
                                                @if (!m.Accepted)
                                                {
                                                    <BitTag Variant="BitVariant.Outline" Color="BitColor.Warning" Style="margin-left:6px" Text="待接受" />
                                                }
                                            </Template>
                                        </BitDataGridColumn>
                                        <BitDataGridColumn TItem="TenantMemberDto" Field="Email" Title="联系方式">
                                            <Template Context="m">@(!string.IsNullOrWhiteSpace(m.Email) ? m.Email : (m.PhoneNumber ?? "—"))</Template>
                                        </BitDataGridColumn>
                                        <BitDataGridColumn TItem="TenantMemberDto" Title="操作">
                                            <Template Context="m">
                                                @if (m.UserId != Account.CurrentUser?.Id && !(m.IsOwner && _members.Count(x => x.IsOwner) <= 1))
                                                {
                                                    <BitButton Color="BitColor.Error" Variant="BitVariant.Text" IconName="@BitIconName.Leave"
                                                               Disabled="@_busy" OnClick="() => RemoveMemberAsync(m)">
                                                        移出
                                                    </BitButton>
                                                }
                                            </Template>
                                        </BitDataGridColumn>
                                    </Columns>
                                </BitDataGrid>
                            </div>
                        }
                    </div>
                }
            </div>
        </PermissionView>

        @* 3. 编辑当前租户（仅租户管理员，且需先有当前租户）。 *@
        <PermissionView Code="tenant.update">
            <div class="mt-section @(_expanded == "update" ? "expanded" : "") @(_currentTenant is null ? "disabled" : "")">
                <BitButton Variant="BitVariant.Text" FullWidth Class="mt-section-header" IsEnabled="@(_currentTenant is not null)"
                           OnClick="ToggleUpdate">
                    <AppIcon Name="Edit" />
                    <span class="mt-section-title">@L["platform.tenants.editCurrentTitle"]</span>
                    <AppIcon Name="ChevronDown" Class="mt-chevron" />
                </BitButton>
                @if (_expanded == "update" && _currentTenant is not null)
                {
                    <div class="mt-section-body">
                        <div class="mt-form">
                            <BitTextField Label="@L["platform.tenants.field.nameRequired"]" @bind-Value="_editName"
                                          Placeholder="@L["platform.tenants.field.namePlaceholder"]" />
                            <BitTextField Label="@L["platform.tenants.field.title"]" @bind-Value="_editTitle"
                                          Placeholder="@L["platform.tenants.field.titlePlaceholder"]" />
                            <BitTextField Label="@L["platform.tenants.field.domain"]" @bind-Value="_editDomain"
                                          Placeholder="tenant.example.com" />
                        </div>
                        <BitButton Color="BitColor.Primary" Disabled="@_busy" OnClick="UpdateAsync">
                            @L["platform.common.save"]
                        </BitButton>
                    </div>
                }
            </div>
        </PermissionView>
    </div>

    @* 租户卡片列表 *@
    <div class="tenant-cards">
        @if (_tenants.Count == 0)
        {
            <div class="tenant-empty">
                <AppIcon Name="Org" Class="tenant-empty-icon" />
                <p>@L["platform.tenants.empty"]</p>
            </div>
        }
        else
        {
            @foreach (var tenant in _tenants)
            {
                <div class="tenant-card" @key="tenant.Id">
                    <div class="tenant-card-main">
                        <span class="tenant-card-icon @(IsCurrent(tenant) ? "current" : (!tenant.Accepted ? "pending" : ""))">
                            <AppIcon Name="@(IsCurrent(tenant) ? "Check" : (!tenant.Accepted ? "Mail" : "Org"))" />
                        </span>
                        <div class="tenant-card-info">
                            <span class="tenant-card-title">@(string.IsNullOrWhiteSpace(tenant.Title) ? tenant.Name : tenant.Title)</span>
                            <span class="tenant-card-name">@tenant.Name</span>
                            @if (!string.IsNullOrWhiteSpace(tenant.Domain))
                            {
                                <span class="tenant-card-domain">@tenant.Domain</span>
                            }
                        </div>
                        <BitTag Variant="BitVariant.Outline"
                                Style="flex-shrink:0"
                                Color="@(tenant.IsActive ? BitColor.Success : BitColor.Error)"
                                Text="@(tenant.IsActive ? L["platform.tenants.active"] : L["platform.tenants.inactive"])" />
                    </div>
                    <div class="tenant-card-actions">
                        @if (!IsCurrent(tenant))
                        {
                            <BitButton Variant="BitVariant.Outline"
                                       IconName="@(tenant.Accepted ? BitIconName.Switch : BitIconName.Accept)"
                                       IsLoading="_busy"
                                       OnClick="() => SwitchOrAcceptAsync(tenant)">
                                @(tenant.Accepted ? L["platform.tenants.switch"] : L["platform.tenants.acceptInvite"])
                            </BitButton>
                        }
                        <BitButton Color="BitColor.Error"
                                   Variant="BitVariant.Text"
                                   IconName="@BitIconName.Leave"
                                   IsLoading="_busy"
                                   OnClick="() => AskLeave(tenant)">
                            @(tenant.Accepted ? L["platform.tenants.leave"] : L["platform.tenants.declineInvite"])
                        </BitButton>
                    </div>
                </div>
            }
        }
    </div>
}

@* 离开 / 拒绝邀请确认框 *@
<BlazorBoilerplateModal @bind-IsOpen="_confirmLeaveOpen"
                        Title="@(_leavingTenant is not null && !_leavingTenant.Accepted ? L["platform.tenants.declineInvite"] : L["platform.tenants.leaveTitle"])"
                        OkText="@(_leavingTenant is not null && !_leavingTenant.Accepted ? L["platform.tenants.declineInvite"] : L["platform.tenants.leave"])"
                        Danger ShowCancel="true" OnOk="ConfirmLeaveAsync">
    <p class="muted">
        @if (_leavingTenant is not null && !_leavingTenant.Accepted)
        {
            @L.GetString("platform.tenants.confirmDecline", string.IsNullOrWhiteSpace(_leavingTenant.Title) ? _leavingTenant.Name : _leavingTenant.Title)
        }
        else if (_leavingTenant is not null)
        {
            @L.GetString("platform.tenants.confirmLeave", string.IsNullOrWhiteSpace(_leavingTenant.Title) ? _leavingTenant.Name : _leavingTenant.Title)
        }
    </p>
</BlazorBoilerplateModal>

@* 管理员：管理所有租户 *@
<PermissionView Code="tenant.manage.global">
    @if (_isAdmin)
    {
        <div class="admin-tenants-section">
            <div class="admin-section-head">
                <BitText Typography="BitTypography.H5">@L["platform.tenants.adminTitle"]</BitText>
                <div class="admin-tenant-actions">
                    <BitTextField @bind-Value="_adminSearch" Placeholder="搜索租户名称/标题/域名" />
                    <BitButton Variant="BitVariant.Outline" OnClick="SearchAllAsync">搜索</BitButton>
                    <BitButton IconPlacement="BitPlacement.End" IconName="@BitIconName.Add" OnClick="OpenAdminCreate">@L["platform.tenants.addTenant"]</BitButton>
                </div>
            </div>

            <BitDataGrid TItem="TenantDto" Items="_allTenants" Bordered="true" Hoverable="true" Striped="true" Strings="@L.CreateGridStrings()">
                <Columns>
                    <BitDataGridColumn TItem="TenantDto" Field="Name" Title="@L["platform.tenants.field.name"]">
                        <Template Context="t"><strong>@t.Name</strong></Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="TenantDto" Field="Title" Title="@L["platform.tenants.field.title"]">
                        <Template Context="t">@(string.IsNullOrWhiteSpace(t.Title) ? "—" : t.Title)</Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="TenantDto" Field="Domain" Title="@L["platform.tenants.field.domain"]">
                        <Template Context="t">@(string.IsNullOrWhiteSpace(t.Domain) ? "—" : t.Domain)</Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="TenantDto" Title="@L["platform.tenants.active"]">
                        <Template Context="t">
                            <div class="admin-tenant-actions">
                                <BitToggle Value="t.IsActive"
                                           AriaLabel="@L["platform.tenants.active"]"
                                           OnChange="@(async (bool _) => await ToggleActiveAsync(t))" />
                                <PermissionView Code="tenant.update">
                                    <BitButton Variant="BitVariant.Text"
                                               IconName="@BitIconName.Edit"
                                               Title="@L["platform.common.edit"]"
                                               AriaLabel="@L["platform.common.edit"]"
                                               OnClick="() => OpenAdminEdit(t)" />
                                </PermissionView>
                            </div>
                        </Template>
                    </BitDataGridColumn>
                </Columns>
                <EmptyTemplate>
                    <BitText Class="muted">@L["platform.tenants.adminEmpty"]</BitText>
                </EmptyTemplate>
            </BitDataGrid>
            <div class="admin-tenant-actions" style="margin-top:12px;justify-content:flex-end">
                <BitText Class="muted">共 @_adminTotalCount 条 · 第 @(_adminPage + 1) 页</BitText>
                <BitButton Variant="BitVariant.Outline" IsEnabled="@(_adminPage > 0)" OnClick="PrevAdminPageAsync">上一页</BitButton>
                <BitButton Variant="BitVariant.Outline" IsEnabled="@((_adminPage + 1) * _adminPageSize < _adminTotalCount)" OnClick="NextAdminPageAsync">下一页</BitButton>
            </div>
        </div>
    }
</PermissionView>
</div>
</section>

@* 管理员新增 / 编辑租户 *@
<BlazorBoilerplateModal @bind-IsOpen="_adminEditOpen"
                        Title="@(_adminEditing is null ? L["platform.tenants.addTenant"] : L["platform.tenants.editTenant"])" OkText="@L["platform.common.save"]" OnOk="SaveAdminEditAsync">
    <div class="id-form">
        <BitTextField Label="@L["platform.tenants.field.nameRequired"]" @bind-Value="_adminName"
                      Placeholder="@L["platform.tenants.field.namePlaceholder"]" />
        <BitTextField Label="@L["platform.tenants.field.title"]" @bind-Value="_adminTitle"
                      Placeholder="@L["platform.tenants.field.titlePlaceholder"]" />
        <BitTextField Label="@L["platform.tenants.field.domain"]" @bind-Value="_adminDomain"
                      Placeholder="tenant.example.com" />
        <BitCheckbox @bind-Value="_adminActive" Label="@L["platform.tenants.active"]" />
    </div>
</BlazorBoilerplateModal>

@* 高权限二次验证（ELEVATED_ACCESS） *@
<BlazorBoilerplateModal @bind-IsOpen="_elevateOpen"
                        Title="高权限二次验证"
                        OkText="验证并继续"
                        ShowCancel="true"
                        OnOk="ConfirmElevatedAccessAsync">
    <div class="id-form">
        <p class="muted">此操作涉及敏感租户权限，请输入当前登录密码以确认身份（15 分钟内有效）。</p>
        <BitTextField Label="当前密码" Type="BitInputType.Password" @bind-Value="_elevatePassword" />
    </div>
</BlazorBoilerplateModal>

