@page "/"
@namespace BlazorBoilerplate.WebHost.Components.Pages

@if (_domainComponentType is not null)
{
    <DynamicComponent Type="@_domainComponentType" />
}
else
{
<section>
    <WidgetZone Name="home_widgets_top" />

    <div class="bb-stat-row">
        <DashboardStatCard Icon="Info" Value="@(_status?.Mode ?? "—")" Label="@L["platform.home.stat.mode"]" />
        <DashboardStatCard Icon="Puzzle" Value="@_moduleCount.ToString()" Label="@L["platform.home.stat.modules"]" />
        <WidgetZone Name="home_stats" />
    </div>

    <div class="bb-widgets">
        <WidgetZone Name="home_widgets" />

        <PermissionView Code="system.settings.read">
            <DashboardWidgetCard Title="@L["platform.home.widget.recentActivity"]" Span="3">
                @if (_activities.Count == 0)
                {
                    <BitText Class="muted">@L["platform.common.empty"]</BitText>
                }
                else
                {
                    <ul class="bb-activity">
                        @foreach (var a in _activities)
                        {
                            <li>
                                <span class="bb-dot"></span>
                                <span>@a.Comment</span>
                                <time>@a.CreatedAtUtc.ToLocalTime().ToString("MM-dd HH:mm")</time>
                            </li>
                        }
                    </ul>
                }
            </DashboardWidgetCard>
        </PermissionView>

        <DashboardWidgetCard Title="@L["platform.home.widget.quickLinks"]" Subtitle="@L["platform.home.widget.platformFeatures"]" Span="3">
            <div class="bb-quick">
                @foreach (var link in _quickLinks)
                {
                    <a href="@link.Path">
                        <AppIcon Name="@(string.IsNullOrWhiteSpace(link.Icon) ? "Grid" : link.Icon!)" />
                        <span>@link.Name</span>
                    </a>
                }
            </div>
        </DashboardWidgetCard>

        <DashboardWidgetCard Title="@L.GetString("platform.home.aboutTitle", SysState.Public.SystemName)"
                             Subtitle="@SysState.Public.FooterText"
                             Span="6">
            <p class="muted">@L["platform.home.aboutDesc"]</p>
            <div class="row">
                <BitLink Href="/modules">@L["platform.home.openModules"] →</BitLink>
            </div>
        </DashboardWidgetCard>
    </div>

    <WidgetZone Name="home_widgets_bottom" />
</section>
}
