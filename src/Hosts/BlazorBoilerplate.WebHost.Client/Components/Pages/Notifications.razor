@page "/notifications"
@namespace BlazorBoilerplate.WebHost.Components.Pages

<BitCallout Class="page-callout">
    <BitText Element="h1" Class="page-title">@L["platform.header.notifications.title"]</BitText>
    <BitText Class="muted">@L["platform.notifications.subtitle"]</BitText>
</BitCallout>

<div class="bb-toolbar">
    <span class="muted">@L.GetString("platform.notifications.summary", _notifications.Count, UnreadCount)</span>
    <div class="bb-spacer"></div>
    <BitButton Variant="BitVariant.Outline" OnClick="MarkAllReadAsync" Disabled="@(UnreadCount == 0)">@L["platform.notifications.markAllRead"]</BitButton>
    <PermissionView Code="notification.send-test">
        <BitButton Color="BitColor.Primary" OnClick="OpenEmailModal" IsLoading="@_sendingEmail">
            @L["platform.notifications.sendTestEmail"]
        </BitButton>
        @if (_notificationsEnabled)
        {
            <BitButton Color="BitColor.Primary" OnClick="SendTestAsync" IsLoading="@_sending">
                @L["platform.notifications.sendTest"]
            </BitButton>
        }
        else
        {
            <BitButton Color="BitColor.Primary" Disabled Title="@L["platform.notifications.enableHint"]">@L["platform.notifications.sendTest"]</BitButton>
        }
    </PermissionView>
    <BitButton Variant="BitVariant.Outline" OnClick="LoadAsync">@L["platform.common.refresh"]</BitButton>
</div>

@if (!_notificationsEnabled)
{
    <BitCallout Class="page-callout success">@L["platform.notifications.disabledBanner"]</BitCallout>
}

<div class="notif-list">
    @if (_notifications.Count == 0)
    {
        <div class="notif-empty">@L["platform.notifications.empty"]</div>
    }
    @foreach (var n in _notifications)
    {
        <article class="notif-item @(n.IsRead ? "" : "unread")">
            <span class="notif-dot"></span>
            <div class="notif-body">
                <div class="notif-head">
                    <strong class="notif-title">@n.Title</strong>
                    <time class="notif-time">@n.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time>
                </div>
                <p class="notif-message">@n.Message</p>
                <div class="notif-foot">
                    @if (!string.IsNullOrWhiteSpace(n.PageUrl))
                    {
                        <BitLink Href="@n.PageUrl">@L["platform.notifications.viewDetails"]</BitLink>
                    }
                    @if (!n.IsRead)
                    {
                        <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => MarkReadAsync(n)"
                                   Disabled="@_marking.Contains(n.Id)">@L["platform.notifications.markRead"]</BitButton>
                    }
                    else
                    {
                        <span class="muted">@L["platform.notifications.read"]</span>
                    }
                </div>
            </div>
        </article>
    }
</div>

<BlazorBoilerplateModal @bind-IsOpen="_emailModalOpen"
                        Title="@L["platform.notifications.emailModalTitle"]"
                        OkText="@L["platform.notifications.sendEmailOk"]"
                        OnOk="SendTestEmailAsync">
    <div class="id-form">
        <BitTextField Label="@L["platform.notifications.emailTo"]" @bind-Value="_emailTo"
                      Type="BitInputType.Email" Placeholder="761516331@qq.com" />
        <BitTextField Label="@L["platform.notifications.emailSubject"]" @bind-Value="_emailSubject"
                      Placeholder="@L["platform.notifications.defaultEmailSubject"]" />
        <BitTextField Label="@L["platform.notifications.emailBody"]" @bind-Value="_emailBody"
                      Multiline Rows="4" Placeholder="@L["platform.notifications.emailBodyPlaceholder"]" />
    </div>
</BlazorBoilerplateModal>

