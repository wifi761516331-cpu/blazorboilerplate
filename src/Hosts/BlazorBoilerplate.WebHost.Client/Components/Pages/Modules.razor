@page "/modules"
@namespace BlazorBoilerplate.WebHost.Components.Pages

<BitCallout Class="page-callout">
    <BitText Element="h1" Class="page-title">@L["platform.header.modules.title"]</BitText>
    <BitText Class="muted">@L["platform.modules.subtitle"]</BitText>
</BitCallout>

@if (_loadError is not null)
{
    <BitCallout Class="page-callout error">@L.GetString("platform.modules.error.apiHost", _loadError)</BitCallout>
}
else if (_loading)
{
    <BitText Class="muted">@L["platform.common.loading"]</BitText>
}
else
{
    @* Bluebird ProductsPage 风格工具栏 + Dashboard 卡片网格 *@
    <div class="bb-toolbar">
        <div class="bb-search">
            <BitSearchBox @bind-Value="_search" Immediate DebounceTime="300" Placeholder="@L["platform.modules.searchPlaceholder"]" />
        </div>
        <div class="bb-spacer"></div>
        <PermissionView Code="module.upload">
            <BitButton Color="BitColor.Primary" IconName="@BitIconName.CloudUpload" OnClick="@(() => _uploadOpen = true)">@L["platform.modules.upload"]</BitButton>
        </PermissionView>
        @if (_packEnabled)
        {
            <PermissionView Code="module.pack">
                <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Package" OnClick="@(() => _packOpen = true)">@L["platform.modules.pack"]</BitButton>
            </PermissionView>
        }
        <PermissionView Code="module.load">
            <BitButton Color="BitColor.Primary" OnClick="LoadAllAsync" Disabled="@_loadAllBusy">
                @(_loadAllBusy ? L["platform.modules.loadingAll"] : L["platform.modules.loadAll"])
            </BitButton>
        </PermissionView>
        <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="RefreshAsync" IsLoading="@_refreshing" Disabled="@_refreshing">@L["platform.common.refresh"]</BitButton>
    </div>

    <div class="module-summary">
<div class="module-summary-item module-kpi-item">
            <div class="module-kpi-meta">
                <span class="module-summary-label">@L["platform.modules.stat.total"]</span>
                <strong>@_modules.Count</strong>
            </div>
            <span class="module-kpi-icon is-total" aria-hidden="true">
                <AppIcon Name="Puzzle" />
            </span>
        </div>
        <div class="module-summary-item module-kpi-item">
            <div class="module-kpi-meta">
                <span class="module-summary-label">@L["platform.modules.stat.running"]</span>
                <strong class="ok">@RunningCount</strong>
            </div>
            <span class="module-kpi-icon is-running" aria-hidden="true">
                <BitIcon IconName="@BitIconName.CompletedSolid" />
            </span>
        </div>
        <div class="module-summary-item module-kpi-item">
            <div class="module-kpi-meta">
                <span class="module-summary-label">@L["platform.modules.stat.essential"]</span>
                <strong>@EssentialCount</strong>
            </div>
            <span class="module-kpi-icon is-essential" aria-hidden="true">
                <AppIcon Name="Shield" />
            </span>
        </div>
        <div class="module-summary-item module-kpi-item">
            <div class="module-kpi-meta">
                <span class="module-summary-label">@L["platform.modules.stat.pending"]</span>
                <strong class="warn">@(_modules.Count - RunningCount)</strong>
            </div>
            <span class="module-kpi-icon is-pending" aria-hidden="true">
                <BitIcon IconName="@BitIconName.Warning" />
            </span>
        </div>
    </div>

    @if (!FilteredModules.Any())
    {
        <div class="module-empty">
            <AppIcon Name="Puzzle" />
            <span>@L["platform.modules.empty"]</span>
        </div>
    }
    else
    {
        <div class="module-grid">
            @foreach (var m in FilteredModules)
            {
                <article class="module-card @CardClass(m)">
                    <div class="module-card-head" style="flex-wrap:wrap">
                        <span class="module-card-icon"><AppIcon Name="@ModuleIcon(m.Id)" /></span>
                        <div class="module-card-heading" style="min-width:96px">
                            <strong class="module-card-title">@m.DisplayTitle</strong>
                            <span class="module-card-id">@m.Id · @m.Name</span>
                        </div>
@*                         @if (m.VersionCount > 1 && _versionItems.TryGetValue(m.Id, out var versionItems))
                        {
                            <BitDropdown TItem="BitDropdownItem<string>" TValue="string"
                                         Class="module-version-select" Title="选择运行版本"
                                         Items="@versionItems" Value="@m.Version"
                                         OnChange="@(v => SwitchCardVersionAsync(m.Id, v))" />
                        } *@
                      @*   else
                        { *@
                            <span class="module-version-badge" title="@L["platform.modules.activeVersionTitle"]">v@(m.Version)</span>
                       @*  } *@
                        <BitTag Color="@StateColor(m.State)"
                                Variant="BitVariant.Outline"
                                Size="BitSize.Small"
                                IconName="@StateIcon(m.State)"
                                Style="white-space:nowrap;flex-shrink:0"
                                Title="@m.State.ToString()">@StateText(m.State)</BitTag>
                    </div>

                    <div class="module-card-meta">
                        <span>@m.Publisher</span>
                        <span class="dot-sep"></span>
                        <span>@L.GetString("platform.modules.versionCount", m.VersionCount)</span>
                    </div>

                    <div class="module-card-tags">
                        <span class="module-chip">@L.GetString("platform.modules.loadOrder", m.Order)</span>
                        @if (m.IsEssential)
                        {
                            <span class="module-chip warn">@L["platform.modules.essentialChip"]</span>
                        }
                        @if (m.Permissions.Length == 0)
                        {
                            <span class="module-chip muted">@L["platform.modules.noPermissions"]</span>
                        }
                        else
                        {
                            @foreach (var p in m.Permissions)
                            {
                                <span class="module-chip info">@p</span>
                            }
                        }
                    </div>

                    <div class="module-card-foot">
                        @if (m.State == ModuleState.Running)
                        {
                            @if (m.IsEssential)
                            {
                                <span class="module-protected" title="@L["platform.modules.essentialProtected"]"><AppIcon Name="Shield" /></span>
                            }
                            else
                            {
                                <PermissionView Code="module.unload">
                                    <BitButton Color="BitColor.Error" Variant="BitVariant.Text" IconName="@BitIconName.CircleStop"
                                               Title="@L["platform.modules.unload"]" AriaLabel="@L["platform.modules.unload"]"
                                               OnClick="@(() => UnloadAsync(m.Id))" Disabled="@_busy.Contains(m.Id)" />
                                </PermissionView>
                            }
                        }
                        else if (m.State is ModuleState.Installed or ModuleState.Disabled or ModuleState.Uninstalled)
                        {
                            <PermissionView Code="module.load">
                                <BitButton Color="BitColor.Primary" Variant="BitVariant.Text" IconName="@BitIconName.Play"
                                           Title="@L["platform.modules.load"]" AriaLabel="@L["platform.modules.load"]"
                                           OnClick="@(() => LoadAsync(m.Id))" Disabled="@_busy.Contains(m.Id)" />
                            </PermissionView>
                        }
                        else
                        {
                            <span class="muted">@L.GetString("platform.modules.stateUnavailable", m.State)</span>
                        }
                        <BitButton Color="BitColor.Info" Variant="BitVariant.Text" IconName="@BitIconName.History"
                                   Title="@L["platform.modules.versionHistory"]"
                                   OnClick="@(() => OpenVersionsAsync(m))" AriaLabel="@L["platform.modules.versionHistory"]" />
                        <PermissionView Code="module.download">
                            <BitButton Color="BitColor.Info" Variant="BitVariant.Text" IconName="@BitIconName.Download"
                                       Title="@L["platform.modules.downloadZipTitle"]" AriaLabel="@L["platform.modules.downloadLabel"]"
                                       OnClick="@(() => DownloadAsync(m))" Disabled="@_downloading.Contains(m.Id)" />
                        </PermissionView>
                        @if (!m.IsEssential && m.State != ModuleState.Uninstalled)
                        {
                            <PermissionView Code="module.unload">
                                <BitButton Color="BitColor.Error" Variant="BitVariant.Text" IconName="@BitIconName.Delete"
                                           Title="@L["platform.modules.uninstall"]" AriaLabel="@L["platform.modules.uninstall"]"
                                           OnClick="@(() => OpenUninstallConfirm(m))" Disabled="@_busy.Contains(m.Id)" />
                            </PermissionView>
                        }
                    </div>
                </article>
            }
        </div>
    }
}

@* 上传模块弹框：选择 .zip → ApiHost 归档至 S3/MinIO + 解压安装 *@
<BlazorBoilerplateModal @bind-IsOpen="_uploadOpen" Title="@L["platform.modules.upload"]"
                        OkText="@L["platform.modules.uploadAndInstall"]" Disabled="@(_uploadFile is null)"
                        OnOk="UploadAsyncAsync" CloseOnBackdrop="false">
    <div class="upload-drop">
        <InputFile OnChange="OnFileSelected" accept=".zip" class="upload-input" aria-label="@L["platform.modules.selectZipLabel"]" />
        <AppIcon Name="Upload" />
        <strong>@(_uploadHint ?? L["platform.modules.clickSelectZip"])</strong>
        <span class="muted">@L["platform.modules.uploadDesc"]</span>
    </div>
</BlazorBoilerplateModal>

@* 开发打包弹框：选源码工程 → dotnet build Release → 组包 → 自动上传安装或直接下载 .zip *@
<BlazorBoilerplateModal @bind-IsOpen="_packOpen" Title="@L["platform.modules.pack"]"
                        OkText="@(_packAutoInstall ? L["platform.modules.packAndInstall"] : L["platform.modules.packAndDownload"])"
                        Disabled="@(_packBusy || string.IsNullOrWhiteSpace(_packSource))"
                        OnOk="PackAndDownloadAsync" CloseOnBackdrop="false">
    <div class="id-form">
        @if (_packSources.Count == 0)
        {
            <BitText Class="muted">@L["platform.modules.noSourceProjects"]</BitText>
        }
        else
        {
            <BitDropdown Label="@L["platform.modules.sourceProjectLabel"]" @bind-Value="_packSource" Items="@_packSources" />
            <BitCheckbox Label="@L["platform.modules.packAutoInstall"]" @bind-Value="_packAutoInstall" />
        }
        <BitText Class="muted">@L["platform.modules.packDesc"]</BitText>
    </div>
</BlazorBoilerplateModal>

@* 版本历史弹框：列出全部版本，可切换激活版本 *@
<BlazorBoilerplateModal @bind-IsOpen="_versionsOpen" Title="@L.GetString("platform.modules.versionHistoryTitle", _versionsModuleName)"
                        OkText="@L["platform.common.close"]" ShowCancel="false">
    <div class="versions-list">
        @if (_versions.Count == 0)
        {
            <span class="muted">@L["platform.modules.loadingVersions"]</span>
        }
        else
        {
            @foreach (var v in _versions)
            {
                var busyKey = $"{_versionsModuleId}@{v.Version}";
                <div class="version-row @(v.IsActive ? "is-active" : "")">
                    <div class="version-info">
                        <strong>v@(v.Version)</strong>
                        @if (v.State == ModuleState.Running)
                        {
                            <span class="module-chip info">@L["platform.modules.currentRunning"]</span>
                        }
                        <span class="muted">@v.State</span>
                        @if (v.LoadedAtUtc is { } loaded)
                        {
                            <span class="muted">@L.GetString("platform.modules.loadedAt", loaded.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</span>
                        }
                        @if (v.Error is not null)
                        {
                            <span class="version-error">@v.Error</span>
                        }
                    </div>
                    @if (v.State is ModuleState.Installed or ModuleState.Uninstalled or ModuleState.Disabled)
                    {
                        <PermissionView Code="module.load">
                            <BitButton Color="BitColor.Primary" Variant="BitVariant.Outline"
                                       OnClick="@(() => SwitchVersionAsync(v.Version))"
                                       Disabled="@_versionBusy.Contains(busyKey)">
                                @(_versionBusy.Contains(busyKey) ? L["platform.modules.switching"] : L["platform.modules.switchToVersion"])
                            </BitButton>
                        </PermissionView>
                    }
                </div>
            }
        }
    </div>
</BlazorBoilerplateModal>

@* 彻底卸载确认弹框：触发模块清理钩子并删除本地安装包目录 *@
<BlazorBoilerplateModal @bind-IsOpen="_uninstallOpen" Title="@L["platform.modules.uninstallConfirmTitle"]"
                        OkText="@L["platform.modules.uninstallConfirmOk"]" Disabled="@_uninstallBusy"
                        OnOk="ConfirmUninstallAsync" CloseOnBackdrop="false">
    @if (_uninstallTarget is not null)
    {
        <BitText>@L.GetString("platform.modules.uninstallConfirmDesc", _uninstallTarget.Name, _uninstallTarget.Id)</BitText>
    }
</BlazorBoilerplateModal>

