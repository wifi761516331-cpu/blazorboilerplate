@page "/profile"
@namespace BlazorBoilerplate.WebHost.Components.Pages
@using BlazorBoilerplate.Shared.Features.Attachments
@using Microsoft.AspNetCore.Components.Forms

<BitCallout Class="page-callout">
    <BitText Element="h1" Class="page-title">@L["platform.header.profile.title"]</BitText>
    <BitText Class="muted">@L["platform.profile.subtitle"]</BitText>
</BitCallout>

<div class="account-page-grid">
    <section class="bb-card">
        <BitText Element="h2" Typography="BitTypography.H5" Class="section-title">@L["platform.profile.avatarTitle"]</BitText>
        <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap;">
            @if (_avatarUrl is not null)
            {
                <img src="@_avatarUrl" alt="@L["platform.profile.avatarAlt"]"
                     style="width:72px;height:72px;border-radius:50%;object-fit:cover;border:1px solid var(--bb-border);" />
            }
            else
            {
                <div style="width:72px;height:72px;border-radius:50%;display:grid;place-items:center;background:var(--bb-accent-soft, #e5eefc);font-weight:700;font-size:1.25rem;">
                    @(string.IsNullOrWhiteSpace(_displayName) ? "?" : _displayName[..1].ToUpperInvariant())
                </div>
            }
            <div style="display:flex;flex-direction:column;gap:.5rem;">
                <InputFile OnChange="UploadAvatarAsync" accept=".jpg,.jpeg,.png,.webp,.gif,.bmp" disabled="@_uploadingAvatar" />
                <div style="display:flex;gap:.5rem;align-items:center;">
                    <BitText Class="muted" Style="font-size:.85rem;">@L["platform.profile.avatarHint"]</BitText>
                    @if (_avatarUrl is not null)
                    {
                        <BitButton Variant="BitVariant.Text" Color="BitColor.Error" Size="BitSize.Small"
                                   OnClick="DeleteAvatarAsync" Disabled="@_uploadingAvatar">@L["platform.profile.removeAvatar"]</BitButton>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="bb-card">
        <BitText Element="h2" Typography="BitTypography.H5" Class="section-title">@L["platform.profile.basicInfo"]</BitText>
        <div class="id-form">
            <BitTextField Label="@L["platform.profile.displayName"]" @bind-Value="_displayName" />
            <BitTextField Label="@L["platform.profile.email"]" @bind-Value="_email" Type="BitInputType.Email" />
            <div class="bb-form-actions">
                <PermissionView Code="identity.user.update">
                    <BitButton Color="BitColor.Primary" OnClick="SaveProfileAsync" IsLoading="@_savingProfile">
                        @L["platform.profile.saveProfile"]
                    </BitButton>
                </PermissionView>
            </div>
        </div>
    </section>

    <section class="bb-card">
        <BitText Element="h2" Typography="BitTypography.H5" Class="section-title">@L["platform.profile.changePassword"]</BitText>
        <div class="id-form">
            <BitTextField Label="@L["platform.profile.oldPassword"]" @bind-Value="_oldPassword"
                          Type="BitInputType.Password" CanRevealPassword />
            <BitTextField Label="@L["platform.profile.newPassword"]" @bind-Value="_newPassword"
                          Type="BitInputType.Password" CanRevealPassword />
            <div class="bb-form-actions">
                <PermissionView Code="identity.user.change-password">
                    <BitButton Color="BitColor.Primary" OnClick="ChangePasswordAsync" IsLoading="@_savingPassword">
                        @L["platform.profile.changePassword"]
                    </BitButton>
                </PermissionView>
            </div>
        </div>
    </section>
</div>

<section class="bb-card">
    <div class="bb-card-head">
        <BitText Element="h2" Typography="BitTypography.H5" Class="section-title">@L["platform.profile.sessionsTitle"]</BitText>
        <BitButton Variant="BitVariant.Outline" OnClick="LoadSessionsAsync">@L["platform.common.refresh"]</BitButton>
    </div>
    <BitDataGrid TItem="UserSessionDto" Items="_sessions" Bordered="true" Hoverable="true" Striped="true" Strings="@L.CreateGridStrings()">
        <Columns>
            <BitDataGridColumn TItem="UserSessionDto" Field="DeviceInfo" Title="@L["platform.profile.col.device"]">
                <Template Context="s">@(string.IsNullOrWhiteSpace(s.DeviceInfo) ? "—" : s.DeviceInfo)</Template>
            </BitDataGridColumn>
            <BitDataGridColumn TItem="UserSessionDto" Field="IP" Title="IP">
                <Template Context="s">@(string.IsNullOrWhiteSpace(s.IP) ? "—" : s.IP)</Template>
            </BitDataGridColumn>
            <BitDataGridColumn TItem="UserSessionDto" Field="TimeZone" Title="@L["platform.accountMenu.timeZone"]">
                <Template Context="s">@(string.IsNullOrWhiteSpace(s.TimeZone) ? "—" : s.TimeZone)</Template>
            </BitDataGridColumn>
            <BitDataGridColumn TItem="UserSessionDto" Field="StartedOnUtc" Title="@L["platform.profile.col.startedAt"]">
                <Template Context="s">@s.StartedOnUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</Template>
            </BitDataGridColumn>
            <BitDataGridColumn TItem="UserSessionDto" Title="@L["platform.profile.col.status"]">
                <Template Context="s">
                    @if (s.Current)
                    {
                        <BitTag Size="BitSize.Small" Color="BitColor.Info">@L["platform.profile.currentSession"]</BitTag>
                    }
                    else
                    {
                        <BitText Class="muted">@L["platform.profile.otherDevice"]</BitText>
                    }
                </Template>
            </BitDataGridColumn>
            <BitDataGridColumn TItem="UserSessionDto" Title="">
                <Template Context="s">
                    <PermissionView Code="identity.user.revoke-session">
                        <BitButton Variant="BitVariant.Text" Color="BitColor.Error" Size="BitSize.Small"
                                   OnClick="() => RevokeAsync(s)" Disabled="@(s.Current || _revoking.Contains(s.Id))">
                            @(_revoking.Contains(s.Id) ? L["platform.profile.revoking"] : L["platform.profile.revoke"])
                        </BitButton>
                    </PermissionView>
                </Template>
            </BitDataGridColumn>
        </Columns>
        <EmptyTemplate>
            <BitText Class="muted">@L["platform.profile.sessionsEmpty"]</BitText>
        </EmptyTemplate>
    </BitDataGrid>
</section>
