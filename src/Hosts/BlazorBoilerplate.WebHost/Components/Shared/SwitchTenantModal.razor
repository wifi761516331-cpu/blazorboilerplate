@* 切换租户弹框：对齐 Bluebird 的「切换租户」模态（标题 + 返回箭头、租户列表、底部「管理我的租户」入口）。
   数据来自 AccountState / GetTenantsAsync；切换经由 app.js 的 blazorAuth.switchTenant；
   「管理我的租户」跳转 /tenants。显隐完全由 @bind-IsOpen 参数驱动：Blazor 子组件的渲染
   由参数变化触发，外部直接调用方法修改子组件私有字段不会引起重渲染（弹框将永远不显示）。 *@
@inject NavigationManager Navigation
@inject ToastService Toast
@inject BlazorBoilerplateApiClient Api
@inject AccountState Account
@inject IJSRuntime JS

<div class="switch-tenant-root">
    <button type="button" class="switch-tenant-backdrop" hidden="@(!IsOpen)" aria-label="关闭切换租户" @onclick="CloseAsync"></button>

    <div class="switch-tenant-modal" hidden="@(!IsOpen)" role="dialog" aria-modal="true" aria-label="切换租户">
        <header class="switch-tenant-header">
            <button type="button" class="switch-tenant-back" title="返回" aria-label="返回" @onclick="CloseAsync">
                <AppIcon Name="ChevronLeft" />
            </button>
            <span class="switch-tenant-title">切换租户</span>
        </header>

        <div class="switch-tenant-body">
            @if (_loading)
            {
                <div class="switch-tenant-empty">加载中…</div>
            }
            else if (_tenants.Count == 0)
            {
                <div class="switch-tenant-empty">暂无可以切换的租户</div>
            }
            else
            {
                @foreach (var tenant in _tenants)
                {
                    <button type="button" class="switch-tenant-item @(IsCurrent(tenant) ? "selected" : "")"
                            @onclick="() => SelectAsync(tenant)" disabled="@(_busy || IsCurrent(tenant))">
                        <AppIcon Name="@(tenant.Accepted ? "Org" : "Mail")"
                                  Class="@(tenant.Accepted ? "" : "pending")" />
                        <span class="switch-tenant-name">@(string.IsNullOrWhiteSpace(tenant.Title) ? tenant.Name : tenant.Title)</span>
                        @if (!tenant.Accepted)
                        {
                            <small class="pending-badge">待接受邀请</small>
                        }
                        else if (IsCurrent(tenant))
                        {
                            <AppIcon Name="Check" Class="current" />
                        }
                    </button>
                }
            }
        </div>

        <button type="button" class="switch-tenant-manage" @onclick="ManageTenants">
            <AppIcon Name="Settings" />
            <span>管理我的租户</span>
        </button>
    </div>
</div>

@code {
    /// <summary>显隐由父组件（AccountMenu）双向绑定：true 时加载数据并显示。</summary>
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }

    private bool _lastOpen;
    private bool _loading;
    private bool _busy;
    private List<TenantDto> _tenants = [];

    /// <summary>IsOpen 由 false 变 true 时加载当前用户的租户列表（含受邀未接受的）。</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_lastOpen)
        {
            _loading = true;
            try
            {
                await Account.EnsureLoadedAsync();
                _tenants = (await Api.GetTenantsAsync()).ToList();
            }
            catch (Exception ex)
            {
                _tenants = [];
                Toast.Error($"读取租户列表失败：{ex.Message}");
            }
            finally
            {
                _loading = false;
            }
        }
        _lastOpen = IsOpen;
    }

    private Task CloseAsync() => IsOpenChanged.InvokeAsync(false);

    private bool IsCurrent(TenantDto tenant) =>
        tenant.Current || Account.CurrentUser?.TenantId == tenant.Id;

    private async Task SelectAsync(TenantDto tenant)
    {
        if (IsCurrent(tenant) || _busy) return;
        _busy = true;
        try
        {
            var result = await JS.InvokeAsync<JsonElement>("blazorAuth.switchTenant", tenant.Id.ToString());
            if (!Ok(result))
            {
                Toast.Error(Err(result) ?? "切换租户失败。");
                return;
            }
            Toast.Success($"正在切换到租户「{tenant.Name}」…");
            await CloseAsync();
            await Redirect("/");
        }
        catch (Exception ex)
        {
            Toast.Error($"切换租户失败：{ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ManageTenants()
    {
        await CloseAsync();
        Navigation.NavigateTo("/tenants");
    }

    private async Task Redirect(string url)
    {
        try { await JS.InvokeVoidAsync("blazorAuth.redirect", url); }
        catch { /* 整页跳转会销毁 JS 上下文，忽略跳转引发的 interop 异常 */ }
    }

    private static bool Ok(JsonElement el) =>
        el.ValueKind == JsonValueKind.Object &&
        el.TryGetProperty("ok", out var v) && v.ValueKind == JsonValueKind.True;

    private static string? Err(JsonElement el) =>
        el.ValueKind == JsonValueKind.Object &&
        el.TryGetProperty("error", out var v) && v.ValueKind == JsonValueKind.String
            ? v.GetString() : null;
}
