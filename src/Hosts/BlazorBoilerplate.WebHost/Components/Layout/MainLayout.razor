@* 布局移植自 Bluebird / bitplatform Boilerplate 的 AppShell：
   280px 侧边栏 + sticky 顶栏（标题/副标题/账号区）+ 内容区 + 移动端底部导航。
   Bit.BlazorUI 10.7.0 没有 11.x 的 BitAppShell / BitNavPanel，故用原生 HTML + CSS 复刻。
   注意：/setup 与 /sign-in 使用独立的 IdentityLayout，不经过本布局，
   因此这里不再有任何 identity 分支判断（此前双栏插画是挂在本布局上的）。 *@
@inherits LayoutComponentBase
@implements IDisposable
@* 注入与布局/导航/守卫逻辑在 MainLayout.razor.cs；RenderNavNode 因含 Razor 标记语法留在本文件。 *@

<div class="app-shell @(_dark ? "bb-dark" : "") @(_navToggled ? "nav-toggled" : "") @(_navOpen ? "nav-open" : "")"
     bit-theme="@(_dark ? "dark" : "light")"
     data-accent="@_accent" style="@AccentStyle">
    <main class="app-main-frame">
        <div class="main-container">
            <aside class="nav-panel">
                <div class="nav-brand">
                    <span class="nav-brand-mark">L</span>
                    <span class="nav-brand-name">@SysState.Public.SystemName</span>
                </div>
                <nav class="nav-scroll">
                    @foreach (var node in _navTree)
                    {
                        @RenderNavNode(node)
                    }
                </nav>
                <div class="nav-signin">
                    @if (Account.IsAuthenticated)
                    {
                        var tenantLabel = !string.IsNullOrWhiteSpace(Account.CurrentUser?.TenantName)
                            ? Account.CurrentUser!.TenantName
                            : L["platform.nav.myTenant"];
                        <a href="/tenants" class="nav-item @NavClass("/tenants")" title="@L["platform.nav.manageTenant"]" @onclick="CloseNav">
                            <AppIcon Name="Org" />
                            <span class="nav-text">@tenantLabel</span>
                        </a>
                    }
                    else
                    {
                        var returnUrl = Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
                        <a href="@($"/sign-in?return-url={returnUrl}")" class="nav-item" title="@L["platform.auth.signIn"]" @onclick="CloseNav">
                            <AppIcon Name="Signin" />
                            <span class="nav-text">@L["platform.auth.signIn"]</span>
                        </a>
                        <a href="@($"/sign-up?return-url={returnUrl}")" class="nav-item" title="@L["platform.auth.signUp"]" @onclick="CloseNav">
                            <AppIcon Name="AddFriend" />
                            <span class="nav-text">@L["platform.auth.signUp"]</span>
                        </a>
                    }
                </div>
                <div class="nav-foot">@SysState.Public.FooterText</div>
            </aside>

            <div class="main-body">
                <header class="app-header">
                    <BitButton Variant="BitVariant.Text" Class="icon-btn menu-btn" Title="@L["platform.nav.open"]" OnClick="OpenNav">
                        <AppIcon Name="CollapseMenu" />
                    </BitButton>
                    <BitButton Variant="BitVariant.Text" Class="icon-btn toggle-btn" Title="@L["platform.nav.toggleSidebar"]" OnClick="() => _navToggled = !_navToggled">
                        <AppIcon Name="CollapseMenu" />
                    </BitButton>
                    <div class="header-titles">
                        <h1 class="header-title">@HeaderTitle</h1>
                        @if (!string.IsNullOrWhiteSpace(HeaderSubtitle))
                        {
                            <span class="header-sub">@HeaderSubtitle</span>
                        }
                    </div>
                    <div class="header-spacer"></div>
                    <div class="header-actions">
                        <WidgetZone Name="header_actions" />
                        @* 通知铃铛：未读数来自 GetUnreadCountAsync，失败隐藏徽标 *@
                        <a href="/notifications" class="icon-btn header-bell" title="@L["platform.nav.notifications"]">
                            <AppIcon Name="Bell" />
                            @if (_unreadCount > 0)
                            {
                                <span class="header-bell-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
                            }
                        </a>
                        <AccountMenu @bind-Dark="_dark" @bind-Accent="_accent" />
                    </div>
                </header>

                @* 以 culture + 词典版本为 key 重建整个内容子树：页面组件（含运行时加载的模块页）
                   未订阅 FrontendLoc.Changed，父布局 StateHasChanged 会被 Blazor 参数比较跳过。
                   切语言（culture 变）或管理模块改词（版本变）都强制销毁重建，所有 L[...] 重新求值；
                   SignalR 线路不断、无整页刷新。 *@
                <div class="body" @key="FrontendLoc.CurrentCulture + ':' + FrontendLoc.Version.ToString()">
                    @if (!string.IsNullOrWhiteSpace(SysState.Public.Notice))
                    {
                        <BitCallout Class="page-callout" Style="margin-bottom: 1rem;">
                            <BitText Typography="BitTypography.Body2">@SysState.Public.Notice</BitText>
                        </BitCallout>
                    }
                    @if (!IsCurrentRouteAuthorized())
                    {
                        <div class="page-callout error" style="max-width: 36rem;">
                            <BitStack Gap="0.75rem">
                                <BitText Typography="BitTypography.H6">@L["platform.error.accessDeniedTitle"]</BitText>
                                <BitText>@L["platform.error.accessDeniedMessage"]</BitText>
                                <div>
                                    <BitButton Href="/">@L["platform.nav.backHome"]</BitButton>
                                </div>
                            </BitStack>
                        </div>
                    }
                    else
                    {
                        <WidgetZone Name="layout_body_top" />
                        @Body
                        <WidgetZone Name="layout_body_bottom" />
                    }
                </div>
            </div>
        </div>

        <div class="nav-overlay" role="presentation" aria-label="@L["platform.nav.close"]" @onclick="CloseNav"></div>

        <section class="nav-bar">
            @foreach (var item in FlattenLeafNodes(_navTree).Take(5))
            {
                <a href="@item.Path" class="nav-item @NavClass(item.Path)" @onclick="CloseNav">
                    <AppIcon Name="@item.Icon" />
                    <span>@item.Text</span>
                </a>
            }
        </section>
    </main>

    @* 全局通知容器：所有操作的成功/失败提示都在这里弹出 *@
    <BlazorBoilerplateToast />
</div>

@code {
    private RenderFragment<NavNode> RenderNavNode => node => __builder =>
    {
        var hasChildren = node.Children.Count > 0;
        var isExpanded = _expandedIds.Contains(node.Id);
        var isGroup = string.Equals(node.Kind, "group", StringComparison.OrdinalIgnoreCase);

        <div class="nav-node">
            <div class="nav-item-row">
                @if (isGroup)
                {
                    <BitButton Variant="BitVariant.Text" Class="nav-item nav-item-btn" Title="@node.Text" OnClick="() => ToggleExpand(node.Id)">
                        <AppIcon Name="@node.Icon" />
                        <span class="nav-text">@node.Text</span>
                    </BitButton>
                }
                else
                {
                    <a href="@node.Path" class="nav-item @NavClass(node.Path)" title="@node.Text" @onclick="() => OnNavItemClick(node)">
                        <AppIcon Name="@node.Icon" />
                        <span class="nav-text">@node.Text</span>
                    </a>
                }
                @if (hasChildren)
                {
                    <BitButton Variant="BitVariant.Text"
                               Class="nav-chevron"
                               Title="@(isExpanded ? L["platform.nav.collapse"] : L["platform.nav.expand"])"
                               OnClick="() => ToggleExpand(node.Id)">
                        <AppIcon Name="@(isExpanded ? "ChevronDown" : "ChevronRight")" />
                    </BitButton>
                }
            </div>
            @if (hasChildren && isExpanded)
            {
                <div class="nav-children">
                    @foreach (var child in node.Children)
                    {
                        @RenderNavNode(child)
                    }
                </div>
            }
        </div>
    };
}
