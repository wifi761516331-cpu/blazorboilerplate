@* 账号菜单：结构沿用 Bluebird AppMenu.razor + SignOutConfirmDialog.razor（原生 HTML 复刻）。
   全部为真实功能：当前用户来自 AccountState / GetCurrentUserAsync；其他账号、登录态切换、
   语言、租户、时区、通知、主题、强调色、退出登录分别对接 Web.Shared 的强类型 API 与
   app.js 提供的 blazorAuth / blazorPrefs 全局函数。弹框 DOM 常驻但用 hidden 控制显隐。
   注入与全部逻辑在 AccountMenu.razor.cs。 *@
@implements IDisposable

<div class="account-menu-root">
    <button type="button" class="header-persona" title="@L["platform.accountMenu.title"]" aria-expanded="@_isOpen" @onclick="Toggle">
        @if (Account.IsAuthenticated)
        {
            <span class="persona-avatar">
                @if (!string.IsNullOrWhiteSpace(Account.AvatarUrl))
                {
                    <img src="@Account.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" alt="" />
                }
                else
                {
                    @UserInitials()
                }
                <span class="persona-presence"></span>
            </span>
            <span class="persona-name">@Account.CurrentUser!.DisplayName</span>
        }
        else
        {
            <span class="persona-avatar"><AppIcon Name="People" /></span>
            <span class="persona-name">@L["platform.auth.signIn"]</span>
        }
        <span class="menu-chevron"><AppIcon Name="ChevronDown" /></span>
    </button>

    <button type="button" class="menu-backdrop" hidden="@(!_isOpen)" aria-label="@L["platform.accountMenu.close"]" @onclick="Close"></button>

    <div class="account-menu" hidden="@(!_isOpen)" role="menu">
        @if (_hint is not null)
        {
            <div class="account-hint">@_hint</div>
        }

        @if (_panel == MenuPanel.Main)
        {
            <div class="account-identity">
                <button type="button" class="account-avatar-lg" title="@L["platform.accountMenu.editProfile"]" @onclick="GoToProfile">
                    @if (!string.IsNullOrWhiteSpace(Account.AvatarUrl))
                    {
                        <img src="@Account.AvatarUrl" style="width:100%;height:100%;border-radius:50%;object-fit:cover;" alt="" />
                    }
                    else
                    {
                        <span class="avatar-lg-text">@UserInitials()</span>
                    }
                    <span class="avatar-overlay">@L["platform.common.edit"]</span>
                    <span class="presence-dot" title="@L["platform.accountMenu.online"]"></span>
                </button>
                <div class="account-identity-text">
                    <strong>@(Account.CurrentUser?.DisplayName ?? L["platform.accountMenu.notSignedIn"])</strong>
                    <span>@(Account.CurrentUser?.Email ?? "")</span>
                </div>
            </div>

            <div class="account-section-label">@L["platform.accountMenu.otherAccounts"]</div>
            @if (_accounts.Count == 0)
            {
                <div class="account-empty">@L["platform.accountMenu.noOtherAccounts"]</div>
            }
            @foreach (var account in _accounts)
            {
                <button type="button" class="account-action" @onclick="() => SwitchAccount(account)">
                    <span class="account-mini-avatar">@MakeInitials(LabelOf(account))</span>
                    <span class="account-action-text">
                        <strong>@LabelOf(account)</strong>
                        <small>@account.Email</small>
                    </span>
                </button>
            }
            <button type="button" class="account-action" @onclick="AddAccount">
                <AppIcon Name="AddFriend" />
                <span>@L["platform.accountMenu.addAccount"]</span>
            </button>

            <div class="account-separator"></div>

            <button type="button" class="account-action" @onclick="GoToSettings">
                <AppIcon Name="Settings" />
                <span>@L["platform.accountMenu.settings"]</span>
            </button>
            <button type="button" class="account-action has-chevron" @onclick="OpenLanguages">
                <AppIcon Name="Globe" />
                <span>@L["platform.common.language"]</span>
                <span class="account-chevron"><AppIcon Name="ChevronRight" /></span>
            </button>
            <button type="button" class="account-action has-chevron" @onclick="OpenTenants">
                <AppIcon Name="Org" />
                <span>@L["platform.accountMenu.tenant"]</span>
                <span class="account-chevron"><AppIcon Name="ChevronRight" /></span>
            </button>

            <div class="account-row">
                <AppIcon Name="Clock" />
                <select class="account-select" @bind="_timeZone" @bind:after="OnTimeZoneChangedAsync" title="@L["platform.accountMenu.timeZone"]">
                    @foreach (var zone in _timeZoneOptions)
                    {
                        <option value="@zone.Id">@zone.Text</option>
                    }
                </select>
            </div>
            <div class="account-zone-now">
                <AppIcon Name="Clock" />
                <span>@L.GetString("platform.accountMenu.localTime", _zoneNow)</span>
            </div>

            <div class="account-row">
                <AppIcon Name="@(_notifications ? "Bell" : "RingerOff")" />
                <button type="button" class="account-row-link" title="@L["platform.accountMenu.viewNotifications"]" @onclick="GoToNotifications">
                    @L["platform.nav.notifications"]
                    @if (_unreadCount > 0)
                    {
                        <span class="account-unread">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
                    }
                </button>
                <span class="account-spacer"></span>
                <button type="button" class="account-switch @(_notifications ? "on" : "")" role="switch"
                        aria-checked="@_notifications" title="@L["platform.accountMenu.receiveNotifications"]" @onclick="ToggleNotifications">
                    <span></span>
                </button>
            </div>

            <div class="account-row">
                <AppIcon Name="@(Dark ? "Sunny" : "ClearNight")" />
                <span class="account-row-label">@(Dark ? L["platform.accountMenu.darkTheme"] : L["platform.accountMenu.lightTheme"])</span>
                <span class="account-spacer"></span>
                <button type="button" class="account-switch @(Dark ? "on" : "")" role="switch"
                        aria-checked="@Dark" title="@L["platform.common.themeToggle"]" @onclick="ToggleTheme">
                    <span></span>
                </button>
            </div>

            <div class="accent-block">
                <span class="account-section-label">@L["platform.accountMenu.accentColor"]</span>
                <div class="accent-swatches">
                    @foreach (var color in AccentColors)
                    {
                        <button type="button" class="accent-swatch @(CurrentAccent == color.Hex ? "selected" : "")"
                                style="background:@color.Hex" title="@color.Name"
                                @onclick="() => SetAccent(color.Hex)">
                            @if (CurrentAccent == color.Hex)
                            {
                                <AppIcon Name="Check" />
                            }
                        </button>
                    }
                </div>
            </div>

            <div class="account-separator"></div>

            <button type="button" class="account-action danger" @onclick="OpenSignOut">
                <AppIcon Name="SignOut" />
                <span>@L["platform.auth.signOut"]</span>
            </button>
        }
        else if (_panel == MenuPanel.Languages)
        {
            <button type="button" class="account-action account-back" @onclick="BackToMain">
                <AppIcon Name="ChevronLeft" />
                <span>@L["platform.accountMenu.chooseLanguage"]</span>
            </button>
            <div class="account-separator"></div>
            @foreach (var culture in _cultures)
            {
                <button type="button" class="account-choice @(_culture == culture.Code ? "selected" : "")"
                        @onclick="() => SelectLanguage(culture)">
                    <BitFlag Iso2="@RegionIso2(culture.Code)" />
                    <span>@culture.Text</span>
                    @if (_culture == culture.Code)
                    {
                        <AppIcon Name="Check" />
                    }
                </button>
            }
        }
    </div>

    <SwitchTenantModal @bind-IsOpen="_switchOpen" />

    @* 退出确认框：沿用自包含 BlazorBoilerplateModal（与其他弹框同一套样式） *@
    <BlazorBoilerplateModal @bind-IsOpen="_signOutOpen"
                Title="@L["platform.auth.signOut"]" OkText="@L["platform.auth.signOut"]" Danger
                Message="@L["platform.accountMenu.signOutConfirm"]"
                ShowClose="false" CloseOnBackdrop="false"
                OnOk="ConfirmSignOutAsync">
        <label class="account-check">
            <input type="checkbox" @bind="_signOutAll" /> @L["platform.accountMenu.signOutAll"]
        </label>
    </BlazorBoilerplateModal>
</div>

