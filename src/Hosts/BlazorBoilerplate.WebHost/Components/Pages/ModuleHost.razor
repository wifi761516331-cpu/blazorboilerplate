@page "/{**path}"
@rendermode RenderMode.InteractiveServer
@using BlazorBoilerplate.Application.Localization

@* 动态模块页面兜底：SSR endpoint 固定为本 catch-all，组件在运行时从模块程序集解析。
   线路建立后 Router（AdditionalAssemblies = ModuleCatalog.Assemblies）接管客户端导航。 *@
@if (_componentType is null)
{
    <div class="page-callout error">
        <AppIcon Name="Alert" />
        <span>@L.GetString("platform.error.notFound", Path ?? "/")</span>
    </div>
}
else
{
    <ModuleResources ComponentType="@_componentType" />
    <DynamicComponent Type="@_componentType" />
}

