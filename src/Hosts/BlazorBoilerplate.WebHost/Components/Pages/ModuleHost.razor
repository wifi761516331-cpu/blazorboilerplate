@page "/{**path}"
@rendermode RenderMode.InteractiveServer
@using BlazorBoilerplate.Application.Localization
@inject BlazorBoilerplate.WebHost.Services.ModuleAssemblyCatalog ModuleCatalog
@inject ILocalizationService L

@* 动态模块页面兜底：SSR endpoint 固定为本 catch-all，组件在运行时从模块程序集解析。
   线路建立后 Router（AdditionalAssemblies = ModuleCatalog.Assemblies）接管客户端导航。 *@
@if (_componentType is null)
{
    <div class="page-callout error">
        <AppIcon Name="Alert" />
        <span>@L.GetString("platform.error.notFound", Path ?? "/")</span>
    </div>
}
else
{
    <DynamicComponent Type="@_componentType" />
}

@code {
    /// <summary>catch-all 捕获的路径（/catalog → "catalog"；/ → ""）。</summary>
    [Parameter]
    public string? Path { get; set; }

    private Type? _componentType;

    protected override void OnParametersSet()
    {
        _componentType = ModuleCatalog.ResolveComponent("/" + (Path ?? string.Empty));
    }
}
