@page "/system/operations"
@rendermode RenderMode.InteractiveServer
@using BlazorBoilerplate.Application.Platform
@using BlazorBoilerplate.ModuleAbstractions

<div class="page-callout">
    <BitText Element="h1" Class="page-title">@L["platform.ops.title"]</BitText>
    <BitText Class="muted">@L["platform.ops.subtitle"]</BitText>
</div>

<div class="id-page">
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="page-callout error">@_error</div>
    }

    <BitPivot SelectedKey="@_activeTab" SelectedKeyChanged="OnTabChangedAsync">
        <BitPivotItem Key="tasks" HeaderText="@L["platform.ops.tab.tasks"]" ItemCount="@(_tasks.Count == 0 ? null : _tasks.Count)">
            <div class="bb-toolbar" style="margin-top: 0.75rem;">
                <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="LoadTasksAsync" IsLoading="@_busy">
                    @L["platform.common.refresh"]
                </BitButton>
            </div>

            <BitDataGrid TItem="ScheduleTaskDescriptor" Items="_tasks" Strings="@_gridStrings" Pageable="true" PageSize="10" Sortable="true" Filterable="true" FilterDebounce="300" Bordered="true" Hoverable="true" Striped="true" ShowHeader="true">
                <Columns>
                    <BitDataGridColumn TItem="ScheduleTaskDescriptor" Property="t => t.Name" Title="@L["platform.ops.tasks.col.name"]" />
                    <BitDataGridColumn TItem="ScheduleTaskDescriptor" Property="t => t.ModuleId" Title="@L["platform.ops.tasks.col.module"]">
                        <Template Context="t">
                            <BitTag Color="BitColor.TertiaryBackground">@t.ModuleId</BitTag>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ScheduleTaskDescriptor" Property="t => t.Seconds" Title="@L["platform.ops.tasks.col.seconds"]" />
                    <BitDataGridColumn TItem="ScheduleTaskDescriptor" Property="t => t.Enabled" Title="@L["platform.ops.tasks.col.enabled"]">
                        <Template Context="t">
                            <BitToggle Value="@t.Enabled" ValueChanged="v => ToggleTaskAsync(t, v)" IsEnabled="!_busy" />
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ScheduleTaskDescriptor" Property="t => t.LastSuccessUtc" Title="@L["platform.ops.tasks.col.lastSuccess"]">
                        <Template Context="t">
                            @(t.LastSuccessUtc?.ToLocalTime().ToString("MM-dd HH:mm:ss") ?? "—")
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ScheduleTaskDescriptor" Property="t => t.LastError" Title="@L["platform.ops.tasks.col.lastError"]">
                        <Template Context="t">
                            <span style="color: var(--bb-err);">@(string.IsNullOrWhiteSpace(t.LastError) ? "—" : t.LastError)</span>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ScheduleTaskDescriptor" Title="@L["platform.ops.col.actions"]">
                        <Template Context="t">
                            <BitButton Variant="BitVariant.Text" Size="BitSize.Small" IconName="@BitIconName.Play"
                                       Disabled="@(_busy || t.IsRunning)" OnClick="() => RunTaskNowAsync(t)">
                                @L["platform.ops.tasks.runNow"]
                            </BitButton>
                        </Template>
                    </BitDataGridColumn>
                </Columns>
                <EmptyTemplate><BitText Class="muted">@L["platform.ops.tasks.empty"]</BitText></EmptyTemplate>
            </BitDataGrid>
        </BitPivotItem>

        <BitPivotItem Key="emails" HeaderText="@L["platform.ops.tab.emails"]">
            <div class="bb-toolbar" style="margin-top: 0.75rem;">
                <BitCheckbox Label="@L["platform.ops.emails.pendingOnly"]" Value="@_pendingOnlyEmails" ValueChanged="OnPendingEmailsChangedAsync" />
                <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="LoadEmailsAsync" IsLoading="@_busy">
                    @L["platform.common.refresh"]
                </BitButton>
                <BitButton IconName="@BitIconName.Send" OnClick="ProcessEmailQueueAsync" IsEnabled="!_busy">
                    @L["platform.ops.emails.processQueue"]
                </BitButton>
            </div>

            <BitDataGrid @key="_emailGridVersion" TItem="QueuedEmailItem" OnRead="ReadEmailsAsync" Strings="@_gridStrings" Pageable="true" PageSize="10" Sortable="true" Filterable="true" FilterDebounce="300" Bordered="true" Hoverable="true" Striped="true" ShowHeader="true">
                <Columns>
                    <BitDataGridColumn TItem="QueuedEmailItem" Property="e => e.To" ColumnId="to" Title="@L["platform.ops.emails.col.to"]" Sortable="true" />
                    <BitDataGridColumn TItem="QueuedEmailItem" Property="e => e.Subject" ColumnId="subject" Title="@L["platform.ops.emails.col.subject"]" Sortable="true" />
                    <BitDataGridColumn TItem="QueuedEmailItem" Property="e => e.Priority" ColumnId="priority" Title="@L["platform.ops.emails.col.priority"]" Sortable="true" />
                    <BitDataGridColumn TItem="QueuedEmailItem" Property="e => e.SentTries" ColumnId="senttries" Title="@L["platform.ops.emails.col.tries"]" Sortable="true" />
                    <BitDataGridColumn TItem="QueuedEmailItem" Property="e => e.SentOnUtc" ColumnId="sentonutc" Title="@L["platform.ops.emails.col.status"]" Sortable="true" Filterable="false">
                        <Template Context="e">
                            @if (e.SentOnUtc.HasValue)
                            {
                                <BitBadge Color="BitColor.Success">@L.GetString("platform.ops.emails.status.sent", e.SentOnUtc.Value.ToLocalTime().ToString("MM-dd HH:mm"))</BitBadge>
                            }
                            else if (!string.IsNullOrWhiteSpace(e.LastError))
                            {
                                <BitBadge Color="BitColor.Error" Title="@e.LastError">@L["platform.ops.emails.status.failed"]</BitBadge>
                            }
                            else
                            {
                                <BitBadge Color="BitColor.Info">@L["platform.ops.emails.status.pending"]</BitBadge>
                            }
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="QueuedEmailItem" Title="@L["platform.ops.col.actions"]">
                        <Template Context="e">
                            @if (!e.SentOnUtc.HasValue)
                            {
                                <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => RequeueEmailAsync(e)" Disabled="@_busy">
                                    @L["platform.ops.emails.requeue"]
                                </BitButton>
                            }
                        </Template>
                    </BitDataGridColumn>
                </Columns>
                <EmptyTemplate><BitText Class="muted">@L["platform.ops.emails.empty"]</BitText></EmptyTemplate>
            </BitDataGrid>
        </BitPivotItem>

        <BitPivotItem Key="logs" HeaderText="@L["platform.ops.tab.logs"]">
            <div class="bb-toolbar" style="margin-top: 0.75rem;">
                <div class="bb-search" style="max-width: 20rem;">
                    <BitSearchBox Placeholder="@L["platform.ops.logs.searchPlaceholder"]" Immediate DebounceTime="300"
                                  Value="@_logKeyword" ValueChanged="OnLogKeywordChangedAsync" />
                </div>
                <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="LoadLogsAsync" IsLoading="@_busy">
                    @L["platform.common.refresh"]
                </BitButton>
            </div>

            <BitDataGrid @key="_logGridVersion" TItem="ActivityLogEntry" OnRead="ReadLogsAsync" Strings="@_gridStrings" Pageable="true" PageSize="10" Sortable="true" Filterable="true" FilterDebounce="300" Bordered="true" Hoverable="true" Striped="true" ShowHeader="true">
                <Columns>
                    <BitDataGridColumn TItem="ActivityLogEntry" Property="l => l.CreatedAtUtc" ColumnId="createdatutc" Title="@L["platform.ops.logs.col.time"]" Sortable="true" Filterable="false">
                        <Template Context="l">@l.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ActivityLogEntry" Property="l => l.SystemKeyword" ColumnId="systemkeyword" Title="@L["platform.ops.logs.col.keyword"]" Sortable="true">
                        <Template Context="l"><BitTag Color="BitColor.TertiaryBackground">@l.SystemKeyword</BitTag></Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ActivityLogEntry" Property="l => l.Comment" ColumnId="comment" Title="@L["platform.ops.logs.col.comment"]" Sortable="true" />
                    <BitDataGridColumn TItem="ActivityLogEntry" Property="l => l.UserName" ColumnId="username" Title="@L["platform.ops.logs.col.user"]" Sortable="true" />
                    <BitDataGridColumn TItem="ActivityLogEntry" Property="l => l.EntityName" ColumnId="entityname" Title="@L["platform.ops.logs.col.entity"]" Sortable="true" />
                </Columns>
                <EmptyTemplate><BitText Class="muted">@L["platform.ops.logs.empty"]</BitText></EmptyTemplate>
            </BitDataGrid>
        </BitPivotItem>

        <BitPivotItem Key="templates" HeaderText="@L["platform.ops.tab.templates"]" ItemCount="@(_templates.Count == 0 ? null : _templates.Count)">
            <div class="bb-toolbar" style="margin-top: 0.75rem;">
                <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="LoadTemplatesAsync" IsLoading="@_busy">
                    @L["platform.common.refresh"]
                </BitButton>
            </div>

            <BitDataGrid TItem="MessageTemplateItem" Items="_templates" Strings="@_gridStrings" Pageable="true" PageSize="10" Sortable="true" Filterable="true" FilterDebounce="300" Bordered="true" Hoverable="true" Striped="true" ShowHeader="true">
                <Columns>
                    <BitDataGridColumn TItem="MessageTemplateItem" Property="t => t.Name" Title="@L["platform.ops.templates.col.name"]" />
                    <BitDataGridColumn TItem="MessageTemplateItem" Property="t => t.Subject" Title="@L["platform.ops.templates.col.subject"]" />
                    <BitDataGridColumn TItem="MessageTemplateItem" Property="t => t.IsActive" Title="@L["platform.ops.templates.col.status"]">
                        <Template Context="t">
                            <BitBadge Color="@(t.IsActive ? BitColor.Success : BitColor.TertiaryBackground)">
                                @(t.IsActive ? L["platform.ops.templates.status.enabled"] : L["platform.ops.templates.status.disabled"])
                            </BitBadge>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="MessageTemplateItem" Property="t => t.UpdatedAtUtc" Title="@L["platform.ops.templates.col.updatedAt"]">
                        <Template Context="t">@t.UpdatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="MessageTemplateItem" Title="@L["platform.ops.col.actions"]">
                        <Template Context="t">
                            <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => OpenEditTemplate(t)">
                                @L["platform.ops.templates.edit"]
                            </BitButton>
                        </Template>
                    </BitDataGridColumn>
                </Columns>
                <EmptyTemplate><BitText Class="muted">@L["platform.ops.templates.empty"]</BitText></EmptyTemplate>
            </BitDataGrid>
        </BitPivotItem>

        <BitPivotItem Key="providers" HeaderText="@L["platform.ops.tab.providers"]" ItemCount="@(_providers.Count == 0 ? null : _providers.Count)">
            <div class="bb-toolbar" style="margin-top: 0.75rem;">
                <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="LoadProvidersAsync" IsLoading="@_busy">
                    @L["platform.common.refresh"]
                </BitButton>
            </div>

            <BitDataGrid TItem="ProviderItemModel" Items="_providers" Strings="@_gridStrings" Pageable="true" PageSize="10" Sortable="true" Filterable="true" FilterDebounce="300" Bordered="true" Hoverable="true" Striped="true" ShowHeader="true">
                <Columns>
                    <BitDataGridColumn TItem="ProviderItemModel" Property="p => p.SystemName" Title="@L["platform.ops.providers.col.systemName"]" />
                    <BitDataGridColumn TItem="ProviderItemModel" Property="p => p.FriendlyName" Title="@L["platform.ops.providers.col.friendlyName"]" />
                    <BitDataGridColumn TItem="ProviderItemModel" Property="p => p.ModuleId" Title="@L["platform.ops.providers.col.module"]">
                        <Template Context="p"><BitTag Color="BitColor.TertiaryBackground">@p.ModuleId</BitTag></Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="ProviderItemModel" Property="p => p.Order" Title="@L["platform.ops.providers.col.order"]" />
                    <BitDataGridColumn TItem="ProviderItemModel" Property="p => p.Enabled" Title="@L["platform.ops.providers.col.enabled"]">
                        <Template Context="p">
                            <BitToggle Value="@p.Enabled" ValueChanged="v => ToggleProviderAsync(p, v)" IsEnabled="!_busy" />
                        </Template>
                    </BitDataGridColumn>
                </Columns>
                <EmptyTemplate><BitText Class="muted">@L["platform.ops.providers.empty"]</BitText></EmptyTemplate>
            </BitDataGrid>
        </BitPivotItem>
    </BitPivot>
</div>

<BlazorBoilerplateModal @bind-IsOpen="_tplModalOpen"
                        Title="@L.GetString("platform.ops.templates.modalTitle", _editingTplName)"
                        OkText="@L["platform.common.save"]"
                        CancelText="@L["platform.common.cancel"]"
                        Disabled="@_busy"
                        OnOk="SaveTemplateAsync">
    <BitStack Gap="0.75rem">
        <BitTextField Label="@L["platform.ops.templates.field.subject"]" @bind-Value="_editingTplSubject" Required />
        <BitTextField Label="@L["platform.ops.templates.field.body"]" @bind-Value="_editingTplBody" Multiline="true" Rows="6" Required />
        <BitCheckbox Label="@L["platform.ops.templates.field.active"]" @bind-Value="_editingTplActive" />
    </BitStack>
</BlazorBoilerplateModal>
