@page "/tenants"
@rendermode RenderMode.InteractiveServer
@inject BlazorBoilerplateApiClient Api
@inject ToastService Toast
@inject NavigationManager Navigation
@inject AccountState Account
@inject IJSRuntime JS
@inject ILocalizationService L

@* 租户管理：对齐 Bluebird ManageMyTenantsPage（手风琴 + 卡片列表）+ ManageAllTenantsPage（管理员网格）。
   普通用户视图 = 「我的租户」：手风琴（新建租户 / 邀请成员 / 编辑当前租户）+ 卡片列表（切换·接受 / 离开·拒绝）。
   管理员（tenant.create）额外看到「管理所有租户」网格：启用停用开关 + 编辑。
   数据来自 UserController.GetTenants（当前用户的租户成员关系，含待接受邀请）；切换/接受经由 blazorAuth.switchTenant，
   离开/拒绝经由 Api.LeaveTenantAsync；创建/编辑调用 Api.CreateTenantAsync / UpdateTenantAsync。
   Accepted=false 表示待接受邀请，Accepted=true 表示已是成员；Current=true 表示 claims 中当前选中的租户。 *@

<section class="mytenants-page">
<div class="mytenants-root">
<BitText Typography="BitTypography.H4">@L["platform.nav.myTenant"]</BitText>

@if (_loadError is not null)
{
    <div class="page-callout error">@_loadError</div>
}

@if (_loading)
{
    <div class="mytenants-loading"><span class="blazorboilerplate-spinner"></span> @L["platform.common.loading"]</div>
}
else
{
    @* 手风琴：同一时刻仅展开一个分区。无租户时默认展开「新建租户」。 *@
    <div class="mytenants-accordion">
        @* 1. 新建租户（始终可用）。 *@
        <PermissionView Code="tenant.create">
            <div class="mt-section @(_expanded == "create" ? "expanded" : "")">
                <button type="button" class="mt-section-header" @onclick="ToggleCreate">
                    <AppIcon Name="Add" />
                    <span class="mt-section-title">@L["platform.tenants.createTitle"]</span>
                    <AppIcon Name="ChevronDown" Class="mt-chevron" />
                </button>
                @if (_expanded == "create")
                {
                    <div class="mt-section-body">
                        <div class="mt-form">
                            <div class="auth-field">
                                <label class="auth-label" for="tn-create-name">@L["platform.tenants.field.nameRequired"]</label>
                                <input id="tn-create-name" class="auth-input" @bind="_createName" placeholder="@L["platform.tenants.field.namePlaceholder"]" />
                            </div>
                            <div class="auth-field">
                                <label class="auth-label" for="tn-create-title">@L["platform.tenants.field.title"]</label>
                                <input id="tn-create-title" class="auth-input" @bind="_createTitle" placeholder="@L["platform.tenants.field.titlePlaceholder"]" />
                            </div>
                            <div class="auth-field">
                                <label class="auth-label" for="tn-create-domain">@L["platform.tenants.field.domain"]</label>
                                <input id="tn-create-domain" class="auth-input" @bind="_createDomain" placeholder="tenant.example.com" />
                            </div>
                        </div>
                        <button type="button" class="blazorboilerplate-btn primary" disabled="@_busy" @onclick="CreateAsync">
                            @(_busy ? L["platform.tenants.creating"] : L["platform.common.save"])
                        </button>
                    </div>
                }
            </div>
        </PermissionView>

        @* 2. 邀请成员（仅租户管理员，且需先有当前租户）。 *@
        <PermissionView Code="tenant.invite">
            <div class="mt-section @(_expanded == "invite" ? "expanded" : "") @(_currentTenant is null ? "disabled" : "")">
                <button type="button" class="mt-section-header" disabled="@(_currentTenant is null)"
                        @onclick="ToggleInvite">
                    <AppIcon Name="People" />
                    <span class="mt-section-title">@InviteSectionTitle</span>
                    <AppIcon Name="ChevronDown" Class="mt-chevron" />
                </button>
                @if (_expanded == "invite" && _currentTenant is not null)
                {
                    <div class="mt-section-body">
                        <p class="muted">@L.GetString("platform.tenants.inviteDesc", string.IsNullOrWhiteSpace(_currentTenant.Title) ? _currentTenant.Name : _currentTenant.Title)</p>
                        <div class="mt-form">
                            <div class="auth-field">
                                <label class="auth-label" for="tn-invite-email">@L["platform.tenants.field.memberEmail"]</label>
                                <input id="tn-invite-email" class="auth-input" type="email" @bind="_inviteEmail" placeholder="member@example.com" />
                            </div>
                        </div>
                        <button type="button" class="blazorboilerplate-btn primary" disabled="@_busy" @onclick="InviteAsync">
                            @(_busy ? L["platform.notifications.sending"] : L["platform.tenants.sendInvite"])
                        </button>
                    </div>
                }
            </div>
        </PermissionView>

        @* 3. 编辑当前租户（仅租户管理员，且需先有当前租户）。 *@
        <PermissionView Code="tenant.update">
            <div class="mt-section @(_expanded == "update" ? "expanded" : "") @(_currentTenant is null ? "disabled" : "")">
                <button type="button" class="mt-section-header" disabled="@(_currentTenant is null)"
                        @onclick="ToggleUpdate">
                    <AppIcon Name="Edit" />
                    <span class="mt-section-title">@L["platform.tenants.editCurrentTitle"]</span>
                    <AppIcon Name="ChevronDown" Class="mt-chevron" />
                </button>
                @if (_expanded == "update" && _currentTenant is not null)
                {
                    <div class="mt-section-body">
                        <div class="mt-form">
                            <div class="auth-field">
                                <label class="auth-label" for="tn-edit-name">@L["platform.tenants.field.nameRequired"]</label>
                                <input id="tn-edit-name" class="auth-input" @bind="_editName" placeholder="@L["platform.tenants.field.namePlaceholder"]" />
                            </div>
                            <div class="auth-field">
                                <label class="auth-label" for="tn-edit-title">@L["platform.tenants.field.title"]</label>
                                <input id="tn-edit-title" class="auth-input" @bind="_editTitle" placeholder="@L["platform.tenants.field.titlePlaceholder"]" />
                            </div>
                            <div class="auth-field">
                                <label class="auth-label" for="tn-edit-domain">@L["platform.tenants.field.domain"]</label>
                                <input id="tn-edit-domain" class="auth-input" @bind="_editDomain" placeholder="tenant.example.com" />
                            </div>
                        </div>
                        <button type="button" class="blazorboilerplate-btn primary" disabled="@_busy" @onclick="UpdateAsync">
                            @(_busy ? L["platform.profile.saving"] : L["platform.common.save"])
                        </button>
                    </div>
                }
            </div>
        </PermissionView>
    </div>

    @* 租户卡片列表 *@
    <div class="tenant-cards">
        @if (_tenants.Count == 0)
        {
            <div class="tenant-empty">
                <AppIcon Name="Org" Class="tenant-empty-icon" />
                <p>@L["platform.tenants.empty"]</p>
            </div>
        }
        else
        {
            @foreach (var tenant in _tenants)
            {
                <div class="tenant-card" @key="tenant.Id">
                    <div class="tenant-card-main">
                        <span class="tenant-card-icon @(IsCurrent(tenant) ? "current" : (!tenant.Accepted ? "pending" : ""))">
                            <AppIcon Name="@(IsCurrent(tenant) ? "Check" : (!tenant.Accepted ? "Mail" : "Org"))" />
                        </span>
                        <div class="tenant-card-info">
                            <span class="tenant-card-title">@(string.IsNullOrWhiteSpace(tenant.Title) ? tenant.Name : tenant.Title)</span>
                            <span class="tenant-card-name">@tenant.Name</span>
                            @if (!string.IsNullOrWhiteSpace(tenant.Domain))
                            {
                                <span class="tenant-card-domain">@tenant.Domain</span>
                            }
                        </div>
                        <BitTag Variant="BitVariant.Outline"
                                Style="flex-shrink:0"
                                Color="@(tenant.IsActive ? BitColor.Success : BitColor.Error)"
                                Text="@(tenant.IsActive ? L["platform.tenants.active"] : L["platform.tenants.inactive"])" />
                    </div>
                    <div class="tenant-card-actions">
                        @if (!IsCurrent(tenant))
                        {
                            <BitButton Variant="BitVariant.Outline"
                                       IconName="@(tenant.Accepted ? BitIconName.Switch : BitIconName.Accept)"
                                       IsLoading="_busy"
                                       OnClick="() => SwitchOrAcceptAsync(tenant)">
                                @(tenant.Accepted ? L["platform.tenants.switch"] : L["platform.tenants.acceptInvite"])
                            </BitButton>
                        }
                        <BitButton Color="BitColor.Error"
                                   Variant="BitVariant.Text"
                                   IconName="@BitIconName.Leave"
                                   IsLoading="_busy"
                                   OnClick="() => AskLeave(tenant)">
                            @(tenant.Accepted ? L["platform.tenants.leave"] : L["platform.tenants.declineInvite"])
                        </BitButton>
                    </div>
                </div>
            }
        }
    </div>
}

@* 离开 / 拒绝邀请确认框 *@
<BlazorBoilerplateModal @bind-IsOpen="_confirmLeaveOpen"
                        Title="@(_leavingTenant is not null && !_leavingTenant.Accepted ? L["platform.tenants.declineInvite"] : L["platform.tenants.leaveTitle"])"
                        OkText="@(_leavingTenant is not null && !_leavingTenant.Accepted ? L["platform.tenants.declineInvite"] : L["platform.tenants.leave"])"
                        Danger ShowCancel="true" OnOk="ConfirmLeaveAsync">
    <p class="muted">
        @if (_leavingTenant is not null && !_leavingTenant.Accepted)
        {
            @L.GetString("platform.tenants.confirmDecline", string.IsNullOrWhiteSpace(_leavingTenant.Title) ? _leavingTenant.Name : _leavingTenant.Title)
        }
        else if (_leavingTenant is not null)
        {
            @L.GetString("platform.tenants.confirmLeave", string.IsNullOrWhiteSpace(_leavingTenant.Title) ? _leavingTenant.Name : _leavingTenant.Title)
        }
    </p>
</BlazorBoilerplateModal>

@* 管理员：管理所有租户 *@
<PermissionView Code="tenant.create">
    @if (_isAdmin)
    {
        <div class="admin-tenants-section">
            <div class="admin-section-head">
                <BitText Typography="BitTypography.H5">@L["platform.tenants.adminTitle"]</BitText>
                <BitButton IconPlacement="BitPlacement.End" IconName="@BitIconName.Add" OnClick="OpenAdminCreate">@L["platform.tenants.addTenant"]</BitButton>
            </div>

            <div class="grid-container">
                <table class="data-grid">
                    <thead>
                        <tr>
                            <th>@L["platform.tenants.field.name"]</th>
                            <th>@L["platform.tenants.field.title"]</th>
                            <th>@L["platform.tenants.field.domain"]</th>
                            <th style="text-align:center; width:150px;">@L["platform.tenants.active"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_allTenants.Count == 0)
                        {
                            <tr><td colspan="4" class="muted">@L["platform.tenants.adminEmpty"]</td></tr>
                        }
                        @foreach (var t in _allTenants)
                        {
                            <tr>
                                <td><strong>@t.Name</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(t.Title) ? "—" : t.Title)</td>
                                <td class="mono">@(string.IsNullOrWhiteSpace(t.Domain) ? "—" : t.Domain)</td>
                                <td>
                                    <div class="admin-tenant-actions">
                                        <BitToggle Value="t.IsActive"
                                                   AriaLabel="@L["platform.tenants.active"]"
                                                   OnChange="@(async (bool _) => await ToggleActiveAsync(t))" />
                                        <PermissionView Code="tenant.update">
                                            <BitButton Variant="BitVariant.Text"
                                                       IconName="@BitIconName.Edit"
                                                       Title="@L["platform.common.edit"]"
                                                       AriaLabel="@L["platform.common.edit"]"
                                                       OnClick="() => OpenAdminEdit(t)" />
                                        </PermissionView>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</PermissionView>
</div>
</section>

@* 管理员新增 / 编辑租户 *@
<BlazorBoilerplateModal @bind-IsOpen="_adminEditOpen"
                        Title="@(_adminEditing is null ? L["platform.tenants.addTenant"] : L["platform.tenants.editTenant"])" OkText="@L["platform.common.save"]" OnOk="SaveAdminEditAsync">
    <div class="id-form">
        <div class="auth-field">
            <label class="auth-label" for="tn-adm-name">@L["platform.tenants.field.nameRequired"]</label>
            <input id="tn-adm-name" class="auth-input" @bind="_adminName" placeholder="@L["platform.tenants.field.namePlaceholder"]" />
        </div>
        <div class="auth-field">
            <label class="auth-label" for="tn-adm-title">@L["platform.tenants.field.title"]</label>
            <input id="tn-adm-title" class="auth-input" @bind="_adminTitle" placeholder="@L["platform.tenants.field.titlePlaceholder"]" />
        </div>
        <div class="auth-field">
            <label class="auth-label" for="tn-adm-domain">@L["platform.tenants.field.domain"]</label>
            <input id="tn-adm-domain" class="auth-input" @bind="_adminDomain" placeholder="tenant.example.com" />
        </div>
        <label class="account-check">
            <input type="checkbox" @bind="_adminActive" /> @L["platform.tenants.active"]
        </label>
    </div>
</BlazorBoilerplateModal>

@code {
    private List<TenantDto> _tenants = [];
    private List<TenantDto> _allTenants = [];
    private TenantDto? _currentTenant;
    private string? _loadError;
    private bool _loading;
    private bool _busy;
    private bool _isAdmin;

    private string? _expanded;

    // 新建
    private string _createName = string.Empty;
    private string _createTitle = string.Empty;
    private string _createDomain = string.Empty;

    // 邀请
    private string _inviteEmail = string.Empty;

    // 编辑当前租户
    private string _editName = string.Empty;
    private string _editTitle = string.Empty;
    private string _editDomain = string.Empty;

    // 离开 / 拒绝
    private bool _confirmLeaveOpen;
    private TenantDto? _leavingTenant;

    // 管理员编辑
    private bool _adminEditOpen;
    private TenantDto? _adminEditing;
    private string _adminName = string.Empty;
    private string _adminTitle = string.Empty;
    private string _adminDomain = string.Empty;
    private bool _adminActive;

    protected override async Task OnInitializedAsync()
    {
        await Account.EnsureLoadedAsync();
        _isAdmin = Account.HasPermission("tenant.create");
        await LoadAsync();
        if (_isAdmin)
            await LoadAllAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _tenants = (await Api.GetTenantsAsync()).ToList();
            _currentTenant = _tenants.FirstOrDefault(IsCurrent);
            if (_currentTenant is not null)
            {
                _editName = _currentTenant.Name;
                _editTitle = _currentTenant.Title ?? string.Empty;
                _editDomain = _currentTenant.Domain ?? string.Empty;
            }
            // 无租户时默认展开「新建租户」；否则默认收起。
            _expanded = _tenants.Count == 0 ? "create" : null;
        }
        catch (Exception ex)
        {
            _loadError = L.GetString("platform.tenants.error.loadFailed", ex.Message);
            Toast.Error(_loadError);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAllAsync()
    {
        try { _allTenants = (await Api.GetAllTenantsAsync()).ToList(); }
        catch (Exception ex) { Toast.Error(L.GetString("platform.tenants.error.loadAllFailed", ex.Message)); }
    }

    private bool IsCurrent(TenantDto tenant) =>
        tenant.Current || (Account.CurrentUser?.TenantId is { } tid && tid == tenant.Id);

    // 手风琴分区标题用属性计算，事件处理器用方法组（规避 Razor 属性内字符串字面量 lambda 的引号解析问题）。
    private string InviteSectionTitle => _currentTenant is null
        ? L["platform.tenants.inviteMembers"]
        : L.GetString("platform.tenants.inviteMembersTo", string.IsNullOrWhiteSpace(_currentTenant.Title) ? _currentTenant.Name : _currentTenant.Title);

    private void ToggleCreate() => ToggleSection("create");
    private void ToggleInvite() => ToggleSection("invite");
    private void ToggleUpdate() => ToggleSection("update");

    private void ToggleSection(string key)
    {
        if (_currentTenant is null && (key == "invite" || key == "update")) return;
        _expanded = _expanded == key ? null : key;
    }

    private async Task Redirect(string url)
    {
        try { await JS.InvokeVoidAsync("blazorAuth.redirect", url); }
        catch { /* 整页跳转会销毁 JS 上下文，忽略跳转引发的 interop 异常 */ }
    }

    /// <summary>切换/接受邀请入口（带 busy 守卫，供卡片按钮直接触发）。</summary>
    private async Task SwitchOrAcceptAsync(TenantDto tenant)
    {
        if (IsCurrent(tenant) || _busy) return;
        _busy = true;
        try
        {
            await SwitchTenantCoreAsync(tenant.Id, tenant.Name);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.tenants.toast.switchFailed", ex.Message));
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>切换核心逻辑（不含 busy 守卫）：CreateAsync / ConfirmLeaveAsync 已持有 _busy，
    /// 若经 SwitchOrAcceptAsync 进入会被开头的 _busy 检查静默吞掉（切换与跳转都不执行）。</summary>
    private async Task SwitchTenantCoreAsync(Guid tenantId, string tenantName)
    {
        var result = await JS.InvokeAsync<JsonElement>("blazorAuth.switchTenant", tenantId.ToString());
        if (!Ok(result))
        {
            Toast.Error(Err(result) ?? L["platform.tenants.toast.switchFailedSimple"]);
            return;
        }
        Toast.Success(L.GetString("platform.tenants.toast.switching", tenantName));
        await Redirect("/");
    }

    private async Task CreateAsync()
    {
        if (_busy) return;
        if (string.IsNullOrWhiteSpace(_createName))
        {
            Toast.Warning(L["platform.tenants.toast.nameRequired"]);
            return;
        }
        _busy = true;
        try
        {
            var name = _createName.Trim();
            var title = string.IsNullOrWhiteSpace(_createTitle) ? null : _createTitle.Trim();
            var domain = string.IsNullOrWhiteSpace(_createDomain) ? null : _createDomain.Trim();
            var created = await Api.CreateTenantAsync(
                new TenantDto(Guid.Empty, name, title, domain, true, true, false));
            Toast.Success(L.GetString("platform.tenants.toast.createdEntering", created.Name));
            // 创建者即成为该租户管理员，直接切入（与 Bluebird 一致）。
            await SwitchTenantCoreAsync(created.Id, created.Name);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.tenants.toast.createFailed", ex.Message));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task InviteAsync()
    {
        if (_busy || _currentTenant is null) return;
        if (string.IsNullOrWhiteSpace(_inviteEmail))
        {
            Toast.Warning(L["platform.tenants.toast.inviteEmailRequired"]);
            return;
        }
        _busy = true;
        try
        {
            await Api.InviteTenantUserAsync(new InviteUserToTenantRequestDto(_currentTenant.Id, _inviteEmail.Trim()));
            Toast.Success(L.GetString("platform.tenants.toast.invited", _inviteEmail.Trim()));
            _inviteEmail = string.Empty;
            _expanded = null;
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.tenants.toast.inviteFailed", ex.Message));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UpdateAsync()
    {
        if (_busy || _currentTenant is null) return;
        if (string.IsNullOrWhiteSpace(_editName))
        {
            Toast.Warning(L["platform.tenants.toast.nameRequired"]);
            return;
        }
        _busy = true;
        try
        {
            var name = _editName.Trim();
            var title = string.IsNullOrWhiteSpace(_editTitle) ? null : _editTitle.Trim();
            var domain = string.IsNullOrWhiteSpace(_editDomain) ? null : _editDomain.Trim();
            await Api.UpdateTenantAsync(_currentTenant with { Name = name, Title = title, Domain = domain });
            Toast.Success(L.GetString("platform.tenants.toast.updated", name));
            _expanded = null;
            await Redirect(Navigation.Uri); // 整页刷新以反映新名称/标题
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.tenants.toast.updateFailed", ex.Message));
        }
        finally
        {
            _busy = false;
        }
    }

    private void AskLeave(TenantDto tenant)
    {
        _leavingTenant = tenant;
        _confirmLeaveOpen = true;
    }

    private async Task ConfirmLeaveAsync()
    {
        if (_leavingTenant is null) return;
        var tenant = _leavingTenant;
        var wasCurrent = IsCurrent(tenant);
        _busy = true;
        try
        {
            await Api.LeaveTenantAsync(tenant.Id);
            Toast.Success(tenant.Accepted
                ? L.GetString("platform.tenants.toast.left", tenant.Name)
                : L.GetString("platform.tenants.toast.declined", tenant.Name));
            _confirmLeaveOpen = false;
            _leavingTenant = null;

            await LoadAsync();
            // 离开的是当前租户：若还有其他已接受租户则切入，否则整页刷新（cookie 的 tid 可能短暂滞后）。
            if (wasCurrent)
            {
                var fallback = _tenants.FirstOrDefault(t => t.Accepted);
                if (fallback is not null)
                {
                    await SwitchTenantCoreAsync(fallback.Id, fallback.Name);
                    return;
                }
            }
            await Redirect(Navigation.Uri);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.tenants.toast.leaveFailed", ex.Message));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleActiveAsync(TenantDto tenant)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var updated = await Api.UpdateTenantAsync(tenant with { IsActive = !tenant.IsActive });
            var idx = _allTenants.FindIndex(t => t.Id == updated.Id);
            if (idx >= 0) _allTenants[idx] = updated;
            Toast.Success(updated.IsActive
                ? L.GetString("platform.tenants.toast.activated", updated.Name)
                : L.GetString("platform.tenants.toast.deactivated", updated.Name));
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.tenants.toast.toggleFailed", ex.Message));
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenAdminCreate()
    {
        _adminEditing = null;
        _adminName = string.Empty;
        _adminTitle = string.Empty;
        _adminDomain = string.Empty;
        _adminActive = true;
        _adminEditOpen = true;
    }

    private void OpenAdminEdit(TenantDto tenant)
    {
        _adminEditing = tenant;
        _adminName = tenant.Name;
        _adminTitle = tenant.Title ?? string.Empty;
        _adminDomain = tenant.Domain ?? string.Empty;
        _adminActive = tenant.IsActive;
        _adminEditOpen = true;
    }

    private async Task SaveAdminEditAsync()
    {
        if (string.IsNullOrWhiteSpace(_adminName))
        {
            Toast.Warning(L["platform.tenants.toast.nameRequired"]);
            return;
        }
        try
        {
            var name = _adminName.Trim();
            var title = string.IsNullOrWhiteSpace(_adminTitle) ? null : _adminTitle.Trim();
            var domain = string.IsNullOrWhiteSpace(_adminDomain) ? null : _adminDomain.Trim();
            if (_adminEditing is null)
            {
                var created = await Api.CreateTenantAsync(new TenantDto(Guid.Empty, name, title, domain, _adminActive, true, false));
                Toast.Success(L.GetString("platform.tenants.toast.adminCreated", created.Name));
            }
            else
            {
                var updated = await Api.UpdateTenantAsync(_adminEditing with
                {
                    Name = name,
                    Title = title,
                    Domain = domain,
                    IsActive = _adminActive
                });
                Toast.Success(L.GetString("platform.tenants.toast.updated", updated.Name));
            }
            _adminEditOpen = false;
            await LoadAsync();
            await LoadAllAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.tenants.toast.saveFailed", ex.Message));
        }
    }

    private static bool Ok(JsonElement el) =>
        el.ValueKind == JsonValueKind.Object &&
        el.TryGetProperty("ok", out var v) && v.ValueKind == JsonValueKind.True;

    private static string? Err(JsonElement el) =>
        el.ValueKind == JsonValueKind.Object &&
        el.TryGetProperty("error", out var v) && v.ValueKind == JsonValueKind.String
            ? v.GetString() : null;
}
