@page "/modules"
@rendermode RenderMode.InteractiveServer
@inject BlazorBoilerplateApiClient Api
@inject ILogger<Modules> Logger
@inject ToastService Toast
@inject IJSRuntime JS
@inject BlazorBoilerplate.WebHost.Services.NavRefreshService NavRefresh
@inject BlazorBoilerplate.WebHost.Services.ModuleAssemblyCatalog ModuleCatalog
@inject ILocalizationService L

<BitCallout Class="page-callout">
    <BitText Element="h1" Class="page-title">@L["platform.header.modules.title"]</BitText>
    <BitText Class="muted">@L["platform.modules.subtitle"]</BitText>
</BitCallout>

@if (_loadError is not null)
{
    <BitCallout Class="page-callout error">@L.GetString("platform.modules.error.apiHost", _loadError)</BitCallout>
}
else if (_loading)
{
    <BitText Class="muted">@L["platform.common.loading"]</BitText>
}
else
{
    @* Bluebird ProductsPage 风格工具栏 + Dashboard 卡片网格 *@
    <div class="bb-toolbar">
        <div class="bb-search">
            <BitSearchBox @bind-Value="_search" Immediate DebounceTime="300" Placeholder="@L["platform.modules.searchPlaceholder"]" />
        </div>
        <div class="bb-spacer"></div>
        <PermissionView Code="module.upload">
            <BitButton Color="BitColor.Primary" IconName="@BitIconName.CloudUpload" OnClick="@(() => _uploadOpen = true)">@L["platform.modules.upload"]</BitButton>
        </PermissionView>
        @if (_packEnabled)
        {
            <PermissionView Code="module.pack">
                <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Package" OnClick="@(() => _packOpen = true)">@L["platform.modules.pack"]</BitButton>
            </PermissionView>
        }
        <PermissionView Code="module.load">
            <BitButton Color="BitColor.Primary" OnClick="LoadAllAsync" Disabled="@_loadAllBusy">
                @(_loadAllBusy ? L["platform.modules.loadingAll"] : L["platform.modules.loadAll"])
            </BitButton>
        </PermissionView>
        <BitButton Variant="BitVariant.Outline" IconName="@BitIconName.Refresh" OnClick="RefreshAsync">@L["platform.common.refresh"]</BitButton>
    </div>

    <div class="module-summary">
        <style>
            .module-summary-item.module-kpi-item { flex-direction: row; align-items: center; justify-content: space-between; gap: .75rem; }
            .module-kpi-meta { display: flex; flex-direction: column; gap: .25rem; min-width: 0; }
            .module-kpi-icon { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0; font-size: 1.15rem; }
            .module-kpi-icon svg { width: 1.15rem; height: 1.15rem; }
            .module-kpi-icon.is-total { color: #0078d4; background: rgba(0, 120, 212, 0.1); }
            .module-kpi-icon.is-running { color: #107c10; background: rgba(16, 124, 16, 0.1); }
            .module-kpi-icon.is-essential { color: #5c2d91; background: rgba(92, 45, 145, 0.1); }
            .module-kpi-icon.is-pending { color: #b46e00; background: rgba(180, 110, 0, 0.1); }
        </style>
        <div class="module-summary-item module-kpi-item">
            <div class="module-kpi-meta">
                <span class="module-summary-label">@L["platform.modules.stat.total"]</span>
                <strong>@_modules.Count</strong>
            </div>
            <span class="module-kpi-icon is-total" aria-hidden="true">
                <AppIcon Name="Puzzle" />
            </span>
        </div>
        <div class="module-summary-item module-kpi-item">
            <div class="module-kpi-meta">
                <span class="module-summary-label">@L["platform.modules.stat.running"]</span>
                <strong class="ok">@RunningCount</strong>
            </div>
            <span class="module-kpi-icon is-running" aria-hidden="true">
                <BitIcon IconName="@BitIconName.CompletedSolid" />
            </span>
        </div>
        <div class="module-summary-item module-kpi-item">
            <div class="module-kpi-meta">
                <span class="module-summary-label">@L["platform.modules.stat.essential"]</span>
                <strong>@EssentialCount</strong>
            </div>
            <span class="module-kpi-icon is-essential" aria-hidden="true">
                <AppIcon Name="Shield" />
            </span>
        </div>
        <div class="module-summary-item module-kpi-item">
            <div class="module-kpi-meta">
                <span class="module-summary-label">@L["platform.modules.stat.pending"]</span>
                <strong class="warn">@(_modules.Count - RunningCount)</strong>
            </div>
            <span class="module-kpi-icon is-pending" aria-hidden="true">
                <BitIcon IconName="@BitIconName.Warning" />
            </span>
        </div>
    </div>

    @if (!FilteredModules.Any())
    {
        <div class="module-empty">
            <AppIcon Name="Puzzle" />
            <span>@L["platform.modules.empty"]</span>
        </div>
    }
    else
    {
        <div class="module-grid">
            @foreach (var m in FilteredModules)
            {
                <article class="module-card @CardClass(m)">
                    <div class="module-card-head">
                        <span class="module-card-icon"><AppIcon Name="@ModuleIcon(m.Id)" /></span>
                        <div class="module-card-heading">
                            <strong class="module-card-title">@m.DisplayTitle</strong>
                            <span class="module-card-id">@m.Id · @m.Name</span>
                        </div>
@*                         @if (m.VersionCount > 1 && _versionItems.TryGetValue(m.Id, out var versionItems))
                        {
                            <BitDropdown TItem="BitDropdownItem<string>" TValue="string"
                                         Class="module-version-select" Title="选择运行版本"
                                         Items="@versionItems" Value="@m.Version"
                                         OnChange="@(v => SwitchCardVersionAsync(m.Id, v))" />
                        } *@
                      @*   else
                        { *@
                            <span class="module-version-badge" title="@L["platform.modules.activeVersionTitle"]">v@(m.Version)</span>
                       @*  } *@
                        <BitTag Color="@StateColor(m.State)"
                                Variant="BitVariant.Outline"
                                Size="BitSize.Small"
                                IconName="@StateIcon(m.State)"
                                Title="@m.State.ToString()">@StateText(m.State)</BitTag>
                    </div>

                    <div class="module-card-meta">
                        <span>@m.Publisher</span>
                        <span class="dot-sep"></span>
                        <span>@L.GetString("platform.modules.versionCount", m.VersionCount)</span>
                    </div>

                    <div class="module-card-tags">
                        <span class="module-chip">@L.GetString("platform.modules.loadOrder", m.Order)</span>
                        @if (m.IsEssential)
                        {
                            <span class="module-chip warn">@L["platform.modules.essentialChip"]</span>
                        }
                        @if (m.Permissions.Length == 0)
                        {
                            <span class="module-chip muted">@L["platform.modules.noPermissions"]</span>
                        }
                        else
                        {
                            @foreach (var p in m.Permissions)
                            {
                                <span class="module-chip info">@p</span>
                            }
                        }
                    </div>

                    <div class="module-card-foot">
                        @if (m.State == ModuleState.Running)
                        {
                            @if (m.IsEssential)
                            {
                                <span class="module-protected" title="@L["platform.modules.essentialProtected"]"><AppIcon Name="Shield" /></span>
                            }
                            else
                            {
                                <PermissionView Code="module.unload">
                                    <BitButton Color="BitColor.Error" Variant="BitVariant.Text" IconName="@BitIconName.CircleStop"
                                               Title="@L["platform.modules.unload"]" AriaLabel="@L["platform.modules.unload"]"
                                               OnClick="@(() => UnloadAsync(m.Id))" Disabled="@_busy.Contains(m.Id)" />
                                </PermissionView>
                            }
                        }
                        else if (m.State is ModuleState.Installed or ModuleState.Disabled or ModuleState.Uninstalled)
                        {
                            <PermissionView Code="module.load">
                                <BitButton Color="BitColor.Primary" Variant="BitVariant.Text" IconName="@BitIconName.Play"
                                           Title="@L["platform.modules.load"]" AriaLabel="@L["platform.modules.load"]"
                                           OnClick="@(() => LoadAsync(m.Id))" Disabled="@_busy.Contains(m.Id)" />
                            </PermissionView>
                        }
                        else
                        {
                            <span class="muted">@L.GetString("platform.modules.stateUnavailable", m.State)</span>
                        }
                        <BitButton Color="BitColor.Info" Variant="BitVariant.Text" IconName="@BitIconName.History"
                                   Title="@L["platform.modules.versionHistory"]"
                                   OnClick="@(() => OpenVersionsAsync(m))" AriaLabel="@L["platform.modules.versionHistory"]" />
                        <PermissionView Code="module.download">
                            <BitButton Color="BitColor.Info" Variant="BitVariant.Text" IconName="@BitIconName.Download"
                                       Title="@L["platform.modules.downloadZipTitle"]" AriaLabel="@L["platform.modules.downloadLabel"]"
                                       OnClick="@(() => DownloadAsync(m))" Disabled="@_downloading.Contains(m.Id)" />
                        </PermissionView>
                    </div>
                </article>
            }
        </div>
    }
}

@* 上传模块弹框：选择 .zip → ApiHost 归档至 S3/MinIO + 解压安装 *@
<BlazorBoilerplateModal @bind-IsOpen="_uploadOpen" Title="@L["platform.modules.upload"]"
                        OkText="@L["platform.modules.uploadAndInstall"]" Disabled="@(_uploadFile is null)"
                        OnOk="UploadAsyncAsync" CloseOnBackdrop="false">
    <div class="upload-drop">
        <InputFile OnChange="OnFileSelected" accept=".zip" class="upload-input" aria-label="@L["platform.modules.selectZipLabel"]" />
        <AppIcon Name="Upload" />
        <strong>@(_uploadHint ?? L["platform.modules.clickSelectZip"])</strong>
        <span class="muted">@L["platform.modules.uploadDesc"]</span>
    </div>
</BlazorBoilerplateModal>

@* 开发打包弹框：选源码工程 → dotnet build Release → 组包 → 直接下载 .zip（可再上传安装） *@
<BlazorBoilerplateModal @bind-IsOpen="_packOpen" Title="@L["platform.modules.pack"]"
                        OkText="@L["platform.modules.packAndDownload"]" Disabled="@(_packBusy || string.IsNullOrWhiteSpace(_packSource))"
                        OnOk="PackAndDownloadAsync" CloseOnBackdrop="false">
    <div class="id-form">
        @if (_packSources.Count == 0)
        {
            <BitText Class="muted">@L["platform.modules.noSourceProjects"]</BitText>
        }
        else
        {
            <BitDropdown Label="@L["platform.modules.sourceProjectLabel"]" @bind-Value="_packSource" Items="@_packSources" />
        }
        <BitText Class="muted">@L["platform.modules.packDesc"]</BitText>
    </div>
</BlazorBoilerplateModal>

@* 版本历史弹框：列出全部版本，可切换激活版本 *@
<BlazorBoilerplateModal @bind-IsOpen="_versionsOpen" Title="@L.GetString("platform.modules.versionHistoryTitle", _versionsModuleName)"
                        OkText="@L["platform.common.close"]" ShowCancel="false">
    <div class="versions-list">
        @if (_versions.Count == 0)
        {
            <span class="muted">@L["platform.modules.loadingVersions"]</span>
        }
        else
        {
            @foreach (var v in _versions)
            {
                var busyKey = $"{_versionsModuleId}@{v.Version}";
                <div class="version-row @(v.IsActive ? "is-active" : "")">
                    <div class="version-info">
                        <strong>v@(v.Version)</strong>
                        @if (v.IsActive)
                        {
                            <span class="module-chip info">@L["platform.modules.currentRunning"]</span>
                        }
                        <span class="muted">@v.State</span>
                        @if (v.LoadedAtUtc is { } loaded)
                        {
                            <span class="muted">@L.GetString("platform.modules.loadedAt", loaded.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</span>
                        }
                        @if (v.Error is not null)
                        {
                            <span class="version-error">@v.Error</span>
                        }
                    </div>
                    @if (!v.IsActive && v.State is ModuleState.Installed or ModuleState.Uninstalled or ModuleState.Disabled)
                    {
                        <PermissionView Code="module.load">
                            <BitButton Color="BitColor.Primary" Variant="BitVariant.Outline"
                                       OnClick="@(() => SwitchVersionAsync(v.Version))"
                                       Disabled="@_versionBusy.Contains(busyKey)">
                                @(_versionBusy.Contains(busyKey) ? L["platform.modules.switching"] : L["platform.modules.switchToVersion"])
                            </BitButton>
                        </PermissionView>
                    }
                </div>
            }
        }
    </div>
</BlazorBoilerplateModal>

@code {
    private List<ModuleDescriptor> _modules = [];
    private bool _loading = true;
    private string? _loadError;
    private readonly HashSet<string> _busy = [];
    private bool _loadAllBusy;
    private string _search = string.Empty;

    private int RunningCount => _modules.Count(m => m.State == ModuleState.Running);
    private int EssentialCount => _modules.Count(m => m.IsEssential);

    private IEnumerable<ModuleDescriptor> FilteredModules =>
        string.IsNullOrWhiteSpace(_search)
            ? _modules
            : _modules.Where(m => $"{m.Name}|{m.Id}|{m.Publisher}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        await LoadPackInfoAsync();
    }

    private async Task RefreshAsync()
    {
        _loadError = null;
        try
        {
            _modules = (await Api.GetModulesAsync()).OrderBy(m => m.Order).ThenBy(m => m.Name).ToList();
            await LoadVersionItemsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "加载模块列表失败");
            _loadError = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    // ---- 卡片内版本下拉（VersionCount > 1 时显示）----

    private Dictionary<string, List<BitDropdownItem<string>>> _versionItems = [];

    private async Task LoadVersionItemsAsync()
    {
        _versionItems = [];
        foreach (var m in _modules.Where(x => x.VersionCount > 1))
        {
            try
            {
                var versions = await Api.GetModuleVersionsAsync(m.Id);
                _versionItems[m.Id] = versions
                    .OrderByDescending(v => v.Version, StringComparer.OrdinalIgnoreCase)
                    .Select(v => new BitDropdownItem<string> { Text = $"v{v.Version}", Value = v.Version })
                    .ToList();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "加载模块 {Id} 版本清单失败", m.Id);
            }
        }
    }

    private async Task SwitchCardVersionAsync(string id, string? version)
    {
        if (string.IsNullOrWhiteSpace(version)) return;
        _busy.Add(id);
        StateHasChanged();
        try
        {
            var descriptor = await Api.LoadModuleAsync(id, version);
            await ModuleCatalog.RefreshModuleAsync(id); // 运行时注入新版本前端程序集
            Toast.Success(L.GetString("platform.modules.toast.switched", descriptor.DisplayTitle, version));
            await RefreshAsync();
            NavRefresh.Notify();
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.modules.toast.switchFailed", version, ex.Message));
            await RefreshAsync();
        }
        finally
        {
            _busy.Remove(id);
            StateHasChanged();
        }
    }

    private async Task LoadAsync(string id)
    {
        _busy.Add(id);
        try
        {
            var descriptor = await Api.LoadModuleAsync(id);
            await ModuleCatalog.RefreshModuleAsync(id); // 运行时注入前端程序集
            Toast.Success(L.GetString("platform.modules.toast.loaded", descriptor.Name));
            await RefreshAsync();
            NavRefresh.Notify();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            Toast.Error(L.GetString("platform.modules.toast.loadFailed", id, ex.Message));
        }
        finally
        {
            _busy.Remove(id);
        }
    }

    private async Task UnloadAsync(string id)
    {
        _busy.Add(id);
        try
        {
            await Api.UnloadModuleAsync(id);
            Toast.Success(L.GetString("platform.modules.toast.unloaded", id));
            await RefreshAsync();
            NavRefresh.Notify();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            Toast.Error(L.GetString("platform.modules.toast.unloadFailed", id, ex.Message));
        }
        finally
        {
            _busy.Remove(id);
        }
    }

    private async Task LoadAllAsync()
    {
        _loadAllBusy = true;
        try
        {
            var result = await Api.LoadAllModulesAsync();
            var running = result.Count(m => m.State == ModuleState.Running);
            Toast.Success(L.GetString("platform.modules.toast.loadAllSuccess", running, result.Count));
            _modules = result.OrderBy(m => m.Order).ThenBy(m => m.Name).ToList();
            NavRefresh.Notify();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            Toast.Error(L.GetString("platform.modules.toast.loadAllFailed", ex.Message));
        }
        finally
        {
            _loadAllBusy = false;
            StateHasChanged();
        }
    }

    // ---- 开发打包（ApiHost Development 环境启用）----

    private bool _packEnabled;
    private bool _packOpen;
    private string? _packSource;
    private List<BitDropdownItem<string>> _packSources = [];
    private Dictionary<string, ModuleSourceDto> _packSourceMap = [];
    private bool _packBusy;

    private async Task LoadPackInfoAsync()
    {
        try
        {
            var info = await Api.GetPackInfoAsync();
            _packEnabled = info.Enabled;
            _packSourceMap = info.Sources.ToDictionary(s => s.Name, StringComparer.OrdinalIgnoreCase);
            _packSources = info.Sources
                .Select(s => new BitDropdownItem<string> { Text = $"{s.Name}（{s.Id} v{s.Version}）", Value = s.Name })
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "读取打包能力信息失败");
            _packEnabled = false;
        }
    }

    private async Task PackAndDownloadAsync()
    {
        if (string.IsNullOrWhiteSpace(_packSource)) return;
        _packBusy = true;
        StateHasChanged();
        try
        {
            var stream = await Api.PackModuleAsync(_packSource);
            // 命名与卡片「下载」一致：{id}-{version}.zip（如 catalog-1.0.0.zip）。
            var source = _packSourceMap.GetValueOrDefault(_packSource);
            var fileName = $"{source?.Id ?? _packSource}-{source?.Version ?? "0"}.zip";
            // 与下载模块包同理：Stream 必须包 DotNetStreamReference 再交给 JS interop。
            using var streamRef = new DotNetStreamReference(stream: stream, leaveOpen: false);
            await JS.InvokeVoidAsync("blazorDownloadFile", fileName, "application/zip", streamRef);
            Toast.Success(L.GetString("platform.modules.toast.packed", _packSource, fileName));
            _packOpen = false;
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.modules.toast.packFailed", ex.Message));
        }
        finally
        {
            _packBusy = false;
            StateHasChanged();
        }
    }

    // ---- 上传模块（S3/MinIO 归档 + 安装）----

    private bool _uploadOpen;
    private IBrowserFile? _uploadFile;
    private string? _uploadHint;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _uploadFile = e.File;
        if (!_uploadFile.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
        {
            _uploadHint = L.GetString("platform.modules.uploadNotZip", _uploadFile.Name);
            return;
        }
        _uploadHint = $"{_uploadFile.Name}（{_uploadFile.Size / 1024.0:F0} KB）";
    }

    private async Task UploadAsyncAsync()
    {
        if (_uploadFile is null || !_uploadFile.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
        {
            Toast.Warning(L["platform.modules.selectZipWarning"]);
            return;
        }
        try
        {
            await using var stream = _uploadFile.OpenReadStream(maxAllowedSize: 256 * 1024 * 1024);
            var result = await Api.UploadModuleAsync(stream, _uploadFile.Name);
            await ModuleCatalog.RefreshModuleAsync(result.Descriptor.Id); // 运行时注入新版本前端程序集
            Toast.Success(L.GetString("platform.modules.toast.uploaded", result.Descriptor.Name, result.Descriptor.Version));
            _uploadOpen = false;
            _uploadFile = null;
            _uploadHint = null;
            await RefreshAsync();
            NavRefresh.Notify();
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.modules.toast.uploadFailed", ex.Message));
        }
    }

    // ---- 下载模块包（.zip）----

    private readonly HashSet<string> _downloading = [];

    private async Task DownloadAsync(ModuleDescriptor m)
    {
        _downloading.Add(m.Id);
        StateHasChanged();
        try
        {
            var stream = await Api.DownloadModuleAsync(m.Id);
            var fileName = $"{m.Id}-{m.Version}.zip";
            // Stream 参数必须包 DotNetStreamReference，否则会被 JS interop 的 JSON 序列化器
            // 当普通对象处理（读 ReadTimeout 抛 "Timeouts are not supported on this stream."）。
            using var streamRef = new DotNetStreamReference(stream: stream, leaveOpen: false);
            await JS.InvokeVoidAsync("blazorDownloadFile", fileName, "application/zip", streamRef);
            Toast.Success(L.GetString("platform.modules.toast.downloading", fileName));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "下载模块包失败 {Id}", m.Id);
            Toast.Error(L.GetString("platform.modules.toast.downloadFailed", ex.Message));
        }
        finally
        {
            _downloading.Remove(m.Id);
            StateHasChanged();
        }
    }

    // ---- 版本历史与版本切换 ----

    private bool _versionsOpen;
    private string? _versionsModuleId;
    private string _versionsModuleName = string.Empty;
    private List<ModuleVersionDto> _versions = [];
    private readonly HashSet<string> _versionBusy = [];

    private async Task OpenVersionsAsync(ModuleDescriptor m)
    {
        _versionsModuleId = m.Id;
        _versionsModuleName = m.Name;
        _versionsOpen = true;
        await LoadVersionsAsync();
    }

    private async Task LoadVersionsAsync()
    {
        try
        {
            _versions = (await Api.GetModuleVersionsAsync(_versionsModuleId!)).ToList();
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.modules.toast.loadVersionsFailed", ex.Message));
        }
    }

    private async Task SwitchVersionAsync(string version)
    {
        var key = $"{_versionsModuleId}@{version}";
        _versionBusy.Add(key);
        try
        {
            var descriptor = await Api.LoadModuleAsync(_versionsModuleId!, version);
            await ModuleCatalog.RefreshModuleAsync(_versionsModuleId!); // 运行时注入新版本前端程序集
            Toast.Success(L.GetString("platform.modules.toast.versionSwitched", descriptor.Name, version));
            _versionsOpen = false; // 切换成功后关闭版本历史弹框
            await RefreshAsync();
            NavRefresh.Notify();
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.modules.toast.switchFailed", version, ex.Message));
        }
        finally
        {
            _versionBusy.Remove(key);
            StateHasChanged();
        }
    }

    private static string CardClass(ModuleDescriptor m)
    {
        var state = m.State switch
        {
            ModuleState.Running => "is-running",
            ModuleState.Failed or ModuleState.Quarantined => "is-failed",
            _ => string.Empty
        };
        return m.IsEssential ? $"{state} is-essential".Trim() : state;
    }

    private static string ModuleIcon(string id) =>
        id.Contains("identity", StringComparison.OrdinalIgnoreCase) ? "Shield" :
        id.Contains("catalog", StringComparison.OrdinalIgnoreCase) ? "Shop" :
        id.Contains("attachment", StringComparison.OrdinalIgnoreCase) ? "Attach" : "Puzzle";

    private static BitColor StateColor(ModuleState state) => state switch
    {
        ModuleState.Running => BitColor.Success,
        ModuleState.Failed or ModuleState.Quarantined => BitColor.Error,
        ModuleState.Loading or ModuleState.Unloading or ModuleState.Draining => BitColor.Warning,
        _ => BitColor.Info
    };

    private string StateText(ModuleState state) => state switch
    {
        ModuleState.Running => L["platform.modules.state.running"],
        ModuleState.Installed => L["platform.modules.state.installed"],
        ModuleState.Disabled => L["platform.modules.state.disabled"],
        ModuleState.Loading => L["platform.modules.state.loading"],
        ModuleState.Unloading or ModuleState.Draining => L["platform.modules.state.unloading"],
        ModuleState.Updating => L["platform.modules.state.updating"],
        ModuleState.Failed => L["platform.modules.state.failed"],
        ModuleState.Quarantined => L["platform.modules.state.quarantined"],
        _ => state.ToString()
    };

    private static string StateIcon(ModuleState state) => state switch
    {
        ModuleState.Running => BitIconName.CompletedSolid,
        ModuleState.Installed or ModuleState.Disabled => BitIconName.Pause,
        ModuleState.Failed or ModuleState.Quarantined => BitIconName.ErrorBadge,
        ModuleState.Loading or ModuleState.Unloading or ModuleState.Draining or ModuleState.Updating => BitIconName.Sync,
        _ => BitIconName.Info
    };
}
