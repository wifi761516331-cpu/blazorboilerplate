@page "/system/settings"
@page "/system/settings/{Section?}"
@rendermode RenderMode.InteractiveServer
@using BlazorBoilerplate.Shared.Features.SystemSettings
@inject BlazorBoilerplateApiClient Api
@inject SystemSettingsState SysState
@inject UserPreferences Preferences
@inject AccountState Account
@inject ToastService Toast
@inject ILocalizationService L

<style>
    .sys-settings-shell {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 0.5rem 0 2.5rem;
    }

    .sys-settings-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
    }

    .sys-settings-header-text {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .sys-settings-header-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .sys-section-body {
        padding: 0.75rem 0.25rem 1.25rem;
    }

    .sys-settings-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.15rem 1.5rem;
    }

    .sys-settings-grid .sys-full {
        grid-column: 1 / -1;
    }

    .sys-settings-grid .bit-txt,
    .sys-settings-grid .bit-txt-wrapper,
    .sys-settings-grid .bit-num,
    .sys-settings-grid .bit-drp {
        width: 100%;
    }

    .sys-test-mail-row {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        flex-wrap: wrap;
        padding: 1rem 1.15rem;
        border-radius: 8px;
        background: var(--bit-clr-bg-pri, rgba(127, 127, 127, 0.06));
        border: 1px solid var(--bb-brd-ter, rgba(127, 127, 127, 0.16));
    }

    .sys-settings-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--bb-brd-ter, rgba(127, 127, 127, 0.18));
    }

    @@media (max-width: 760px) {
        .sys-settings-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="sys-settings-shell">
    <div class="sys-settings-header">
        <BitText Typography="BitTypography.H5">@L["platform.header.systemSettings.title"]</BitText>
    </div>

    @if (_loading)
    {
        <BitStack Gap="0.75rem">
            <BitShimmer Height="3.5rem" Width="100%" />
            <BitShimmer Height="3.5rem" Width="100%" />
            <BitShimmer Height="3.5rem" Width="100%" />
            <BitShimmer Height="3.5rem" Width="100%" />
            <BitShimmer Height="3.5rem" Width="100%" />
        </BitStack>
    }
    else if (_loadError is not null)
    {
        <BitCallout Class="page-callout error">@_loadError</BitCallout>
    }
    else
    {
        <BitAccordionList TItem="BitAccordionListOption"
                          HeadingLevel="2"
                          @bind-ExpandedKey="_expandedSection"
                          ScrollIntoViewOnExpand
                          Background="BitColorKind.Secondary"
                          Border="BitColorKind.Transparent">

            <BitAccordionListOption Key="general"
                                    Title="@L["platform.sysSettings.general.title"]"
                                    Description="@L["platform.sysSettings.general.desc"]">
                <div class="sys-section-body">
                    <div class="sys-settings-grid">
                        <BitTextField @bind-Value="_model.SystemName"
                                      Label="@L["platform.setup.systemName"]"
                                      Placeholder="@L["platform.sysSettings.general.systemNamePlaceholder"]"
                                      Required />

                        <BitTextField @bind-Value="_model.FooterText"
                                      Label="@L["platform.sysSettings.general.footerText"]"
                                      Placeholder="@L["platform.sysSettings.general.footerPlaceholder"]" />

                        <BitDropdown @bind-Value="_model.DefaultCulture"
                                     Label="@L["platform.sysSettings.general.defaultCulture"]"
                                     Items="_cultureItems" />

                        <BitDropdown @bind-Value="_model.DefaultTimeZone"
                                     Label="@L["platform.sysSettings.general.defaultTimeZone"]"
                                     Items="TimeZoneItems" />

                        <div class="sys-full">
                            <BitTextField @bind-Value="_model.Notice"
                                          Label="@L["platform.sysSettings.general.notice"]"
                                          Multiline
                                          Rows="3"
                                          Placeholder="@L["platform.sysSettings.general.noticePlaceholder"]" />
                        </div>
                    </div>
                </div>
            </BitAccordionListOption>

            <BitAccordionListOption Key="security"
                                    Title="@L["platform.sysSettings.security.title"]"
                                    Description="@L["platform.sysSettings.security.desc"]">
                <div class="sys-section-body">
                    <div class="sys-settings-grid">
                        <BitToggle @bind-Value="_model.RegisterEnabled"
                                   Label="@L["platform.sysSettings.security.registerEnabled"]"
                                   OnText="@L["platform.sysSettings.toggle.enabled"]"
                                   OffText="@L["platform.sysSettings.toggle.disabled"]" />

                        <BitToggle @bind-Value="_model.EmailVerificationRequired"
                                   Label="@L["platform.sysSettings.security.emailVerification"]"
                                   OnText="@L["platform.sysSettings.security.required"]"
                                   OffText="@L["platform.sysSettings.security.notRequired"]" />

                        <BitNumberField @bind-Value="_model.PasswordMinLength"
                                        Label="@L["platform.sysSettings.security.passwordMinLength"]"
                                        Min="4"
                                        Max="64"
                                        ShowButtons />

                        <BitNumberField @bind-Value="_model.MaxSessionsPerUser"
                                        Label="@L["platform.sysSettings.security.maxSessions"]"
                                        Min="1"
                                        Max="100"
                                        ShowButtons />

                        <BitNumberField @bind-Value="_model.AccessTokenMinutes"
                                        Label="@L["platform.sysSettings.security.accessTokenMinutes"]"
                                        Min="5"
                                        Max="43200"
                                        ShowButtons />
                    </div>
                </div>
            </BitAccordionListOption>

            <BitAccordionListOption Key="smtp"
                                    Title="@L["platform.sysSettings.smtp.title"]"
                                    Description="@L["platform.sysSettings.smtp.desc"]">
                <div class="sys-section-body">
                    <div class="sys-settings-grid">
                        <BitTextField @bind-Value="_model.SmtpHost"
                                      Label="@L["platform.sysSettings.smtp.host"]"
                                      Placeholder="@L["platform.sysSettings.smtp.hostPlaceholder"]" />

                        <BitNumberField @bind-Value="_model.SmtpPort"
                                        Label="@L["platform.sysSettings.smtp.port"]"
                                        Min="1"
                                        Max="65535"
                                        ShowButtons />

                        <BitTextField @bind-Value="_model.SmtpUserName"
                                      Label="@L["platform.sysSettings.smtp.userName"]"
                                      Placeholder="@L["platform.sysSettings.smtp.userNamePlaceholder"]" />

                        <BitTextField @bind-Value="_model.SmtpPassword"
                                      Label="@L["platform.sysSettings.smtp.password"]"
                                      Type="BitInputType.Password"
                                      CanRevealPassword
                                      Placeholder="@L["platform.sysSettings.keepUnchangedPlaceholder"]" />

                        <BitTextField @bind-Value="_model.SmtpFromEmail"
                                      Label="@L["platform.sysSettings.smtp.fromEmail"]"
                                      Placeholder="noreply@example.com" />

                        <BitTextField @bind-Value="_model.SmtpFromName"
                                      Label="@L["platform.sysSettings.smtp.fromName"]"
                                      Placeholder="BlazorBoilerplate" />

                        <BitToggle @bind-Value="_model.SmtpEnableSsl"
                                   Label="@L["platform.sysSettings.smtp.enableSsl"]"
                                   OnText="@L["platform.sysSettings.smtp.sslOn"]"
                                   OffText="@L["platform.sysSettings.smtp.sslOff"]" />

                        <div class="sys-full sys-test-mail-row">
                            <div style="flex:1;min-width:240px;">
                                <BitTextField @bind-Value="_testEmailTo"
                                              Label="@L["platform.sysSettings.smtp.testTo"]"
                                              Placeholder="@L["platform.sysSettings.smtp.testToPlaceholder"]" />
                            </div>
                            <PermissionGate Code="system.settings.update">
                                <BitButton Variant="BitVariant.Outline"
                                           IconName="@BitIconName.Send"
                                           IsLoading="_sendingTest"
                                           OnClick="SendTestEmailAsync">
                                    @L["platform.notifications.sendTestEmail"]
                                </BitButton>
                            </PermissionGate>
                        </div>
                    </div>
                </div>
            </BitAccordionListOption>

            <BitAccordionListOption Key="storage"
                                    Title="@L["platform.sysSettings.storage.title"]"
                                    Description="@L["platform.sysSettings.storage.desc"]">
                <div class="sys-section-body">
                    <div class="sys-settings-grid">
                        <BitDropdown @bind-Value="_model.StorageProvider"
                                     Label="@L["platform.sysSettings.storage.provider"]"
                                     Items="StorageItems" />

                        <BitNumberField @bind-Value="_model.MaxUploadSizeMb"
                                        Label="@L["platform.sysSettings.storage.maxUploadMb"]"
                                        Min="1"
                                        Max="512"
                                        ShowButtons />

                        @if (_model.StorageProvider == "S3")
                        {
                            <BitTextField @bind-Value="_model.S3Endpoint"
                                          Label="S3 / MinIO Endpoint"
                                          Placeholder="http://127.0.0.1:9000" />

                            <BitTextField @bind-Value="_model.S3Bucket"
                                          Label="@L["platform.sysSettings.storage.bucket"]"
                                          Placeholder="blazorboilerplate-modules" />

                            <BitTextField @bind-Value="_model.S3Region"
                                          Label="Region"
                                          Placeholder="us-east-1" />

                            <BitTextField @bind-Value="_model.S3AccessKey"
                                          Label="AccessKey" />

                            <BitTextField @bind-Value="_model.S3SecretKey"
                                          Label="SecretKey"
                                          Type="BitInputType.Password"
                                          CanRevealPassword
                                          Placeholder="@L["platform.sysSettings.keepUnchangedPlaceholder"]" />
                        }

                        <div class="sys-full">
                            <BitTextField @bind-Value="_model.AllowedExtensions"
                                          Label="@L["platform.sysSettings.storage.allowedExt"]"
                                          Placeholder=".jpg,.jpeg,.png,.pdf,.zip" />
                        </div>
                    </div>
                </div>
            </BitAccordionListOption>

            <BitAccordionListOption Key="runtime"
                                    Title="@L["platform.sysSettings.runtime.title"]"
                                    Description="@L["platform.sysSettings.runtime.desc"]">
                <div class="sys-section-body">
                    <div class="sys-settings-grid">
                        <BitToggle @bind-Value="_model.AutoLoadOnStartup"
                                   Label="@L["platform.sysSettings.runtime.autoLoad"]"
                                   OnText="@L["platform.sysSettings.runtime.autoLoadOn"]"
                                   OffText="@L["platform.sysSettings.runtime.autoLoadOff"]" />

                        <BitToggle @bind-Value="_model.VerifyChecksum"
                                   Label="@L["platform.sysSettings.runtime.verifyChecksum"]"
                                   OnText="@L["platform.sysSettings.runtime.verifyOn"]"
                                   OffText="@L["platform.sysSettings.runtime.verifyOff"]" />

                        <BitNumberField @bind-Value="_model.DrainTimeoutSeconds"
                                        Label="@L["platform.sysSettings.runtime.drainTimeout"]"
                                        Min="1"
                                        Max="300"
                                        ShowButtons />
                    </div>
                </div>
            </BitAccordionListOption>

        </BitAccordionList>

        <div class="sys-settings-footer">
            @if (_model.UpdatedAtUtc is { } updatedAt)
            {
                <BitText Typography="BitTypography.Caption1" Color="BitColor.SecondaryForeground">
                    @L.GetString("platform.sysSettings.lastSaved", updatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))
                </BitText>
                <BitSpacer />
            }
            <BitButton Variant="BitVariant.Outline"
                       IconName="@BitIconName.Refresh"
                       Disabled="_saving"
                       OnClick="LoadAsync">
                @L["platform.sysSettings.resetRefresh"]
            </BitButton>
            <PermissionGate Code="system.settings.update">
                <BitButton Color="BitColor.Primary"
                           IconName="@BitIconName.Save"
                           IsLoading="_saving"
                           OnClick="SaveAsync">
                    @L["platform.sysSettings.save"]
                </BitButton>
            </PermissionGate>
        </div>
    }
</div>

@code {
    [Parameter] public string? Section { get; set; }

    private string? _expandedSection = "general";
    private bool _loading = true;
    private bool _saving;
    private bool _sendingTest;
    private string? _loadError;
    private string _testEmailTo = string.Empty;
    private SystemSettingsDto _model = new();

    private readonly List<BitDropdownItem<string>> _cultureItems =
    [
        new() { Text = "简体中文 (zh-CN)", Value = "zh-CN" },
        new() { Text = "English (en-US)", Value = "en-US" },
        new() { Text = "日本語 (ja-JP)", Value = "ja-JP" },
        new() { Text = "Deutsch (de-DE)", Value = "de-DE" }
    ];

    private List<BitDropdownItem<string>> TimeZoneItems =>
    [
        new() { Text = L["platform.sysSettings.tz.shanghai"], Value = "Asia/Shanghai" },
        new() { Text = "(UTC+00:00) UTC", Value = "UTC" },
        new() { Text = L["platform.sysSettings.tz.tokyo"], Value = "Asia/Tokyo" },
        new() { Text = L["platform.sysSettings.tz.london"], Value = "Europe/London" },
        new() { Text = L["platform.sysSettings.tz.berlin"], Value = "Europe/Berlin" },
        new() { Text = L["platform.sysSettings.tz.newYork"], Value = "America/New_York" },
        new() { Text = L["platform.sysSettings.tz.sydney"], Value = "Australia/Sydney" }
    ];

    private List<BitDropdownItem<string>> StorageItems =>
    [
        new() { Text = L["platform.sysSettings.storage.local"], Value = "Local" },
        new() { Text = L["platform.sysSettings.storage.s3"], Value = "S3" }
    ];

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Section))
            _expandedSection = Section.Trim().ToLowerInvariant();
    }

    protected override async Task OnInitializedAsync()
    {
        await Account.EnsureLoadedAsync();
        if (string.IsNullOrWhiteSpace(_testEmailTo) && Account.CurrentUser is { } user)
            _testEmailTo = user.Email;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _model = await Api.GetSystemSettingsAsync();
        }
        catch (Exception ex)
        {
            _loadError = L.GetString("platform.sysSettings.error.loadFailed", ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        var prevCulture = SysState.Public.DefaultCulture;
        var prevTimeZone = SysState.Public.DefaultTimeZone;
        try
        {
            _model = await Api.UpdateSystemSettingsAsync(_model);
            SysState.ApplyUpdated(_model);

            // 若当前用户仍处于旧的系统默认语言/时区，同步跟随新的系统默认值
            var prefs = await Preferences.GetAsync();
            var nextCulture = string.Equals(prefs.Culture, prevCulture, StringComparison.OrdinalIgnoreCase)
                ? _model.DefaultCulture
                : prefs.Culture;
            var nextTimeZone = string.Equals(prefs.TimeZone, prevTimeZone, StringComparison.OrdinalIgnoreCase)
                ? _model.DefaultTimeZone
                : prefs.TimeZone;
            if (nextCulture != prefs.Culture || nextTimeZone != prefs.TimeZone)
                await Preferences.SetAsync(prefs with { Culture = nextCulture, TimeZone = nextTimeZone });

            Toast.Success(L["platform.sysSettings.toast.saved"]);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.sysSettings.toast.saveFailed", ex.Message));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SendTestEmailAsync()
    {
        if (string.IsNullOrWhiteSpace(_testEmailTo) || !_testEmailTo.Contains('@'))
        {
            Toast.Warning(L["platform.sysSettings.toast.invalidTestEmail"]);
            return;
        }

        _sendingTest = true;
        try
        {
            await Api.SendTestSmtpEmailAsync(_testEmailTo.Trim());
            Toast.Success(L.GetString("platform.notifications.toast.testEmailSent", _testEmailTo.Trim()));
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.notifications.toast.sendTestEmailFailed", ex.Message));
        }
        finally
        {
            _sendingTest = false;
        }
    }
}
