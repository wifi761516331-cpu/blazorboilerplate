@page "/"
@rendermode RenderMode.InteractiveServer
@inject BlazorBoilerplateApiClient Api
@inject ILogger<Home> Logger

@* 页面骨架移植自 Bluebird DashboardPage / OverallStatusCard / 各 Widget：
   <section> + 4 统计卡 + 6 列 Widget 网格。
   前 3 张统计卡仍取真实 ApiHost 数据，其余 Widget 使用 DashboardMockData（后续接接口时替换该静态源）。 *@
<section>
    <div class="bb-stat-row">
        <div class="bb-stat">
            <div class="bb-stat-icon"><AppIcon Name="Info" /></div>
            <div class="bb-stat-body">
                <p class="bb-stat-value">@(_status?.Mode ?? "—")</p>
                <span class="bb-stat-label">运行模式</span>
            </div>
        </div>
        <div class="bb-stat">
            <div class="bb-stat-icon"><AppIcon Name="Puzzle" /></div>
            <div class="bb-stat-body">
                <p class="bb-stat-value">@_moduleCount</p>
                <span class="bb-stat-label">已注册模块</span>
            </div>
        </div>
        <div class="bb-stat">
            <div class="bb-stat-icon"><AppIcon Name="Shop" /></div>
            <div class="bb-stat-body">
                <p class="bb-stat-value">@(_productCount?.ToString() ?? "—")</p>
                <span class="bb-stat-label">商品记录 / OData</span>
            </div>
        </div>
        <div class="bb-stat">
            <div class="bb-stat-icon"><AppIcon Name="People" /></div>
            <div class="bb-stat-body">
                <p class="bb-stat-value">@DashboardMockData.MockUserCount</p>
                <span class="bb-stat-label">活跃用户（mock）</span>
            </div>
        </div>
    </div>

    @if (_loadError is not null)
    {
        <div class="page-callout error">无法连接 ApiHost：@_loadError（下方 Widget 使用 mock 数据展示）</div>
    }

    <div class="bb-widgets">
        <div class="bb-widget span-4">
            <div class="bb-widget-head">
                <h2 class="bb-widget-title">各分类商品数量</h2>
                <span class="bb-widget-sub">mock · 近 30 天</span>
            </div>
            <div class="bb-chart">
                @{ var max = DashboardMockData.Categories.Max(c => c.Count); }
                @foreach (var c in DashboardMockData.Categories)
                {
                    <div class="bb-bar-wrap">
                        <span class="bb-bar-value">@c.Count</span>
                        <div class="bb-bar" style="height:@(c.Count * 100 / max)%;background:@c.Color"></div>
                        <span class="bb-bar-label">@c.Name</span>
                    </div>
                }
            </div>
        </div>

        <div class="bb-widget span-2">
            <div class="bb-widget-head">
                <h2 class="bb-widget-title">商品占比</h2>
                <span class="bb-widget-sub">mock</span>
            </div>
            <div class="bb-pie-row">
                <div class="bb-pie">
                    <div class="bb-pie-hole">@DashboardMockData.MockCategoryTotal</div>
                </div>
                <div class="bb-legend">
                    @foreach (var c in DashboardMockData.Categories)
                    {
                        <div class="bb-legend-item">
                            <span class="bb-swatch" style="background:@c.Color"></span>
                            <span>@c.Name · @c.Count</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="bb-widget span-3">
            <div class="bb-widget-head">
                <h2 class="bb-widget-title">最近活动</h2>
                <span class="bb-widget-sub">mock</span>
            </div>
            <ul class="bb-activity">
                @foreach (var a in DashboardMockData.Activities)
                {
                    <li>
                        <span class="bb-dot"></span>
                        <span>@a.Text</span>
                        <time>@a.Time</time>
                    </li>
                }
            </ul>
        </div>

        <div class="bb-widget span-3">
            <div class="bb-widget-head">
                <h2 class="bb-widget-title">快捷入口</h2>
                <span class="bb-widget-sub">平台功能</span>
            </div>
            <div class="bb-quick">
                @foreach (var link in DashboardMockData.QuickLinks)
                {
                    <a href="@link.Href">
                        <AppIcon Name="@link.Icon" />
                        <span>@link.Text</span>
                    </a>
                }
                @* 按钮级权限示范：仅当账户具备 identity.user.update（或 "*"）时显示入口 *@
                <PermissionView Code="identity.user.update">
                    <a href="/profile">
                        <AppIcon Name="Contact" />
                        <span>个人资料</span>
                    </a>
                </PermissionView>
            </div>
        </div>

        <div class="bb-widget span-6">
            <div class="bb-widget-head">
                <h2 class="bb-widget-title">关于 BlazorBoilerplate 平台</h2>
                <span class="bb-widget-sub">.NET 10 · Bit.BlazorUI · Dynamic Module Runtime</span>
            </div>
            <p class="muted">
                基于 .NET 10、BitPlatform 与 Bit.BlazorUI 的模块化单体（Modular Monolith）演示。
                模块同时承载后端 Endpoint / Service 与前端 Razor 页面 / 菜单，按 DisplayOrder + 依赖拓扑排序加载，
                除必要模块外均可动态加载与卸载，端点随模块上线或下线，无需重启宿主。
            </p>
            <div class="row">
                <a class="bit-link" href="/modules">打开模块管理 →</a>
                <a class="bit-link" href="/catalog">打开商品目录 →</a>
            </div>
        </div>
    </div>
</section>

@code {
    private SetupStatus? _status;
    private int _moduleCount;
    private int? _productCount;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _status = await Api.GetSetupStatusAsync();
            _moduleCount = (await Api.GetModulesAsync()).Count;

            try
            {
                var page = await Api.GetODataAsync<System.Text.Json.JsonElement>(
                    "api/catalog/products", new BlazorBoilerplate.Application.OData.ODataQuery { Top = 1, Count = true });
                _productCount = (int?)page.Count;
            }
            catch
            {
                _productCount = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Home 页面加载失败");
            _loadError = ex.Message;
        }
    }
}
