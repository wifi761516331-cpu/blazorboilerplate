@page "/setup"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@layout IdentityLayout
@rendermode RenderMode.InteractiveServer
@inject BlazorBoilerplateApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Setup> Logger
@inject ILocalizationService L
@inject FrontendLocalizationService FrontendLoc

@* 独立的启动配置页：通过 @layout 使用 IdentityLayout，不挂在 MainLayout / AppShell 之下。 *@
<div class="auth-head">
    <h1 class="auth-title">@L["platform.setup.title"]</h1>
    <p class="auth-sub">@L["platform.setup.subtitle"]</p>
</div>

@if (_status is { Installed: true })
{
    <div class="auth-msg">@L["platform.setup.alreadyInstalled"]</div>
}
else
{
    <div class="setup-form">
        <BitTextField Label="@L["platform.setup.adminEmail"]" @bind-Value="_email" Placeholder="admin@example.com" />
        <BitTextField Label="@L["platform.setup.adminPassword"]" @bind-Value="_password" Placeholder="@L["platform.setup.passwordPlaceholder"]" />
        <BitTextField Label="@L["platform.setup.systemName"]" @bind-Value="_systemName" Placeholder="BlazorBoilerplate Platform" />

        <BitDropdown Label="@L["platform.setup.dbProvider"]"
                     @bind-Value="_provider"
                     Items="ProviderItems" />

        @if (_provider == "PostgreSQL")
        {
            <BitTextField Label="@L["platform.setup.pgConn"]" @bind-Value="_postgreSql"
                          Placeholder="Host=localhost;Port=5432;Database=blazorboilerplate;Username=...;Password=..." />
        }
        else if (_provider == "MySQL")
        {
            <BitTextField Label="@L["platform.setup.mysqlConn"]" @bind-Value="_mySql"
                          Placeholder="Server=localhost;Port=3306;Database=blazorboilerplate;Uid=root;Pwd=...;" />
        }
        else if (_provider == "MSSQL")
        {
            <BitTextField Label="@L["platform.setup.mssqlConn"]" @bind-Value="_mssql"
                          Placeholder="Server=localhost;Database=blazorboilerplate;User Id=sa;Password=...;MultipleActiveResultSets=True;Encrypt=False;" />
        }
        else
        {
            <BitTextField Label="@L["platform.setup.sqliteConn"]" @bind-Value="_sqlite"
                          Placeholder="Data Source=data/blazorboilerplate.db" />
        }

        <BitTextField Label="@L["platform.setup.redisConn"]" @bind-Value="_redis"
                      Placeholder="localhost:6379"
                      HelpText="@L["platform.setup.redisHelp"]" />
    </div>

    @if (_error is not null)
    {
        <div class="auth-msg error">@_error</div>
    }

    <div style="margin-top:1.25rem">
        <BitButton Color="BitColor.Primary" OnClick="SubmitAsync" Disabled="@_submitting">
            @(_submitting ? L["platform.setup.submitting"] : L["platform.setup.submit"])
        </BitButton>
    </div>

    <p class="auth-foot">@L["platform.setup.alreadyDone"] <a class="auth-link" href="/">@L["platform.setup.backToConsole"]</a></p>
}

@code {
    private SetupStatus? _status;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string? _systemName;
    private string _provider = "PostgreSQL";
    private string? _postgreSql;
    private string? _mySql;
    private string? _mssql;
    private string? _sqlite;
    private string? _redis = "localhost:6379";
    private bool _submitting;
    private string? _error;

    private List<BitDropdownItem<string>> ProviderItems =>
    [
        new() { Text = L["platform.setup.provider.pg"], Value = "PostgreSQL" },
        new() { Text = "MySQL", Value = "MySQL" },
        new() { Text = "MSSQL (SQL Server)", Value = "MSSQL" },
        new() { Text = L["platform.setup.provider.sqlite"], Value = "SQLite" }
    ];

    protected override async Task OnInitializedAsync()
    {
        await FrontendLoc.EnsureLoadedAsync();
        // NavigateTo 置于 try/catch 之外：预渲染阶段 NavigationException 是重定向信号，不能被吞。
        SetupStatus? status;
        try
        {
            status = await Api.GetSetupStatusAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "读取安装状态失败");
            _error = L.GetString("platform.setup.error.apiHost", ex.Message);
            return;
        }

        _status = status;
        if (status.Installed)
            // 已安装时直接去登录页：跳 "/" 会先渲染后台首页，再被 MainLayout 的
            // 未登录守卫踢回 /sign-in，用户看到「先闪首页再退回登录页」。
            Navigation.NavigateTo("/sign-in");
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_email))
            {
                _error = L["platform.setup.error.emailRequired"];
                return;
            }
            if (_password.Length < 6)
            {
                _error = L["platform.setup.error.passwordMin"];
                return;
            }

            var config = new SetupConfiguration(
                _email, _password, _systemName,
                _provider,
                _provider == "PostgreSQL" ? _postgreSql : null,
                _provider == "SQLite" ? _sqlite : null,
                _redis,
                _provider == "MySQL" ? _mySql : null,
                _provider == "MSSQL" ? _mssql : null);

            _status = await Api.CompleteSetupAsync(config);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "初始化提交失败");
            _error = ex.Message;
            return;
        }
        finally
        {
            _submitting = false;
        }

        if (!_status.Installed)
        {
            _error = L["platform.setup.error.incomplete"];
            return;
        }

        // 初始化完成后直接用向导里填写的管理员账号登录，再整页跳首页。
        // 旧逻辑 NavigateTo("/") 时浏览器还没有认证 Cookie，首页必然被 MainLayout
        // 的未登录守卫踢回 /sign-in?return-url=...，形成「先闪后台首页再退回登录页」。
        // SetupInitializer 创建的管理员 UserName 固定为 "admin"（邮箱是另一个字段）。
        try
        {
            var result = await JS.InvokeAsync<LoginResult>("blazorAuth.login", new
            {
                userName = "admin",
                password = _password,
                rememberMe = true,
                tenantId = (string?)null
            });

            if (result is { Ok: true })
            {
                await JS.InvokeVoidAsync("blazorAuth.redirect", "/");
                return;
            }
        }
        catch
        {
            // 自动登录失败不阻断安装结果，回落到登录页让用户手动登录。
        }

        Navigation.NavigateTo("/sign-in");
    }

    /// <summary>blazorAuth.login 的返回结果（camelCase JSON 由 JS interop 默认值反序列化）。</summary>
    private sealed class LoginResult
    {
        public bool Ok { get; set; }
        public string? Error { get; set; }
    }
}
