@page "/profile"
@rendermode RenderMode.InteractiveServer
@using BlazorBoilerplate.Shared.Features.Attachments
@using Microsoft.AspNetCore.Components.Forms
@inject BlazorBoilerplateApiClient Api
@inject ToastService Toast
@inject AccountState Account
@inject ILocalizationService L

<div class="page-callout">
    <h1 class="page-title">@L["platform.header.profile.title"]</h1>
    <p class="muted">@L["platform.profile.subtitle"]</p>
</div>

@if (_loadError is not null)
{
    <div class="page-callout error">@_loadError</div>
}

<div class="account-page-grid">
    <section class="bb-card">
        <h2 class="section-title">@L["platform.profile.avatarTitle"]</h2>
        <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap;">
            @if (_avatarUrl is not null)
            {
                <img src="@_avatarUrl" alt="@L["platform.profile.avatarAlt"]"
                     style="width:72px;height:72px;border-radius:50%;object-fit:cover;border:1px solid var(--bb-border);" />
            }
            else
            {
                <div style="width:72px;height:72px;border-radius:50%;display:grid;place-items:center;background:var(--bb-accent-soft, #e5eefc);font-weight:700;font-size:1.25rem;">
                    @(string.IsNullOrWhiteSpace(_displayName) ? "?" : _displayName[..1].ToUpperInvariant())
                </div>
            }
            <div style="display:flex;flex-direction:column;gap:.5rem;">
                <InputFile OnChange="UploadAvatarAsync" accept=".jpg,.jpeg,.png,.webp,.gif,.bmp" disabled="@_uploadingAvatar" />
                <div style="display:flex;gap:.5rem;align-items:center;">
                    <span class="muted" style="font-size:.85rem;">@L["platform.profile.avatarHint"]</span>
                    @if (_avatarUrl is not null)
                    {
                        <button type="button" class="bb-link-btn danger" @onclick="DeleteAvatarAsync" disabled="@_uploadingAvatar">@L["platform.profile.removeAvatar"]</button>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="bb-card">
        <h2 class="section-title">@L["platform.profile.basicInfo"]</h2>
        <div class="id-form">
            <div class="auth-field">
                <label class="auth-label" for="pf-name">@L["platform.profile.displayName"]</label>
                <input id="pf-name" class="auth-input" @bind="_displayName" />
            </div>
            <div class="auth-field">
                <label class="auth-label" for="pf-email">@L["platform.profile.email"]</label>
                <input id="pf-email" class="auth-input" type="email" @bind="_email" />
            </div>
            <div class="bb-form-actions">
                <PermissionView Code="identity.user.update">
                    <button type="button" class="blazorboilerplate-btn primary" @onclick="SaveProfileAsync" disabled="@_savingProfile">
                        @(_savingProfile ? L["platform.profile.saving"] : L["platform.profile.saveProfile"])
                    </button>
                </PermissionView>
            </div>
        </div>
    </section>

    <section class="bb-card">
        <h2 class="section-title">@L["platform.profile.changePassword"]</h2>
        <div class="id-form">
            <div class="auth-field">
                <label class="auth-label" for="pf-old">@L["platform.profile.oldPassword"]</label>
                <input id="pf-old" class="auth-input" type="password" @bind="_oldPassword" />
            </div>
            <div class="auth-field">
                <label class="auth-label" for="pf-new">@L["platform.profile.newPassword"]</label>
                <input id="pf-new" class="auth-input" type="password" @bind="_newPassword" />
            </div>
            <div class="bb-form-actions">
                <PermissionView Code="identity.user.change-password">
                    <button type="button" class="blazorboilerplate-btn primary" @onclick="ChangePasswordAsync" disabled="@_savingPassword">
                        @(_savingPassword ? L["platform.profile.submitting"] : L["platform.profile.changePassword"])
                    </button>
                </PermissionView>
            </div>
        </div>
    </section>
</div>

<section class="bb-card">
    <div class="bb-card-head">
        <h2 class="section-title">@L["platform.profile.sessionsTitle"]</h2>
        <button type="button" class="blazorboilerplate-btn ghost" @onclick="LoadSessionsAsync">@L["platform.common.refresh"]</button>
    </div>
    <div class="grid-container">
        <table class="data-grid">
            <thead>
                <tr>
                    <th>@L["platform.profile.col.device"]</th>
                    <th>IP</th>
                    <th>@L["platform.accountMenu.timeZone"]</th>
                    <th>@L["platform.profile.col.startedAt"]</th>
                    <th>@L["platform.profile.col.status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (_sessions.Count == 0)
                {
                    <tr><td colspan="6" class="muted">@L["platform.profile.sessionsEmpty"]</td></tr>
                }
                @foreach (var s in _sessions)
                {
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(s.DeviceInfo) ? "—" : s.DeviceInfo)</td>
                        <td class="mono">@(string.IsNullOrWhiteSpace(s.IP) ? "—" : s.IP)</td>
                        <td class="mono">@(string.IsNullOrWhiteSpace(s.TimeZone) ? "—" : s.TimeZone)</td>
                        <td>@s.StartedOnUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (s.Current)
                            {
                                <span class="module-chip info">@L["platform.profile.currentSession"]</span>
                            }
                            else
                            {
                                <span class="muted">@L["platform.profile.otherDevice"]</span>
                            }
                        </td>
                        <td>
                            <PermissionView Code="identity.user.revoke-session">
                                <button type="button" class="bb-link-btn danger" @onclick="() => RevokeAsync(s)"
                                        disabled="@(s.Current || _revoking.Contains(s.Id))">
                                    @(_revoking.Contains(s.Id) ? L["platform.profile.revoking"] : L["platform.profile.revoke"])
                                </button>
                            </PermissionView>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private string _displayName = string.Empty;
    private string _email = string.Empty;
    private string _oldPassword = string.Empty;
    private string _newPassword = string.Empty;
    private bool _savingProfile;
    private bool _savingPassword;
    private bool _uploadingAvatar;
    private string? _avatarUrl;
    private List<UserSessionDto> _sessions = [];
    private readonly HashSet<Guid> _revoking = [];
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await Account.EnsureLoadedAsync();
        if (Account.CurrentUser is { } user)
        {
            _displayName = user.DisplayName;
            _email = user.Email;
            await LoadAvatarAsync(user.Id);
        }
        else
        {
            _loadError = L["platform.profile.error.noUser"];
        }
        await LoadSessionsAsync();
    }

    private async Task LoadAvatarAsync(Guid userId)
    {
        try
        {
            var list = await Api.GetAttachmentsAsync(AttachmentKind.UserProfileImage, userId);
            var avatar = list.FirstOrDefault();
            _avatarUrl = avatar is null
                ? null
                : Api.GetAttachmentUrl(avatar.Id, avatar.Kind, cacheBust: avatar.CreatedAtUtc.ToUnixTimeMilliseconds().ToString());
        }
        catch
        {
            _avatarUrl = null;
        }
    }

    private async Task UploadAvatarAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        const long maxBytes = 11 * 1024 * 1024;
        if (file.Size > maxBytes)
        {
            Toast.Warning(L.GetString("platform.profile.toast.avatarTooLarge", 11));
            return;
        }

        _uploadingAvatar = true;
        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            var uploaded = await Api.UploadUserProfilePictureAsync(stream, file.Name, file.ContentType);
            _avatarUrl = Api.GetAttachmentUrl(uploaded.Id, uploaded.Kind, cacheBust: uploaded.CreatedAtUtc.ToUnixTimeMilliseconds().ToString());
            Toast.Success(L["platform.profile.toast.avatarUpdated"]);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.profile.toast.avatarUploadFailed", ex.Message));
        }
        finally
        {
            _uploadingAvatar = false;
        }
    }

    private async Task DeleteAvatarAsync()
    {
        _uploadingAvatar = true;
        try
        {
            await Api.DeleteUserProfilePictureAsync();
            _avatarUrl = null;
            Toast.Success(L["platform.profile.toast.avatarRemoved"]);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.profile.toast.avatarRemoveFailed", ex.Message));
        }
        finally
        {
            _uploadingAvatar = false;
        }
    }

    private async Task LoadSessionsAsync()
    {
        try
        {
            _sessions = (await Api.GetUserSessionsAsync()).ToList();
        }
        catch (Exception ex)
        {
            _loadError = L.GetString("platform.profile.toast.loadSessionsFailed", ex.Message);
            Toast.Error(_loadError);
        }
    }

    private async Task SaveProfileAsync()
    {
        if (string.IsNullOrWhiteSpace(_displayName) || string.IsNullOrWhiteSpace(_email))
        {
            Toast.Warning(L["platform.profile.toast.nameEmailRequired"]);
            return;
        }
        _savingProfile = true;
        try
        {
            var updated = await Api.UpdateProfileAsync(new EditUserRequestDto(_email.Trim(), _displayName.Trim()));
            _displayName = updated.DisplayName;
            _email = updated.Email;
            Toast.Success(L["platform.profile.toast.profileSaved"]);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.profile.toast.profileSaveFailed", ex.Message));
        }
        finally
        {
            _savingProfile = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_oldPassword) || string.IsNullOrWhiteSpace(_newPassword))
        {
            Toast.Warning(L["platform.profile.toast.passwordsRequired"]);
            return;
        }
        _savingPassword = true;
        try
        {
            await Api.ChangePasswordAsync(new ChangePasswordRequestDto(_oldPassword, _newPassword));
            _oldPassword = string.Empty;
            _newPassword = string.Empty;
            Toast.Success(L["platform.profile.toast.passwordChanged"]);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.profile.toast.passwordChangeFailed", ex.Message));
        }
        finally
        {
            _savingPassword = false;
        }
    }

    private async Task RevokeAsync(UserSessionDto session)
    {
        _revoking.Add(session.Id);
        try
        {
            await Api.RevokeSessionAsync(session.Id);
            _sessions.RemoveAll(s => s.Id == session.Id);
            Toast.Success(L["platform.profile.toast.sessionRevoked"]);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.profile.toast.sessionRevokeFailed", ex.Message));
        }
        finally
        {
            _revoking.Remove(session.Id);
        }
    }
}
