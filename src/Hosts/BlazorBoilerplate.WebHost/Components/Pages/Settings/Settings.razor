@page "/settings"
@page "/settings/{Section?}"
@rendermode RenderMode.InteractiveServer
@inject NavigationManager Navigation
@inject ILocalizationService L

<style>
    .settings-shell {
        width: 100%;
        max-width: 720px;
        margin: 0 auto;
        padding: 0.5rem 0 2rem;
    }

    .settings-shell .bit-stk,
    .settings-shell .bit-acl {
        width: 100%;
    }

    .settings-header {
        margin-bottom: 1.25rem;
    }

    .settings-form {
        width: 100%;
        max-width: 28rem;
    }

    .settings-form .bit-txt,
    .settings-form .bit-txt-wrapper {
        width: 100%;
    }

    .settings-avatar-wrap {
        position: relative;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
    }

    .settings-avatar-input {
        position: absolute;
        inset: 0;
        opacity: 0;
        cursor: pointer;
    }

    .settings-session-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        width: 100%;
    }

    .settings-session-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-shrink: 0;
    }
</style>

<div class="settings-shell">
    <div class="settings-header">
        <BitText Typography="BitTypography.H5">@L["platform.settings.title"]</BitText>
        <BitText Typography="BitTypography.Body2" Color="BitColor.SecondaryForeground">
            @L["platform.settings.subtitle"]
        </BitText>
    </div>

    <BitStack Gap="0.75rem">
        <BitAccordionList TItem="BitAccordionListOption"
                          HeadingLevel="2"
                          @bind-ExpandedKey="_expandedSection"
                          LazyContent
                          ScrollIntoViewOnExpand
                          Style="width: 100%;"
                          Background="BitColorKind.Secondary"
                          Border="BitColorKind.Transparent">

            <BitAccordionListOption Key="profile"
                                    Title="@L["platform.header.profile.title"]"
                                    Description="@L["platform.settings.profileDesc"]">
                <ProfileSection />
            </BitAccordionListOption>

            <BitAccordionListOption Key="account"
                                    Title="@L["platform.settings.accountTitle"]"
                                    Description="@L["platform.settings.accountDesc"]">
                <AccountSection />
            </BitAccordionListOption>

            <BitAccordionListOption Key="sessions"
                                    Title="@L["platform.settings.sessionsTitle"]"
                                    Description="@L["platform.settings.sessionsDesc"]">
                <SessionsSection />
            </BitAccordionListOption>

        </BitAccordionList>
    </BitStack>
</div>

@code {
    [Parameter] public string? Section { get; set; }

    private string? _expandedSection;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Section))
            _expandedSection = Section.Trim().ToLowerInvariant();
    }
}

