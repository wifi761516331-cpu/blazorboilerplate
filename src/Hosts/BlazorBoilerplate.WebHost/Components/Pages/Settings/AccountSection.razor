@inject BlazorBoilerplateApiClient Api
@inject AccountState Account
@inject SystemSettingsState SysState
@inject ToastService Toast
@inject ILocalizationService L

<section style="padding: 0.75rem 0 1.25rem;">
    <BitPivot Alignment="BitAlignment.Center"
              OverflowBehavior="BitPivotOverflowBehavior.Menu"
              DefaultSelectedKey="password">
        <BitPivotItem Key="email" HeaderText="@L["platform.profile.email"]">
            <div style="display:flex;justify-content:center;padding-top:1rem;width:100%;">
                <div class="settings-form">
                    <BitStack FillContent Gap="0.85rem">
                        <BitTextField Value="@_currentEmail"
                                      Label="@L["platform.settings.account.currentEmail"]"
                                      ReadOnly />

                        <BitTextField @bind-Value="_newEmail"
                                      Label="@L["platform.settings.account.newEmail"]"
                                      Type="BitInputType.Email"
                                      Placeholder="@L["platform.settings.account.newEmailPlaceholder"]" />

                        <PermissionView Code="identity.user.update">
                            <BitButton IsLoading="_savingEmail"
                                       Color="BitColor.Primary"
                                       OnClick="SaveEmailAsync">
                                @L["platform.settings.account.changeEmail"]
                            </BitButton>
                        </PermissionView>
                    </BitStack>
                </div>
            </div>
        </BitPivotItem>

        <BitPivotItem Key="password" HeaderText="@L["platform.settings.account.password"]">
            <div style="display:flex;justify-content:center;padding-top:1rem;width:100%;">
                <div class="settings-form">
                    <BitStack FillContent Gap="0.85rem">
                        <BitTextField @bind-Value="_oldPassword"
                                      Label="@L["platform.profile.oldPassword"]"
                                      Type="BitInputType.Password"
                                      CanRevealPassword
                                      Placeholder="@L["platform.settings.account.currentPasswordPlaceholder"]" />

                        <BitTextField @bind-Value="_newPassword"
                                      Label="@L["platform.profile.newPassword"]"
                                      Type="BitInputType.Password"
                                      CanRevealPassword
                                      Placeholder="@L.GetString("platform.settings.account.minCharsPlaceholder", _passwordMinLength)" />

                        <BitTextField @bind-Value="_confirmPassword"
                                      Label="@L["platform.settings.account.confirmPassword"]"
                                      Type="BitInputType.Password"
                                      CanRevealPassword
                                      Placeholder="@L["platform.settings.account.confirmPasswordPlaceholder"]" />

                        <PermissionView Code="identity.user.change-password">
                            <BitButton IsLoading="_savingPassword"
                                       Color="BitColor.Primary"
                                       OnClick="ChangePasswordAsync">
                                @L["platform.profile.changePassword"]
                            </BitButton>
                        </PermissionView>
                    </BitStack>
                </div>
            </div>
        </BitPivotItem>
    </BitPivot>
</section>

@code {
    private string _currentEmail = string.Empty;
    private string _displayName = string.Empty;
    private string _newEmail = string.Empty;
    private string _oldPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _savingEmail;
    private bool _savingPassword;
    private int _passwordMinLength = 6;

    protected override async Task OnInitializedAsync()
    {
        await Account.EnsureLoadedAsync();
        await SysState.EnsureLoadedAsync();
        if (SysState.Public.PasswordMinLength > 0)
            _passwordMinLength = SysState.Public.PasswordMinLength;
        if (Account.CurrentUser is { } user)
        {
            _currentEmail = user.Email;
            _displayName = user.DisplayName;
        }
    }

    private async Task SaveEmailAsync()
    {
        var email = _newEmail.Trim();
        if (string.IsNullOrWhiteSpace(email) || !email.Contains('@'))
        {
            Toast.Warning(L["platform.settings.account.toast.invalidEmail"]);
            return;
        }
        if (string.Equals(email, _currentEmail, StringComparison.OrdinalIgnoreCase))
        {
            Toast.Info(L["platform.settings.account.toast.sameEmail"]);
            return;
        }

        _savingEmail = true;
        try
        {
            var updated = await Api.UpdateProfileAsync(new EditUserRequestDto(email, _displayName));
            _currentEmail = updated.Email;
            _newEmail = string.Empty;
            Account.UpdateCurrentUser(updated);
            Toast.Success(L["platform.settings.account.toast.emailUpdated"]);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.settings.account.toast.emailUpdateFailed", ex.Message));
        }
        finally
        {
            _savingEmail = false;
        }
    }

    private async Task ChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_oldPassword) || string.IsNullOrWhiteSpace(_newPassword))
        {
            Toast.Warning(L["platform.profile.toast.passwordsRequired"]);
            return;
        }
        await SysState.RefreshAsync();
        if (SysState.Public.PasswordMinLength > 0)
            _passwordMinLength = SysState.Public.PasswordMinLength;
        if (_newPassword.Length < _passwordMinLength)
        {
            Toast.Warning(L.GetString("platform.settings.account.toast.passwordTooShort", _passwordMinLength));
            return;
        }
        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            Toast.Warning(L["platform.settings.account.toast.passwordMismatch"]);
            return;
        }

        _savingPassword = true;
        try
        {
            await Api.ChangePasswordAsync(new ChangePasswordRequestDto(_oldPassword, _newPassword));
            _oldPassword = string.Empty;
            _newPassword = string.Empty;
            _confirmPassword = string.Empty;
            Toast.Success(L["platform.profile.toast.passwordChanged"]);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.profile.toast.passwordChangeFailed", ex.Message));
        }
        finally
        {
            _savingPassword = false;
        }
    }
}

