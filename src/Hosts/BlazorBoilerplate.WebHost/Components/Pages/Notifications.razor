@page "/notifications"
@rendermode RenderMode.InteractiveServer
@inject BlazorBoilerplateApiClient Api
@inject ToastService Toast
@inject UserPreferences Preferences
@inject AccountState Account
@inject ILocalizationService L

<div class="page-callout">
    <h1 class="page-title">@L["platform.header.notifications.title"]</h1>
    <p class="muted">@L["platform.notifications.subtitle"]</p>
</div>

@if (_loadError is not null)
{
    <div class="page-callout error">@_loadError</div>
}

<div class="bb-toolbar">
    <span class="muted">@L.GetString("platform.notifications.summary", _notifications.Count, UnreadCount)</span>
    <div class="bb-spacer"></div>
    <button type="button" class="blazorboilerplate-btn ghost" @onclick="MarkAllReadAsync" disabled="@(UnreadCount == 0)">@L["platform.notifications.markAllRead"]</button>
    <PermissionView Code="notification.send-test">
        <button type="button" class="blazorboilerplate-btn primary" @onclick="OpenEmailModal" disabled="@_sendingEmail">
            @(_sendingEmail ? L["platform.notifications.sending"] : L["platform.notifications.sendTestEmail"])
        </button>
        @if (_notificationsEnabled)
        {
            <button type="button" class="blazorboilerplate-btn primary" @onclick="SendTestAsync" disabled="@_sending">
                @(_sending ? L["platform.notifications.sending"] : L["platform.notifications.sendTest"])
            </button>
        }
        else
        {
            <button type="button" class="blazorboilerplate-btn primary" disabled title="@L["platform.notifications.enableHint"]">@L["platform.notifications.sendTest"]</button>
        }
    </PermissionView>
    <button type="button" class="blazorboilerplate-btn ghost" @onclick="LoadAsync">@L["platform.common.refresh"]</button>
</div>

@if (!_notificationsEnabled)
{
    <div class="page-callout success">@L["platform.notifications.disabledBanner"]</div>
}

<div class="notif-list">
    @if (_notifications.Count == 0)
    {
        <div class="notif-empty">@L["platform.notifications.empty"]</div>
    }
    @foreach (var n in _notifications)
    {
        <article class="notif-item @(n.IsRead ? "" : "unread")">
            <span class="notif-dot"></span>
            <div class="notif-body">
                <div class="notif-head">
                    <strong class="notif-title">@n.Title</strong>
                    <time class="notif-time">@n.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</time>
                </div>
                <p class="notif-message">@n.Message</p>
                <div class="notif-foot">
                    @if (!string.IsNullOrWhiteSpace(n.PageUrl))
                    {
                        <a class="bit-link" href="@n.PageUrl">@L["platform.notifications.viewDetails"]</a>
                    }
                    @if (!n.IsRead)
                    {
                        <button type="button" class="bb-link-btn" @onclick="() => MarkReadAsync(n)"
                                disabled="@_marking.Contains(n.Id)">@L["platform.notifications.markRead"]</button>
                    }
                    else
                    {
                        <span class="muted">@L["platform.notifications.read"]</span>
                    }
                </div>
            </div>
        </article>
    }
</div>

<BlazorBoilerplateModal @bind-IsOpen="_emailModalOpen"
                        Title="@L["platform.notifications.emailModalTitle"]"
                        OkText="@L["platform.notifications.sendEmailOk"]"
                        OnOk="SendTestEmailAsync">
    <div class="id-form">
        <div class="auth-field">
            <label class="auth-label" for="email-to">@L["platform.notifications.emailTo"]</label>
            <input id="email-to" class="auth-input" type="email" @bind="_emailTo" placeholder="761516331@qq.com" />
        </div>
        <div class="auth-field">
            <label class="auth-label" for="email-subject">@L["platform.notifications.emailSubject"]</label>
            <input id="email-subject" class="auth-input" @bind="_emailSubject" placeholder="@L["platform.notifications.defaultEmailSubject"]" />
        </div>
        <div class="auth-field">
            <label class="auth-label" for="email-body">@L["platform.notifications.emailBody"]</label>
            <textarea id="email-body" class="auth-input" rows="4" @bind="_emailBody"
                      placeholder="@L["platform.notifications.emailBodyPlaceholder"]"></textarea>
        </div>
    </div>
</BlazorBoilerplateModal>

@code {
    private List<NotificationDto> _notifications = [];
    private bool _notificationsEnabled;
    private bool _sending;
    private bool _sendingEmail;
    private bool _emailModalOpen;
    private string _emailTo = string.Empty;
    private string _emailSubject = string.Empty;
    private string _emailBody = string.Empty;
    private string? _loadError;
    private readonly HashSet<Guid> _marking = [];

    private int UnreadCount => _notifications.Count(n => !n.IsRead);

    protected override async Task OnInitializedAsync()
    {
        _emailSubject = L["platform.notifications.defaultEmailSubject"];
        _emailBody = L["platform.notifications.defaultEmailBody"];
        await Account.EnsureLoadedAsync();
        _emailTo = Account.CurrentUser?.Email ?? string.Empty;
        var prefs = await Preferences.GetAsync();
        _notificationsEnabled = prefs.NotificationsEnabled;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            _notifications = (await Api.GetNotificationsAsync())
                .OrderByDescending(n => n.CreatedAtUtc).ToList();
        }
        catch (Exception ex)
        {
            _loadError = L.GetString("platform.notifications.toast.loadFailed", ex.Message);
            Toast.Error(_loadError);
        }
    }

    private async Task MarkReadAsync(NotificationDto item)
    {
        _marking.Add(item.Id);
        try
        {
            await Api.MarkNotificationReadAsync(item.Id);
            var read = item with { IsRead = true };
            _notifications = _notifications.Select(n => n.Id == read.Id ? read : n).ToList();
            Toast.Success(L["platform.notifications.toast.markedRead"]);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.notifications.toast.markReadFailed", ex.Message));
        }
        finally
        {
            _marking.Remove(item.Id);
        }
    }

    private async Task MarkAllReadAsync()
    {
        try
        {
            await Api.MarkAllNotificationsReadAsync();
            _notifications = _notifications.Select(n => n with { IsRead = true }).ToList();
            Toast.Success(L["platform.notifications.toast.markedAllRead"]);
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.notifications.toast.markAllReadFailed", ex.Message));
        }
    }

    private async Task SendTestAsync()
    {
        _sending = true;
        try
        {
            await Api.SendTestNotificationAsync();
            Toast.Success(L["platform.notifications.toast.testSent"]);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.notifications.toast.sendTestFailed", ex.Message));
        }
        finally
        {
            _sending = false;
        }
    }

    private void OpenEmailModal()
    {
        if (string.IsNullOrWhiteSpace(_emailTo))
            _emailTo = Account.CurrentUser?.Email ?? string.Empty;
        _emailModalOpen = true;
    }

    private async Task SendTestEmailAsync()
    {
        _emailModalOpen = false;
        _sendingEmail = true;
        try
        {
            var result = await Api.SendTestEmailAsync(new SendEmailNotificationRequestDto(
                _emailTo, _emailSubject, _emailBody));
            Toast.Success(L.GetString("platform.notifications.toast.testEmailSent", result.ToEmail));
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(L.GetString("platform.notifications.toast.sendTestEmailFailed", ex.Message));
        }
        finally
        {
            _sendingEmail = false;
        }
    }
}
