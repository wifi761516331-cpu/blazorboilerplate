@* 布局裁决（PickLayout）与注入在 Routes.razor.cs；渲染模式由 App.razor 按路由策略动态裁决。 *@

<Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="@ModuleCatalog.Assemblies">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@PickLayout()" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <BitCallout Class="page-callout">
                @L["platform.error.routeNotFound"]
            </BitCallout>
        </LayoutView>
    </NotFound>
</Router>

