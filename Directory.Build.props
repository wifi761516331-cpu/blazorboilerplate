<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 本机 VS 预览版的 workload 自动导入残留了指向不存在的 Microsoft.Maui.Sdk/11.0.0-rc.2 的引用，
         会在项目评估时抛 MSB4584。本仓库全部是纯 net10.0 项目，不需要任何 workload，直接关闭解析器。 -->
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <Product>BlazorBoilerplate Platform</Product>
    <Authors>BlazorBoilerplate</Authors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

</Project>
